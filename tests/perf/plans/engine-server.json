{
  "description": "Engine on the server (F4): native WPE WebKit with JIT on 1 and 2 server cores against browser-lite on the S, L and C profile (cold visits); CNN left out because cog crashes there",
  "groups": [
    {
      "name": "engine-server",
      "record": [
        "wiki",
        "weather",
        "youtube",
        "github"
      ],
      "sections": [
        {
          "id": "wpe-2c-1",
          "kind": "wpe",
          "profile": "0,1",
          "args": "--runs 4 --sites wiki,weather,youtube,github"
        },
        {
          "id": "wpe-1c-1",
          "kind": "wpe",
          "profile": "0",
          "args": "--runs 4 --sites wiki,weather,youtube,github"
        },
        {
          "id": "bl-S",
          "kind": "run",
          "profile": "S",
          "net": "lan",
          "args": "--visit cold --runs 4 --timeout 400 --sites wiki,weather,youtube,github"
        },
        {
          "id": "bl-L",
          "kind": "run",
          "profile": "L",
          "net": "lan",
          "args": "--visit cold --runs 4 --timeout 400 --sites wiki,weather,youtube,github"
        },
        {
          "id": "bl-C",
          "kind": "run",
          "profile": "C",
          "net": "lan",
          "args": "--visit cold --runs 4 --timeout 400 --sites wiki,weather,youtube,github"
        },
        {
          "id": "wpe-1c-2",
          "kind": "wpe",
          "profile": "0",
          "args": "--runs 4 --sites wiki,weather,youtube,github"
        },
        {
          "id": "wpe-2c-2",
          "kind": "wpe",
          "profile": "0,1",
          "args": "--runs 4 --sites wiki,weather,youtube,github"
        }
      ]
    }
  ]
}
