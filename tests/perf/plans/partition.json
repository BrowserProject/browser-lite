{
  "description": "U2 and the removed bytecode cache: engine before (site 0, f770fe5) against the engine with the HTTP cache partitioned by site and without bytecode cache (site 1), first and second visit, cheap (C) and fast (S) device, LAN",
  "configs": [
    {
      "name": "E1",
      "site": 0
    },
    {
      "name": "E2",
      "site": 1
    }
  ],
  "compare": [
    {
      "base": "E1",
      "arms": [
        "E2"
      ],
      "rule": "correction",
      "where": {
        "visit": "warm"
      },
      "metrics": [
        "cpu",
        "firstLayout",
        "rx"
      ],
      "secondary": [
        "loaded"
      ]
    },
