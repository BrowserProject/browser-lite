{
  "description": "Engine on the server (F4): native WPE WebKit with and without JIT on 2 server cores against browser-lite on a fast (S) and a cheap (C) device, same replayed sites",
  "groups": [
    {
      "name": "wpe",
      "record": ["wiki", "cnn", "weather", "youtube", "github"],
      "sections": [
        { "id": "wpe-jit-1", "kind": "wpe", "profile": "0,1", "args": "--runs 3 --sites wiki,cnn,weather,youtube,github" },
        { "id": "wpe-nojit-1", "kind": "wpe", "profile": "0,1", "args": "--runs 3 --sites wiki,cnn,weather,youtube,github --nojit" },
        { "id": "wpe-nojit-2", "kind": "wpe", "profile": "0,1", "args": "--runs 3 --sites wiki,cnn,weather,youtube,github --nojit" },
        { "id": "wpe-jit-2", "kind": "wpe", "profile": "0,1", "args": "--runs 3 --sites wiki,cnn,weather,youtube,github" },
        { "id": "bl-S", "kind": "run", "profile": "S", "net": "lan", "args": "--visit cold --runs 3 --timeout 300 --sites wiki,cnn,weather,youtube,github" },
        { "id": "bl-C", "kind": "run", "profile": "C", "net": "lan", "args": "--visit cold --runs 3 --timeout 400 --sites wiki,cnn,weather,youtube,github" }
      ]
    }
  ]
}
