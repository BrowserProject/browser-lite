{
  "description": "Probe of the measurement: the same engine as site 0 and site 1 (engine_runs empty or the same run twice), G must hold 1.00 inside the interval for run.mjs and start.mjs",
  "configs": [
    { "name": "A", "site": 0 },
    { "name": "B", "site": 1 }
  ],
  "compare": [{ "base": "A", "arms": ["B"], "rule": "probe" }],
  "groups": [
    {
      "name": "probe-C",
      "record": ["example", "cnn", "wiki"],
      "sections": [
        {
          "id": "probe-C-run",
          "kind": "run",
          "profile": "C",
          "net": "lan",
          "args": "--visit warm --runs 5 --timeout 400 --sites cnn,wiki"
        },
        { "id": "probe-C-start", "kind": "start", "profile": "C", "net": "lan", "args": "--runs 5" }
      ]
    },
    {
      "name": "probe-S",
      "record": ["example", "cnn", "wiki"],
      "sections": [
        {
          "id": "probe-S-run",
          "kind": "run",
          "profile": "S",
          "net": "lan",
          "args": "--visit warm --runs 5 --timeout 400 --sites cnn,wiki"
        },
        { "id": "probe-S-start", "kind": "start", "profile": "S", "net": "lan", "args": "--runs 5" }
      ]
    }
  ]
}
