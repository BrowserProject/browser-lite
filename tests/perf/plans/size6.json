{
  "description": "U6 module size: CPU and memory of the smaller engines while pages load (V8 compiles giant engine functions with TurboFan on a background thread). Sites as in start6.json (engine_runs: its first five, site 0 is packaged but not measured): 1 main with U6, 2 link with -Oz, 3 the giant functions with less inlining, 4 WebCore with -Os. First and second visit, cheap (C) and fast (S) device, LAN, rule lever against U6. 20 runs: about 128 s per arm and run on C-cnn (GH 39436335414), 4 arms, so about 3.3 h with the setup; the other groups are faster",
  "configs": [
    {
      "name": "U6",
      "site": 1
    },
    {
      "name": "Oz",
      "site": 2
    },
    {
      "name": "OsGiant",
      "site": 3
    },
    {
      "name": "OsWebCore",
      "site": 4
    }
  ],
  "compare": [
    {
      "base": "U6",
      "arms": [
        "Oz",
        "OsGiant",
        "OsWebCore"
      ],
      "rule": "lever",
      "where": {
        "visit": "cold"
      },
      "metrics": [
        "cpu",
        "firstLayout"
      ],
      "secondary": [
        "loaded"
      ]
    },
    {
