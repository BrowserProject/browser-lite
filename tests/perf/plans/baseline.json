{
  "description": "Baseline of the current state: load times on the fast (S), older laptop (L) and cheap Chromebook (C) profile, LAN and mobile, first and second visit",
  "groups": [
    {
      "name": "base-S",
      "record": [
        "wiki",
        "cnn",
        "weather",
        "youtube",
        "github"
      ],
      "sections": [
        {
          "id": "base-S-lan",
          "kind": "run",
          "profile": "S",
          "net": "lan",
          "args": "--visit warm --runs 5 --timeout 400 --sites wiki,cnn,weather,youtube,github"
        },
        {
          "id": "base-S-mobile",
          "kind": "run",
          "profile": "S",
          "net": "mobile",
          "args": "--visit warm --runs 5 --timeout 400 --sites wiki,cnn,weather,youtube,github"
        }
      ]
    },
