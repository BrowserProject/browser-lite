+/* browser-lite */
+bool Curl_conn_limit_pending(struct Curl_easy *data,
+                             struct connectdata *conn,
+                             int8_t sockindex)
+{
+  struct Curl_cfilter *cf;
+  int pending = FALSE;
+
+  if(!CONN_SOCK_IDX_VALID(sockindex))
+    return FALSE;
+  cf = conn->cfilter[sockindex];
+  if(!cf || cf->cft->query(cf, data, CF_QUERY_LIMIT_PENDING, &pending, NULL))
+    return FALSE;
+  return (bool)pending;
+}
+
 int Curl_conn_get_stream_error(struct Curl_easy *data,
                                struct connectdata *conn,
                                int8_t sockindex)
