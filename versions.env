# Zentrale Versions-Pins. Alle Skripte und CI lesen diese Datei.
# Format: KEY=VALUE (shell- und GitHub-Actions-kompatibel, keine Leerzeichen).

# WebKit: WPE-Release-Tag und der exakte Commit dazu (Tag kann sich theoretisch bewegen, Commit nicht).
WEBKIT_REPO=https://github.com/WebKit/WebKit.git
WEBKIT_TAG=wpewebkit-2.54.1
WEBKIT_COMMIT=537776966344c4982751692dd475c94124504271

# Emscripten SDK
EMSDK_VERSION=6.0.10

# Docker-Image mit der Toolchain (gebaut vom Job toolchain in .github/workflows/ci.yml)
TOOLCHAIN_IMAGE=ghcr.io/browserproject/browser-lite-toolchain

# Image mit Relay + Seite (Dockerfile, gebaut vom Deploy-Workflow)
SITE_IMAGE=ghcr.io/browserproject/browser-lite

# Node fuer CI und Tests, und das Basis-Image dazu (gleiche Version) fuer das Dockerfile
NODE_VERSION=22.23.3
NODE_IMAGE=node:22.23.3-alpine3.24

# GitHub-Runner auf dem Server (deploy/setup-proxmox.sh), SHA256 von der Release-Seite
RUNNER_VERSION=2.338.0
RUNNER_SHA256=af4b794c1bc41d73d40535e3fe092a39f9679cd8d965954c2aca25a05ca41d32
