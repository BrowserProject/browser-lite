# Central version pins. All scripts and the CI read this file.
# Format: KEY=VALUE (shell and GitHub Actions compatible, no spaces).

# WebKit: WPE release tag and its exact commit (a tag could move in theory, the commit cannot).
WEBKIT_REPO=https://github.com/WebKit/WebKit.git
WEBKIT_TAG=wpewebkit-2.54.1
WEBKIT_COMMIT=537776966344c4982751692dd475c94124504271

# Emscripten SDK and the commit of its tag (checked when the toolchain is built)
EMSDK_VERSION=6.0.10
EMSDK_COMMIT=a2b92777574c2feda07994cd4f1079a3dfc151f8

# Base of the toolchain (digest) and Meson from pip (Ubuntu has only 1.3), SHA256 of the PyPI wheel
TOOLCHAIN_BASE_IMAGE=ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
MESON_VERSION=1.12.0
MESON_SHA256=71f133147fa0fcfe8f4df49fa1045771064947834538409e5d97b3613aac8b4e

# Docker image with the toolchain (built by the job toolchain in .github/workflows/ci.yml)
TOOLCHAIN_IMAGE=ghcr.io/browserproject/browser-lite-toolchain

# Images of the Dockerfile (tools/build-images.sh): server with the demo (deploy workflow, tags
# <commit> and main) and the server alone (release workflow, tag <version>)
DEMO_IMAGE=ghcr.io/browserproject/browser-lite
SERVER_IMAGE=ghcr.io/browserproject/browser-lite-server

# Node for CI and tests, and its base image (same version, digest) for the Dockerfile
NODE_VERSION=22.23.3
NODE_IMAGE=node:22.23.3-alpine3.24@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402

# GitHub runner on the server (apps/demo/deploy/setup-proxmox.sh, without self update), SHA256 from the release page
RUNNER_VERSION=2.338.0
RUNNER_SHA256=af4b794c1bc41d73d40535e3fe092a39f9679cd8d965954c2aca25a05ca41d32

# Performance measurements of tests/perf (only while that work runs): Chromium of Playwright as
# the device, Go to build Web Page Replay at a fixed commit, Debian sid at a fixed snapshot for
# native WPE WebKit (same release as WEBKIT_TAG) as the comparison for an engine on the server
PERF_PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.56.1-noble@sha256:f1e7e01021efd65dd1a2c56064be399f3e4de00fd021ac561325f2bfbb2b837a
PERF_GO_IMAGE=golang:1.27-alpine@sha256:738d1cf061836894ff6bb8c33881080ac66de8cf0586615012a0c8f592649cfa
PERF_WPR_REPO=https://chromium.googlesource.com/webpagereplay
PERF_WPR_COMMIT=7ed888744ce019687980074a909b6588db7da971
PERF_DEBIAN_IMAGE=debian:sid@sha256:c53e050391cca6c8517c4a075230b798a0f980faa5d3ed0a912249ea882e40b5
PERF_DEBIAN_SNAPSHOT=20261018T000000Z
PERF_VIDEO_URL=https://test-videos.co.uk/vids/bigbuckbunny/webm/vp9/720/Big_Buck_Bunny_720_10s_1MB.webm
PERF_VIDEO_SHA256=970f0daf21d82382940085e745825cf6ee34d89415492415fc1504fef78685e5
