# browser-lite: statische Seite + Relay auf einer Domain.
# DOMAIN kommt aus der Umgebung (docker-compose / .env)
{$DOMAIN} {
	encode zstd gzip

	# Noetig fuer SharedArrayBuffer (Threads in der Engine)
	header {
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		Cross-Origin-Resource-Policy same-origin
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	# Wisp-Relay (WebSocket)
	handle /wisp/* {
		reverse_proxy relay:5001
	}

	# Engine-Dateien liegen in engine/<version>/ und aendern sich nie mehr
	@engine path /engine/*
	header @engine Cache-Control "public, max-age=31536000, immutable"
	@page path / /index.html /app.js /transport.js /style.css
	header @page Cache-Control "no-cache"

	handle {
		root * /srv/www
		# .br/.gz von tools/optimize-site.mjs direkt ausliefern
		file_server {
			precompressed br gzip
		}
	}
}
