 #include <JavaScriptCore/JSObjectInlines.h>
 #include <JavaScriptCore/JSString.h>
 #include <JavaScriptCore/ObjectConstructor.h>
+#include <wtf/NeverDestroyed.h>
 #include <wtf/text/WTFString.h>
 
 namespace WebCore {
 using namespace JSC;
 
+#if OS(EMSCRIPTEN)
+// WebAssembly: ein neuer Thread wird ueber den Haupt-Thread der Seite gestartet
+// und blockiert so lange. Pro Fenster (jedes iframe fragt window.crypto) kostete
+// das beim Seitenladen bis zu 1 s. Alle SubtleCrypto teilen sich eine Queue.
+static Ref<WorkQueue> sharedCryptoWorkQueue()
+{
+    static NeverDestroyed<Ref<WorkQueue>> queue = WorkQueue::create("com.apple.WebKit.CryptoQueue"_s);
+    return queue.get();
+}
+#endif
+
 SubtleCrypto::SubtleCrypto(ScriptExecutionContext* context)
     : ContextDestructionObserver(context)
+#if OS(EMSCRIPTEN)
+    , m_workQueue(sharedCryptoWorkQueue())
+#else
     , m_workQueue(WorkQueue::create("com.apple.WebKit.CryptoQueue"_s))
+#endif
 {
 }
 
