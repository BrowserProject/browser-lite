+bool SWServer::isSoftUpdateJob(const ServiceWorkerJobData& jobData) const
+{
+    if (jobData.connectionIdentifier() != Process::identifier())
+        return false;
+#if PLATFORM(WASM)
+    return m_softUpdateJobs.contains(jobData.identifier().jobIdentifier);
+#else
+    return true;
+#endif
+}
+
+RefPtr<SWServer::Connection> SWServer::connectionForJob(const ServiceWorkerJobData& jobData) const
+{
+#if PLATFORM(WASM)
+    if (isSoftUpdateJob(jobData))
+        return nullptr;
+#endif
+    return m_connections.get(jobData.connectionIdentifier());
+}
+
+void SWServer::didFinishJob(const ServiceWorkerJobData& jobData)
+{
+#if PLATFORM(WASM)
+    m_softUpdateJobs.remove(jobData.identifier().jobIdentifier);
+#else
+    UNUSED_PARAM(jobData);
+#endif
+}
