@@ -393,8 +393,25 @@ void PlatformDisplay::setSkiaGLContextForCurrentThread(std::unique_ptr<GLContext
     m_skiaGLContexts.add(*s_skiaGLContext);
 }
 
+#if PLATFORM(WASM)
+// browser-lite: Die Engine legt den GPU-Kontext selber an (WebGL 2 im Engine-Worker,
+// engine/src/GpuRaster.cpp) und gibt ihn hier fuer den Skia-Compositor weiter. Einen
+// EGL-Kontext (skiaGLContext) gibt es nicht, Kacheln malt Skia darum auf der CPU.
+static GrDirectContext* s_wasmGrContext;
+
+WEBCORE_EXPORT void setSkiaGrContextForWasm(GrDirectContext*);
+void setSkiaGrContextForWasm(GrDirectContext* context)
+{
+    s_wasmGrContext = context;
+}
+#endif
+
 GrDirectContext* PlatformDisplay::skiaGrContext() const
 {
+#if PLATFORM(WASM)
+    if (!s_skiaGLContext)
+        return s_wasmGrContext;
+#endif
     RELEASE_ASSERT(s_skiaGLContext);
     return s_skiaGLContext->skiaGrContext();
 }
