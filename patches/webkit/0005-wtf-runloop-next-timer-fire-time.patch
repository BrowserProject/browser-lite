@@ -144,6 +144,11 @@ public:
 
 #if USE(GENERIC_EVENT_LOOP) || USE(WINDOWS_EVENT_LOOP)
     WTF_EXPORT_PRIVATE static void setWakeUpCallback(WTF::Function<void()>&&);
+#if OS(EMSCRIPTEN)
+    // browser-lite: Der Embedder treibt den Loop selber an (RunLoop::cycle()) und
