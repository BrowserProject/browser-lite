diff --git a/Source/WTF/wtf/generic/RunLoopGeneric.cpp b/Source/WTF/wtf/generic/RunLoopGeneric.cpp
index 7ac74579c7..7f441950b2 100644
--- a/Source/WTF/wtf/generic/RunLoopGeneric.cpp
+++ b/Source/WTF/wtf/generic/RunLoopGeneric.cpp
@@ -242,6 +242,17 @@ void RunLoop::setWakeUpCallback(WTF::Function<void()>&& function)
     RunLoop::currentSingleton().m_wakeUpCallback = WTF::move(function);
 }
 
+#if OS(EMSCRIPTEN)
+std::optional<MonotonicTime> RunLoop::nextTimerFireTime()
+{
+    auto& runLoop = RunLoop::currentSingleton();
+    Locker locker { runLoop.m_loopLock };
+    if (runLoop.m_schedules.isEmpty())
+        return std::nullopt;
+    return runLoop.m_schedules.first()->scheduledTimePoint();
+}
+#endif
+
 // RunLoop operations are thread-safe. These operations can be called from outside of the RunLoop's thread.
 // For example, WorkQueue::{dispatch, dispatchAfter} call the operations of the WorkQueue thread's RunLoop
 // from the caller's thread.
