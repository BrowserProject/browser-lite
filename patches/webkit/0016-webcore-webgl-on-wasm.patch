+#if ENABLE(WEBGL)
+
+#include "GraphicsContextGLANGLE.h"
+
+namespace WebCore {
+
+class GraphicsLayerContentsDisplayDelegateCoordinated;
+class PixelBuffer;
+
+// WebGL fuer PORT=Wasm: die GL-Aufrufe gehen ueber den ANGLE-Ersatz
+// (platform/wasm/angle) an einen WebGL-Kontext des Host-Browsers. Ohne
+// Compositing: das Bild wird mit readPixels gelesen und in die Seite gemalt.
+class GraphicsContextGLWasm final : public GraphicsContextGLANGLE {
+    WTF_MAKE_TZONE_ALLOCATED(GraphicsContextGLWasm);
+public:
+    static RefPtr<GraphicsContextGLWasm> create(GraphicsContextGLAttributes&&);
+    ~GraphicsContextGLWasm();
+
+    int handle() const { return m_handle; }
+
+private:
+    explicit GraphicsContextGLWasm(GraphicsContextGLAttributes&&);
+
+    bool platformInitializeContext() final;
+    bool reshapeDrawingBuffer() final;
+    void prepareForDisplay() final;
+    RefPtr<PixelBuffer> readCompositedResults() final;
+    // Mit Compositing (Coordinated Graphics) wird das Bild Inhalt einer Ebene
+    RefPtr<GraphicsLayerContentsDisplayDelegate> layerContentsDisplayDelegate() final;
+#if ENABLE(VIDEO)
+    bool copyTextureFromVideoFrame(VideoFrame&, PlatformGLObject, GCGLenum, GCGLint, GCGLenum, GCGLenum, GCGLenum, bool, bool) final { return false; }
+#endif
+#if ENABLE(MEDIA_STREAM) || ENABLE(WEB_CODECS)
+    RefPtr<VideoFrame> surfaceBufferToVideoFrame(SurfaceBuffer) final { return nullptr; }
+#endif
+
+    int m_handle { 0 };
+    RefPtr<PixelBuffer> m_displayBuffer;
+#if USE(COORDINATED_GRAPHICS)
+    RefPtr<GraphicsLayerContentsDisplayDelegateCoordinated> m_layerContentsDisplayDelegate;
+#endif
+};
+
+} // namespace WebCore
+
+#endif // ENABLE(WEBGL)
