+int angleShimCreateContext(bool webgl2)
+{
+    auto* host = ensureHost(webgl2);
+    if (!host || !makeHostCurrent(*host))
+        return 0;
+    // Der aktuelle Kontext ist jetzt evtl. nicht mehr der im Host
+    current = nullptr;
+
+    ShimContext context;
+    context.id = nextId++;
+    context.webgl2 = webgl2;
+    // Eigene Objekte statt der geteilten Standard-Objekte des Host-Kontexts
+    glGenVertexArrays(1, &context.defaultVertexArray);
+    if (webgl2)
+        glGenTransformFeedbacks(1, &context.defaultTransformFeedback);
+    if (!context.defaultVertexArray)
+        return 0;
+    context.boundVertexArray = context.defaultVertexArray;
+    context.boundTransformFeedback = context.defaultTransformFeedback;
+
+    char* supported = reinterpret_cast<char*>(EM_ASM_PTR({
+        var list = GLctx.getSupportedExtensions() || [];
+        return stringToNewUTF8(' ' + list.join(' ') + ' ');
+    }));
+    std::string supportedList = supported ? supported : "";
+    free(supported);
+    int version = webgl2 ? 2 : 1;
+    for (auto& mapping : mappings()) {
+        if (!(mapping.versions & version))
+            continue;
+        if (supportedList.find(std::string(" ") + mapping.webgl + " ") == std::string::npos)
+            continue;
+        for (auto* name : mapping.gles)
+            context.requestable.insert(name);
+    }
+    // In WebGL 2 eingebaut, WebKit fragt trotzdem danach
+    if (webgl2) {
+        for (auto* name : { "GL_EXT_occlusion_query_boolean", "GL_ANGLE_framebuffer_multisample", "GL_ANGLE_framebuffer_blit",
+            "GL_OES_packed_depth_stencil", "GL_OES_depth24", "GL_OES_rgb8_rgba8", "GL_EXT_blend_minmax", "GL_OES_texture_half_float" })
+            context.requestable.insert(name);
+    } else {
+        // WebGL 1 hat DEPTH_STENCIL-Renderbuffer (GL_RenderbufferStorage passt das Format an)
+        context.requestable.insert("GL_OES_packed_depth_stencil");
+    }
+    context.requestable.insert("GL_ANGLE_translated_shader_source");
+    updateStrings(context);
+    int id = context.id;
+    contexts()[id] = std::move(context);
+    return id;
+}
+
+bool angleShimMakeCurrent(int id)
+{
+    if (!id) {
+        current = nullptr;
+        return true;
+    }
+    // Der GPU-Rasterer der Engine (engine/src/GpuRaster.cpp) wechselt auch den
+    // GL-Kontext von Emscripten. Darum auch hier pruefen, ob der Host-Kontext
+    // noch aktuell ist (kostet nur einen Vergleich in JS).
+    if (current && current->id == id)
+        return makeHostCurrent(hostFor(*current));
+    auto it = contexts().find(id);
+    if (it == contexts().end())
+        return false;
+    auto& context = it->second;
+    auto& host = hostFor(context);
+    if (!host.handle || !makeHostCurrent(host))
+        return false;
+    if (host.stateOwner != id) {
+        auto owner = contexts().find(host.stateOwner);
+        if (owner != contexts().end()) {
+            drainErrors(&owner->second.pendingErrors);
+            blSaveState(owner->first, owner->second.webgl2, owner->second.maxTextureUnit);
+        } else
+            drainErrors(nullptr);
+        blRestoreState(id, defaultStateKey(context.webgl2), context.defaultVertexArray, context.defaultTransformFeedback, context.webgl2, host.maxTextureUnit);
+        // Fehler hier kaemen vom Wiederherstellen, nicht von der Seite
+        drainErrors(nullptr);
+        host.stateOwner = id;
+    }
+    current = &context;
+    return true;
+}
+
+void angleShimDestroyContext(int id)
+{
+    auto it = contexts().find(id);
+    if (it == contexts().end())
+        return;
+    auto& context = it->second;
+    auto& host = hostFor(context);
+    if (host.handle && makeHostCurrent(host)) {
+        glDeleteVertexArrays(1, &context.defaultVertexArray);
+        if (context.defaultTransformFeedback)
+            glDeleteTransformFeedbacks(1, &context.defaultTransformFeedback);
+    }
+    if (host.stateOwner == id)
+        host.stateOwner = 0;
+    blForgetState(id);
+    current = nullptr;
+    contexts().erase(it);
+}
