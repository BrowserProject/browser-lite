+// WebKit liest Puffer (getBufferSubData) ueber MapBufferRange. Emscriptens
+// Version kann nicht lesen, darum hier ueber getBufferSubData des Browsers.
+struct MappedBuffer {
+    GLintptr offset { 0 };
+    GLsizeiptr length { 0 };
+    GLbitfield access { 0 };
+    void* data { nullptr };
+};
+
+static thread_local std::unordered_map<GLenum, MappedBuffer>* mappedBuffers;
+
+void* GL_APIENTRY GL_MapBufferRange(GLenum target, GLintptr offset, GLsizeiptr length, GLbitfield access)
+{
+    if (!current || !current->webgl2 || length < 0)
+        return nullptr;
+    if (!mappedBuffers)
+        mappedBuffers = new std::unordered_map<GLenum, MappedBuffer>;
+    if (mappedBuffers->contains(target))
+        return nullptr;
+    void* data = calloc(length ? length : 1, 1);
+    if (!data)
+        return nullptr;
+    if (access & GL_MAP_READ_BIT)
+        EM_ASM({ GLctx.getBufferSubData($0, $1, HEAPU8, $2, $3); }, target, offset, data, length);
+    (*mappedBuffers)[target] = MappedBuffer { offset, length, access, data };
+    return data;
+}
+
+GLboolean GL_APIENTRY GL_UnmapBuffer(GLenum target)
+{
+    if (!mappedBuffers)
+        return GL_FALSE;
+    auto it = mappedBuffers->find(target);
+    if (it == mappedBuffers->end())
+        return GL_FALSE;
+    auto mapped = it->second;
+    mappedBuffers->erase(it);
+    if ((mapped.access & GL_MAP_WRITE_BIT) && !(mapped.access & GL_MAP_FLUSH_EXPLICIT_BIT))
+        glBufferSubData(target, mapped.offset, mapped.length, mapped.data);
+    free(mapped.data);
+    return GL_TRUE;
+}
