+// Diese GraphicsContextGLANGLE-Methoden definiert jede Plattform selber
+
+GraphicsContextGLANGLE::~GraphicsContextGLANGLE()
+{
+    if (!makeContextCurrent())
+        return;
+    if (m_texture)
+        GL_DeleteTextures(1, &m_texture);
+    auto attributes = contextAttributes();
+    if (attributes.antialias) {
+        GL_DeleteRenderbuffers(1, &m_multisampleColorBuffer);
+        if (attributes.stencil || attributes.depth)
+            GL_DeleteRenderbuffers(1, &m_multisampleDepthStencilBuffer);
+        GL_DeleteFramebuffers(1, &m_multisampleFBO);
+    } else {
+        if ((attributes.stencil || attributes.depth) && m_depthStencilBuffer)
+            GL_DeleteRenderbuffers(1, &m_depthStencilBuffer);
+        if (m_preserveDrawingBufferTexture)
+            GL_DeleteTextures(1, &m_preserveDrawingBufferTexture);
+        if (m_preserveDrawingBufferFBO)
+            GL_DeleteFramebuffers(1, &m_preserveDrawingBufferFBO);
+    }
+    GL_DeleteFramebuffers(1, &m_fbo);
+    if (m_contextObj)
+        angleShimDestroyContext(static_cast<int>(reinterpret_cast<intptr_t>(m_contextObj)));
+}
+
+bool GraphicsContextGLANGLE::makeContextCurrent()
+{
+    return m_contextObj && angleShimMakeCurrent(static_cast<int>(reinterpret_cast<intptr_t>(m_contextObj)));
+}
+
+void GraphicsContextGLANGLE::checkGPUStatus()
+{
+}
+
+void GraphicsContextGLANGLE::platformReleaseThreadResources()
+{
+}
+
+RefPtr<GraphicsContextGL> createWebProcessGraphicsContextGL(const GraphicsContextGLAttributes& attributes)
+{
+    return GraphicsContextGLWasm::create(GraphicsContextGLAttributes { attributes });
+}
+
+WTF_MAKE_TZONE_ALLOCATED_IMPL(GraphicsContextGLWasm);
+
+RefPtr<GraphicsContextGLWasm> GraphicsContextGLWasm::create(GraphicsContextGLAttributes&& attributes)
+{
+    auto context = adoptRef(*new GraphicsContextGLWasm(WTF::move(attributes)));
+    if (!context->initialize())
+        return nullptr;
+    return context;
+}
+
+GraphicsContextGLWasm::GraphicsContextGLWasm(GraphicsContextGLAttributes&& attributes)
+    : GraphicsContextGLANGLE(WTF::move(attributes))
+{
+}
+
+GraphicsContextGLWasm::~GraphicsContextGLWasm() = default;
+
+bool GraphicsContextGLWasm::platformInitializeContext()
+{
+    m_isForWebGL2 = contextAttributes().isWebGL2;
+    // WebGL 1 hat keine Multisample-Renderbuffer, darum dort ohne Antialiasing
+    if (!m_isForWebGL2 && contextAttributes().antialias) {
+        auto attributes = contextAttributes();
+        attributes.antialias = false;
+        setContextAttributes(attributes);
+    }
+    m_handle = angleShimCreateContext(m_isForWebGL2);
+    if (!m_handle)
+        return false;
+    m_displayObj = reinterpret_cast<GCGLDisplay>(1);
+    m_configObj = reinterpret_cast<GCGLConfig>(1);
+    m_contextObj = reinterpret_cast<GCGLContext>(static_cast<intptr_t>(m_handle));
+    return makeContextCurrent();
+}
+
+bool GraphicsContextGLWasm::reshapeDrawingBuffer()
+{
+    auto attributes = contextAttributes();
+    auto size = getInternalFramebufferSize();
+    GLenum colorFormat = attributes.alpha ? GL_RGBA : GL_RGB;
+    ScopedRestoreTextureBinding restoreBinding(TEXTURE_BINDING_2D, TEXTURE_2D);
+    GL_BindTexture(GL_TEXTURE_2D, m_texture);
+    GL_TexImage2D(GL_TEXTURE_2D, 0, colorFormat, size.width(), size.height(), 0, colorFormat, GL_UNSIGNED_BYTE, nullptr);
+    m_displayBuffer = nullptr;
+    return true;
+}
+
+// Fertiges Bild: jetzt lesen, bevor WebGL den Zeichenpuffer wieder loescht
+void GraphicsContextGLWasm::prepareForDisplay()
+{
+    if (!makeContextCurrent())
+        return;
+    m_displayBuffer = readRenderingResultsForPainting();
+#if USE(COORDINATED_GRAPHICS)
+    if (m_layerContentsDisplayDelegate && m_displayBuffer) {
+        // Das GL-Bild steht auf dem Kopf (unten links beginnt es), die Ebene will es aufrecht
+        auto image = createNativeImageFromPixelBuffer(contextAttributes(), Ref { *m_displayBuffer });
+        if (!image)
+            return;
+        auto& source = image->platformImage();
+        auto info = SkImageInfo::Make(source->width(), source->height(), kRGBA_8888_SkColorType, contextAttributes().alpha ? kPremul_SkAlphaType : kOpaque_SkAlphaType);
+        auto surface = SkSurfaces::Raster(info);
+        if (!surface)
+            return;
+        auto* canvas = surface->getCanvas();
+        canvas->translate(0, source->height());
+        canvas->scale(1, -1);
+        SkPaint paint;
+        paint.setBlendMode(SkBlendMode::kSrc);
+        canvas->drawImage(source, 0, 0, SkSamplingOptions { }, &paint);
+        auto upright = NativeImage::create(surface->makeImageSnapshot());
+        if (!upright)
+            return;
+        static_cast<GraphicsLayerContentsDisplayDelegate&>(*m_layerContentsDisplayDelegate).setDisplayBuffer(CoordinatedPlatformLayerBufferNativeImage::create(upright.releaseNonNull(), nullptr));
+    }
+#endif
+}
+
+RefPtr<GraphicsLayerContentsDisplayDelegate> GraphicsContextGLWasm::layerContentsDisplayDelegate()
+{
+#if USE(COORDINATED_GRAPHICS)
+    if (!m_layerContentsDisplayDelegate)
+        m_layerContentsDisplayDelegate = GraphicsLayerContentsDisplayDelegateCoordinated::create();
+    return m_layerContentsDisplayDelegate;
+#else
+    return nullptr;
+#endif
+}
+
+RefPtr<PixelBuffer> GraphicsContextGLWasm::readCompositedResults()
+{
+    return m_displayBuffer;
+}
+
+} // namespace WebCore
+
+#endif // ENABLE(WEBGL)
