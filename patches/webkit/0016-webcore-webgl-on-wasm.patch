+// Schluessel fuer den Grundzustand eines Host-Kontexts (Kontext-IDs sind positiv)
+int defaultStateKey(bool webgl2)
+{
+    return webgl2 ? -2 : -1;
+}
+
+bool makeHostCurrent(HostContext& host)
+{
+    return EM_ASM_INT({
+        if (GL.currentContext === GL.contexts[$0])
+            return 1;
+        return GL.makeContextCurrent($0) ? 1 : 0;
+    }, host.handle);
+}
+
+// Host-Kontext fuer die Version, beim ersten Mal (oder nach Verlust) neu
+HostContext* ensureHost(bool webgl2)
+{
+    auto& host = hosts[webgl2 ? 1 : 0];
+    if (host.handle && blIsContextLost(host.handle)) {
+        // Verloren: alle Kontexte darauf sind sowieso kaputt
+        EM_ASM({ GL.deleteContext($0); }, host.handle);
+        host = { };
+    }
+    if (!host.handle) {
+        host.handle = blCreateGLContext(webgl2);
+        if (!host.handle)
+            return nullptr;
+        if (!makeHostCurrent(host))
+            return nullptr;
+        blSaveState(defaultStateKey(webgl2), webgl2, 0);
+    }
+    return &host;
+}
+
+void drainErrors(std::vector<GLenum>* into)
+{
+    // Nicht endlos, falls der Kontext verloren ist
+    for (int i = 0; i < 16; i++) {
+        GLenum error = glGetError();
+        if (error == GL_NO_ERROR)
+            break;
+        if (into && std::find(into->begin(), into->end(), error) == into->end())
+            into->push_back(error);
+    }
+}
