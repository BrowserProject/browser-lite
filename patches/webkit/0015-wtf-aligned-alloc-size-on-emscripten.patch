 namespace WTF {
 
+#if OS(EMSCRIPTEN)
+// Emscriptens aligned_alloc gibt nullptr zurueck, wenn die Groesse kein
+// Vielfaches der Ausrichtung ist (C11-Regel). WebKit verlangt das nicht.
+static inline size_t alignedAllocationSize(size_t alignment, size_t size)
+{
+    return alignment ? (size + alignment - 1) / alignment * alignment : size;
+}
+#else
+static inline size_t alignedAllocationSize(size_t, size_t size)
+{
+    return size;
+}
+#endif
+
+
