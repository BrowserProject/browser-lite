+
+// browser-lite: dauerhafter Bytecode-Cache fuer Skripte aus dem Netz.
+//
+// JavaScriptCore kann kompilierten Bytecode speichern und wieder laden (wie
+// die jsc-Shell mit --diskCachePath): beim ersten Ausfuehren fragt der
+// CodeCache den SourceProvider nach gespeichertem Bytecode, neu erzeugter
+// Code (das ganze Skript und spaeter jede Funktion beim ersten Aufruf) kommt
+// als Update dazu. Hier haengt das an CachedScriptSourceProvider; wo der
+// Bytecode liegt, entscheidet der Einbetter (setBytecodeCacheHandlers).
+// JSC prueft beim Laden selbst Version (JSCBytecodeCacheVersion, Build-ID)
+// und Schluessel (Hash, Laenge, Modus und den ganzen Quelltext).
+
+#include "config.h"
+#include "CachedScriptSourceProvider.h"
+
+#include "CommonVM.h"
+#include "WasmPlatform.h"
+#include <JavaScriptCore/BytecodeCacheError.h>
+#include <JavaScriptCore/CachedBytecode.h>
+#include <JavaScriptCore/CachedTypes.h>
+#include <JavaScriptCore/UnlinkedFunctionExecutable.h>
+#include <wtf/HashSet.h>
+#include <wtf/NeverDestroyed.h>
+
+namespace WebCore {
+
+namespace WasmPlatform {
+
+static TakeBytecodeHandler& takeBytecodeHandler()
+{
+    static NeverDestroyed<TakeBytecodeHandler> handler;
+    return handler;
+}
+
+static StoreBytecodeHandler& storeBytecodeHandler()
+{
+    static NeverDestroyed<StoreBytecodeHandler> handler;
+    return handler;
+}
+
+// Skripte, deren neuer Bytecode noch nicht gespeichert ist (nur Haupt-Thread)
+static HashSet<const CachedScriptSourceProvider*>& providersWithBytecode()
+{
+    static NeverDestroyed<HashSet<const CachedScriptSourceProvider*>> providers;
+    return providers;
+}
+
+void setBytecodeCacheHandlers(TakeBytecodeHandler&& take, StoreBytecodeHandler&& store)
+{
+    takeBytecodeHandler() = WTF::move(take);
+    storeBytecodeHandler() = WTF::move(store);
+}
+
+void commitPendingBytecode()
+{
+    for (auto* provider : copyToVector(providersWithBytecode()))
+        provider->commitCachedBytecode();
+}
+
+} // namespace WasmPlatform
+
+// Kleine Skripte kompilieren schneller, als der Weg ueber den Cache kostet
+static constexpr unsigned minimumScriptSizeForBytecodeCache = 4096;
+
+bool CachedScriptSourceProvider::shouldCacheBytecode() const
+{
+    return WasmPlatform::takeBytecodeHandler() && WasmPlatform::storeBytecodeHandler()
+        && !sourceURL().isEmpty() && m_cachedScript->encodedSize() >= minimumScriptSizeForBytecodeCache;
+}
+
+void CachedScriptSourceProvider::startBytecodeCache()
+{
+    if (shouldCacheBytecode())
+        WasmPlatform::providersWithBytecode().add(this);
+}
+
+void CachedScriptSourceProvider::finishBytecodeCache()
+{
+    commitCachedBytecode();
+    WasmPlatform::providersWithBytecode().remove(this);
+}
+
+RefPtr<JSC::CachedBytecode> CachedScriptSourceProvider::cachedBytecode() const
+{
+    if (!m_bytecodeLoaded) {
+        m_bytecodeLoaded = true;
+        if (shouldCacheBytecode()) {
+            if (auto bytes = WasmPlatform::takeBytecodeHandler()(sourceURL()); bytes && !bytes->isEmpty()) {
+                auto buffer = MallocSpan<uint8_t, JSC::VMMalloc>::malloc(bytes->size());
+                memcpySpan(buffer.mutableSpan(), bytes->span());
+                m_cachedBytecode = JSC::CachedBytecode::create(WTF::move(buffer), { });
+            }
+        }
+    }
+    return m_cachedBytecode;
+}
+
+void CachedScriptSourceProvider::cacheBytecode(const JSC::BytecodeCacheGenerator& generator) const
+{
+    if (!shouldCacheBytecode())
+        return;
+    m_bytecodeLoaded = true;
+    if (m_bytecodeCommitted || (m_cachedBytecode && m_cachedBytecode->hasUpdates()))
+        return;
+    // Gespeicherter Bytecode passte nicht (Skript geaendert): ganz neu anfangen,
+    // ein Update haengt sonst nur hinten an den alten Inhalt an
+    auto update = generator();
+    if (!update)
+        return;
+    m_cachedBytecode = JSC::CachedBytecode::create();
+    m_cachedBytecode->addGlobalUpdate(*update);
+}
+
+void CachedScriptSourceProvider::updateCache(const JSC::UnlinkedFunctionExecutable* executable, const JSC::SourceCode&, JSC::CodeSpecializationKind kind, const JSC::UnlinkedFunctionCodeBlock* codeBlock) const
+{
+    if (!m_cachedBytecode || m_bytecodeCommitted)
+        return;
+    // Nur Funktionen aus genau diesem Bytecode (bei einem Treffer im
+    // Speicher-Cache koennen sie aus einem anderen Skript gleichen Inhalts sein)
+    if (!m_cachedBytecode->leafExecutables().contains(executable))
+        return;
+    JSC::BytecodeCacheError error;
+    auto update = JSC::encodeFunctionCodeBlock(commonVM(), codeBlock, error);
+    if (update && !error.isValid())
+        m_cachedBytecode->addFunctionUpdate(executable, kind, *update);
+}
+
+void CachedScriptSourceProvider::commitCachedBytecode() const
+{
+    if (m_bytecodeCommitted || !m_cachedBytecode || !m_cachedBytecode->hasUpdates())
+        return;
+    m_bytecodeCommitted = true;
+    WasmPlatform::providersWithBytecode().remove(this);
+    if (!WasmPlatform::storeBytecodeHandler())
+        return;
+    // Wie die jsc-Shell eine Datei schreibt, nur im Speicher: bisheriger
+    // Bytecode, auf die neue Groesse gebracht, darueber die Updates
+    auto original = m_cachedBytecode->span();
+    Vector<uint8_t> blob(m_cachedBytecode->sizeForUpdate(), [](size_t) -> uint8_t { return 0; });
+    memcpySpan(blob.mutableSpan().first(std::min(original.size(), blob.size())), original.first(std::min(original.size(), blob.size())));
+    bool valid = true;
+    m_cachedBytecode->commitUpdates([&](off_t offset, std::span<const uint8_t> data) {
+        if (offset < 0 || static_cast<size_t>(offset) + data.size() > blob.size()) {
+            valid = false;
+            return;
+        }
+        memcpySpan(blob.mutableSpan().subspan(offset, data.size()), data);
+    });
+    if (valid)
+        WasmPlatform::storeBytecodeHandler()(sourceURL(), WTF::move(blob));
+}
+
+} // namespace WebCore
