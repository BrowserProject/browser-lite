+ * IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES
+ * OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED.
+ * IN NO EVENT SHALL THE AUTHORS BE LIABLE FOR ANY DIRECT, INDIRECT,
+ * INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT
+ * NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE,
+ * DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY
+ * THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT
+ * (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF
+ * THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include "PlatformSpeechSynthesizer.h"
+
+#if ENABLE(SPEECH_SYNTHESIS)
+
+#include "PlatformSpeechSynthesisUtterance.h"
+#include "PlatformSpeechSynthesisVoice.h"
+#include "WasmPlatform.h"
+#include <wtf/HashMap.h>
+#include <wtf/NeverDestroyed.h>
+
+// browser-lite: speechSynthesis ueber den Host-Browser (WasmPlatform.h). Pro
+// Synthesizer spricht hoechstens eine Aeusserung, die Ereignisse des Hosts
+// kommen mit deren ID zurueck.
+
+namespace WebCore {
+
+namespace {
+struct Speaking {
+    WeakPtr<PlatformSpeechSynthesizer> synthesizer;
+    RefPtr<PlatformSpeechSynthesisUtterance> utterance;
+};
+}
+
+static HashMap<uint64_t, Speaking>& speakingByID()
+{
+    static NeverDestroyed<HashMap<uint64_t, Speaking>> map;
+    return map;
+}
+
+static Vector<WeakPtr<PlatformSpeechSynthesizer>>& allSynthesizers()
+{
+    static NeverDestroyed<Vector<WeakPtr<PlatformSpeechSynthesizer>>> list;
+    return list;
+}
+
+Ref<PlatformSpeechSynthesizer> PlatformSpeechSynthesizer::create(PlatformSpeechSynthesizerClient& client)
+{
+    Ref synthesizer = adoptRef(*new PlatformSpeechSynthesizer(client));
+    allSynthesizers().append(synthesizer.get());
+    return synthesizer;
+}
+
+PlatformSpeechSynthesizer::PlatformSpeechSynthesizer(PlatformSpeechSynthesizerClient& client)
+    : m_speechSynthesizerClient(client)
+{
+}
+
+PlatformSpeechSynthesizer::~PlatformSpeechSynthesizer()
+{
+    speakingByID().removeIf([&](auto& entry) {
+        return !entry.value.synthesizer || entry.value.synthesizer.get() == this;
+    });
+    allSynthesizers().removeAllMatching([&](auto& weak) {
+        return !weak || weak.get() == this;
+    });
+}
+
+void PlatformSpeechSynthesizer::initializeVoiceList()
+{
+    for (auto& voice : WasmPlatform::speechVoices())
+        m_voiceList.append(PlatformSpeechSynthesisVoice::create(voice.uri, voice.name, voice.lang, voice.localService, voice.isDefault));
+}
+
+static std::optional<uint64_t> currentID(PlatformSpeechSynthesizer& synthesizer)
+{
+    for (auto& [id, speaking] : speakingByID()) {
+        if (speaking.synthesizer.get() == &synthesizer)
+            return id;
+    }
+    return std::nullopt;
+}
+
+static Function<void(const WasmPlatform::SpeechRequest&)>& speakCallback()
+{
+    static NeverDestroyed<Function<void(const WasmPlatform::SpeechRequest&)>> callback;
+    return callback;
+}
+
+static Function<void(WasmPlatform::SpeechCommand)>& commandCallback()
+{
+    static NeverDestroyed<Function<void(WasmPlatform::SpeechCommand)>> callback;
+    return callback;
+}
+
+void PlatformSpeechSynthesizer::speak(RefPtr<PlatformSpeechSynthesisUtterance>&& utterance)
+{
+    if (!utterance)
+        return;
+    RefPtr client = this->client();
+    if (!speakCallback()) {
+        if (client)
+            client->speakingErrorOccurred(*utterance);
+        return;
+    }
+    static uint64_t nextID = 1;
+    uint64_t id = nextID++;
+    WasmPlatform::SpeechRequest request;
+    request.id = id;
+    request.text = utterance->text();
+    request.lang = utterance->lang();
+    if (auto* voice = utterance->voice())
+        request.voiceURI = voice->voiceURI();
+    request.volume = utterance->volume();
+    request.rate = utterance->rate();
+    request.pitch = utterance->pitch();
+    speakingByID().set(id, Speaking { *this, WTF::move(utterance) });
+    speakCallback()(request);
+}
+
+void PlatformSpeechSynthesizer::pause()
+{
+    if (commandCallback() && currentID(*this))
+        commandCallback()(WasmPlatform::SpeechCommand::Pause);
+}
+
+void PlatformSpeechSynthesizer::resume()
+{
+    if (commandCallback() && currentID(*this))
+        commandCallback()(WasmPlatform::SpeechCommand::Resume);
+}
+
+void PlatformSpeechSynthesizer::cancel()
+{
+    auto id = currentID(*this);
+    if (!id)
+        return;
+    // WebCore erwartet danach kein Ereignis mehr fuer diese Aeusserung
+    speakingByID().remove(*id);
+    if (commandCallback())
+        commandCallback()(WasmPlatform::SpeechCommand::Cancel);
+}
+
+void PlatformSpeechSynthesizer::resetState()
+{
+    cancel();
+}
+
+namespace WasmPlatform {
+
+static Vector<SpeechVoice>& voices()
+{
+    static NeverDestroyed<Vector<SpeechVoice>> list;
+    return list;
+}
+
+void setSpeechVoices(Vector<SpeechVoice>&& list)
+{
+    voices() = WTF::move(list);
+    for (auto& weak : allSynthesizers()) {
+        if (RefPtr synthesizer = weak.get())
+            synthesizer->voicesDidChange();
+    }
+}
+
+const Vector<SpeechVoice>& speechVoices()
+{
+    return voices();
+}
+
+void setSpeechCallbacks(Function<void(const SpeechRequest&)>&& speak, Function<void(SpeechCommand)>&& command)
+{
+    speakCallback() = WTF::move(speak);
+    commandCallback() = WTF::move(command);
+}
+
+void speechEvent(uint64_t id, SpeechEvent event, unsigned charIndex, unsigned charLength)
+{
+    auto it = speakingByID().find(id);
+    if (it == speakingByID().end())
+        return;
+    RefPtr synthesizer = it->value.synthesizer.get();
+    RefPtr utterance = it->value.utterance;
+    if (event == SpeechEvent::End || event == SpeechEvent::Error)
+        speakingByID().remove(it);
+    RefPtr client = synthesizer ? synthesizer->client() : nullptr;
+    if (!client || !utterance)
+        return;
+    switch (event) {
+    case SpeechEvent::Start:
+        client->didStartSpeaking(*utterance);
+        break;
+    case SpeechEvent::End:
+        client->didFinishSpeaking(*utterance);
+        break;
+    case SpeechEvent::Pause:
+        client->didPauseSpeaking(*utterance);
+        break;
+    case SpeechEvent::Resume:
+        client->didResumeSpeaking(*utterance);
+        break;
+    case SpeechEvent::Error:
+        client->speakingErrorOccurred(*utterance);
+        break;
+    case SpeechEvent::WordBoundary:
+        client->boundaryEventOccurred(*utterance, SpeechBoundary::SpeechWordBoundary, charIndex, charLength);
+        break;
+    case SpeechEvent::SentenceBoundary:
+        client->boundaryEventOccurred(*utterance, SpeechBoundary::SpeechSentenceBoundary, charIndex, charLength);
+        break;
+    }
+}
+
+} // namespace WasmPlatform
+
+} // namespace WebCore
+
+#endif // ENABLE(SPEECH_SYNTHESIS)
