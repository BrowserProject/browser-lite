+#include <wtf/NeverDestroyed.h>
+#include <wtf/URL.h>
+
+// browser-lite: Drag & Drop. Ein Pasteboard fuer Drag & Drop schreibt und
+// liest einen WasmPlatform::DragContent statt der Zwischenablage
+// (PasteboardLibWPE.cpp). Der Inhalt haengt an einem eigenen
+// PasteboardContext: der gehoert dem Pasteboard und meldet sich beim Abbau ab.
+// Den Ziehvorgang selber steuert die Engine (DragClient, Host-Ereignisse).
+
+namespace WebCore {
+
+namespace {
+
+class DragPasteboardContext final : public PasteboardContext {
+    WTF_MAKE_TZONE_ALLOCATED_INLINE(DragPasteboardContext);
+public:
+    explicit DragPasteboardContext(Ref<WasmPlatform::DragContent>&& content)
+        : m_content(WTF::move(content))
+    {
+        contents().set(this, m_content.ptr());
+    }
+
+    ~DragPasteboardContext()
+    {
+        contents().remove(this);
+    }
+
+    static HashMap<const PasteboardContext*, WasmPlatform::DragContent*>& contents()
+    {
+        static NeverDestroyed<HashMap<const PasteboardContext*, WasmPlatform::DragContent*>> map;
+        return map;
+    }
+
+private:
+    Ref<WasmPlatform::DragContent> m_content;
+};
+
+WasmPlatform::DragContent* contentOf(const DragData& dragData)
+{
+    return static_cast<WasmPlatform::DragContent*>(dragData.platformData());
+}
+
+} // namespace
+
+namespace WasmPlatform {
+
+String DragContent::string(const String& type) const
+{
+    for (auto& [itemType, value] : strings) {
+        if (equalIgnoringASCIICase(itemType, type))
+            return value;
+    }
+    return { };
+}
+
+void DragContent::setString(const String& type, const String& value)
+{
+    for (auto& item : strings) {
+        if (equalIgnoringASCIICase(item.first, type)) {
+            item.second = value;
+            return;
+        }
+    }
+    strings.append({ type, value });
+}
+
+DragContent* dragContent(const Pasteboard& pasteboard)
+{
+    auto* context = pasteboard.context();
+    return context ? DragPasteboardContext::contents().get(context) : nullptr;
+}
+
+} // namespace WasmPlatform
+
+// Pasteboard der Quelle (dragstart): neuer, leerer Inhalt
+std::unique_ptr<Pasteboard> Pasteboard::createForDragAndDrop(std::unique_ptr<PasteboardContext>&&)
+{
+    return makeUnique<Pasteboard>(makeUnique<DragPasteboardContext>(WasmPlatform::DragContent::create()));
+}
+
+// Pasteboard des Ziels (dragenter/dragover/drop): Inhalt aus den DragData
+std::unique_ptr<Pasteboard> Pasteboard::create(const DragData& dragData)
+{
+    RefPtr content = contentOf(dragData);
+    if (!content)
+        content = WasmPlatform::DragContent::create();
+    return makeUnique<Pasteboard>(makeUnique<DragPasteboardContext>(content.releaseNonNull()));
+}
+
+void Pasteboard::setDragImage(DragImage, const IntPoint&)
+{
+}
+
+bool DragData::canSmartReplace() const
+{
+    return false;
+}
+
+bool DragData::containsColor() const
+{
+    return false;
+}
+
+Color DragData::asColor() const
+{
+    return { };
+}
+
+bool DragData::containsFiles() const
+{
+    auto* content = contentOf(*this);
+    return !m_disallowFileAccess && content && content->hasFiles();
+}
+
+unsigned DragData::numberOfFiles() const
+{
+    auto* content = contentOf(*this);
+    if (m_disallowFileAccess || !content)
+        return 0;
+    return content->files.isEmpty() ? content->fileCount : content->files.size();
+}
+
+Vector<String> DragData::asFilenames() const
+{
+    auto* content = contentOf(*this);
+    if (m_disallowFileAccess || !content)
+        return { };
+    return content->files;
+}
+
+bool DragData::containsPlainText() const
+{
+    auto* content = contentOf(*this);
+    return content && !content->string("text/plain"_s).isEmpty();
+}
+
+String DragData::asPlainText() const
+{
+    auto* content = contentOf(*this);
+    return content ? content->string("text/plain"_s) : String();
+}
+
+bool DragData::containsCompatibleContent(DraggingPurpose) const
+{
+    auto* content = contentOf(*this);
+    return content && (containsPlainText() || containsURL() || !content->string("text/html"_s).isEmpty() || containsFiles());
+}
+
+bool DragData::containsURL(FilenameConversionPolicy filenamePolicy) const
+{
+    return !asURL(filenamePolicy).isEmpty();
+}
+
+String DragData::asURL(FilenameConversionPolicy, String* title) const
+{
+    auto* content = contentOf(*this);
+    if (!content)
+        return { };
+    // Erste Zeile der URI-Liste ohne Kommentare
+    for (auto line : content->string("text/uri-list"_s).split('\n')) {
+        line = line.trim(deprecatedIsSpaceOrNewline);
+        if (line.isEmpty() || line[0] == '#')
+            continue;
+        URL url { line };
+        if (!url.isValid() || url.protocolIsFile())
+            continue;
+        if (title)
+            *title = content->string("text/x-moz-url-desc"_s);
+        return url.string();
+    }
+    return { };
+}
+
+bool DragData::shouldMatchStyleOnDrop() const
+{
+    return false;
+}
+
+} // namespace WebCore
+
+#endif // ENABLE(DRAG_SUPPORT)
