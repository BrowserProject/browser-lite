+static String& userAgentStorage()
+{
+    // WebKit-Seiten erwarten am ehesten einen Safari-artigen User-Agent.
+    static NeverDestroyed<String> userAgent { "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/26.0 Safari/605.1.15"_s };
+    return userAgent;
+}
+
+void setUserAgent(const String& userAgent)
+{
+    userAgentStorage() = userAgent;
+}
+
+String userAgent()
+{
+    return userAgentStorage();
+}
+
+static ClipboardItems& clipboardStorage()
+{
+    static NeverDestroyed<ClipboardItems> items;
+    return items;
+}
+
+static Function<void(const ClipboardItems&)>& clipboardCallback()
+{
+    static NeverDestroyed<Function<void(const ClipboardItems&)>> callback;
+    return callback;
+}
+
+void setClipboardContents(ClipboardItems&& items)
+{
+    clipboardStorage() = WTF::move(items);
+    if (auto& callback = clipboardCallback())
+        callback(clipboardStorage());
+}
+
+const ClipboardItems& clipboardContents()
+{
+    return clipboardStorage();
+}
+
+void setClipboardChangedCallback(Function<void(const ClipboardItems&)>&& callback)
+{
+    clipboardCallback() = WTF::move(callback);
+}
+
+} // namespace WebCore::WasmPlatform
