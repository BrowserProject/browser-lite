+#include "config.h"
+#include "UserAgent.h"
+
+#include "WasmPlatform.h"
+#include <wtf/URL.h>
+
+namespace WebCore {
+
+// Der User-Agent kommt vom Embedder (Standard: Safari-artig, siehe WasmPlatform.cpp).
+// Seiten erkennen WebKit am zuverlaessigsten, wenn "Safari" und "Version/X" drin sind.
+
+String standardUserAgent(const String& applicationName, const String& applicationVersion)
+{
+    if (applicationName.isEmpty())
+        return WasmPlatform::userAgent();
+    return makeString(WasmPlatform::userAgent(), ' ', applicationName, '/', applicationVersion.isEmpty() ? "605.1.15"_s : applicationVersion);
+}
+
+String standardUserAgentForURL(const URL&)
+{
+    return WasmPlatform::userAgent();
+}
+
+} // namespace WebCore
