+#if !USE(COORDINATED_GRAPHICS)
+
+namespace WebCore {
+
+// Ohne Accelerated Compositing malt WebCore alles direkt in den Pixel-Buffer.
+// GraphicsLayer::create wird trotzdem gelinkt (Page-Overlays, Compositor),
+// darum gibt es hier eine Ebene, die nichts tut.
+class GraphicsLayerWasm final : public GraphicsLayer {
+public:
+    GraphicsLayerWasm(Type layerType, GraphicsLayerClient& client)
+        : GraphicsLayer(layerType, client)
+    {
+    }
+
+private:
+    void setNeedsDisplay() final { }
+    void setNeedsDisplayInRect(const FloatRect&, ShouldClipToLayer) final { }
+};
+
+Ref<GraphicsLayer> GraphicsLayer::create(GraphicsLayerFactory* factory, GraphicsLayerClient& client, Type layerType)
+{
+    if (factory)
+        return factory->createGraphicsLayer(layerType, client);
+    return adoptRef(*new GraphicsLayerWasm(layerType, client));
+}
+
+} // namespace WebCore
+
+#endif // !USE(COORDINATED_GRAPHICS)
