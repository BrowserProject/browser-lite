+ * LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include "CurlSSLHandle.h"
+
+#include <cstdio>
+
+namespace WebCore {
+
+static constexpr auto systemBundle = "/etc/ssl/certs/ca-certificates.crt";
+static constexpr auto extraCertificates = "/etc/ssl/certs/extra-ca.crt";
+static constexpr auto combinedBundle = "/tmp/ca-certificates.crt";
+
+static bool appendFile(FILE* out, const char* path)
+{
+    FILE* in = fopen(path, "rb");
+    if (!in)
+        return false;
+    char buffer[16384];
+    size_t length;
+    while ((length = fread(buffer, 1, sizeof(buffer), in)) > 0)
+        fwrite(buffer, 1, length, out);
+    fclose(in);
+    fputc('\n', out);
+    return true;
+}
+
+// Das CA-Bundle (Mozilla) liegt im virtuellen Dateisystem des Embedders. Der
+// Embedder kann zusaetzliche CAs nach extra-ca.crt legen (z.B. Firmen-CA oder
+// Test-CA), dann wird ein gemeinsames Bundle gebaut.
+static String caBundlePath()
+{
+    FILE* probe = fopen(extraCertificates, "rb");
+    if (!probe)
+        return String::fromLatin1(systemBundle);
+    fclose(probe);
+
+    FILE* out = fopen(combinedBundle, "wb");
+    if (!out)
+        return String::fromLatin1(systemBundle);
+    appendFile(out, systemBundle);
+    appendFile(out, extraCertificates);
+    fclose(out);
+    return String::fromLatin1(combinedBundle);
+}
+
+void CurlSSLHandle::platformInitialize()
+{
+    setCACertPath(caBundlePath());
+
+    // Wie der Win-Port, aber ChaCha20 zuerst: ohne AES-Hardware (WebAssembly)
+    // ist es in Software ein Mehrfaches schneller als AES-GCM. TLS 1.3 siehe
+    // CurlContext.cpp.
+    constexpr auto cipherList =
+        "ECDHE-ECDSA-CHACHA20-POLY1305:"
+        "ECDHE-RSA-CHACHA20-POLY1305:"
+        "ECDHE-ECDSA-AES128-GCM-SHA256:"
+        "ECDHE-RSA-AES128-GCM-SHA256:"
+        "ECDHE-ECDSA-AES256-GCM-SHA384:"
+        "ECDHE-RSA-AES256-GCM-SHA384:"
+        "ECDHE-ECDSA-AES256-SHA:"
+        "ECDHE-ECDSA-AES128-SHA:"
+        "ECDHE-RSA-AES128-SHA:"
+        "ECDHE-RSA-AES256-SHA:"
+        "AES128-GCM-SHA256:"
+        "AES256-GCM-SHA384:"
+        "AES128-SHA:"
+        "AES256-SHA";
+
+    constexpr auto ecCurves =
+        "X25519:"
+        "P-256:"
+        "P-384:"
+        "P-521";
+
+    setCipherList(cipherList);
+    setECCurves(ecCurves);
+}
+
+} // namespace WebCore
