+#pragma once
+
+#include <WebCore/FloatRect.h>
+#include <wtf/Function.h>
+#include <wtf/Vector.h>
+#include <wtf/text/WTFString.h>
+
+// browser-lite: Schnittstelle zwischen dem WebCore-Port (PORT=Wasm) und dem
+// Embedder (engine/ im browser-lite Repo). Der Embedder setzt hier Werte, die
+// er vom Host-Browser bekommt (Bildschirm, Clipboard, User-Agent, ...).
+
+namespace WebCore::WasmPlatform {
+
+struct ScreenInfo {
+    FloatRect rect { 0, 0, 1280, 800 };
+    FloatRect availableRect { 0, 0, 1280, 800 };
+    int depth { 24 };
+    bool prefersDarkMode { false };
+    // Hat das Geraet einen Touchscreen (navigator.maxTouchPoints im Host)?
+    bool hasTouch { false };
+};
+
+WEBCORE_EXPORT void setScreenInfo(const ScreenInfo&);
+WEBCORE_EXPORT const ScreenInfo& screenInfo();
+
+WEBCORE_EXPORT void setUserAgent(const String&);
+WEBCORE_EXPORT String userAgent();
+
+// Clipboard: Inhalt als Paare (MIME-Typ, Text). Der Embedder wird bei jedem
+// Schreiben informiert und kann den Inhalt an den Host weitergeben.
+using ClipboardItems = Vector<std::pair<String, String>>;
+WEBCORE_EXPORT void setClipboardContents(ClipboardItems&&);
+WEBCORE_EXPORT const ClipboardItems& clipboardContents();
+WEBCORE_EXPORT void setClipboardChangedCallback(Function<void(const ClipboardItems&)>&&);
+
+// Sprachausgabe (speechSynthesis): gesprochen wird vom Host-Browser. Der
+// Embedder setzt die Stimmen und leitet die Ereignisse des Hosts weiter.
+struct SpeechVoice {
+    String uri;
+    String name;
+    String lang;
+    bool localService { true };
+    bool isDefault { false };
+};
+struct SpeechRequest {
+    uint64_t id { 0 };
+    String text;
+    String lang;
+    String voiceURI;
+    float volume { 1 };
+    float rate { 1 };
+    float pitch { 1 };
+};
+enum class SpeechCommand : uint8_t { Pause, Resume, Cancel };
+enum class SpeechEvent : uint8_t { Start, End, Pause, Resume, Error, WordBoundary, SentenceBoundary };
+WEBCORE_EXPORT void setSpeechVoices(Vector<SpeechVoice>&&);
+WEBCORE_EXPORT const Vector<SpeechVoice>& speechVoices();
+WEBCORE_EXPORT void setSpeechCallbacks(Function<void(const SpeechRequest&)>&& speak, Function<void(SpeechCommand)>&& command);
+WEBCORE_EXPORT void speechEvent(uint64_t id, SpeechEvent, unsigned charIndex = 0, unsigned charLength = 0);
+
+} // namespace WebCore::WasmPlatform
