@@ -1344,11 +1344,35 @@ void Heap::collectNow(Synchronousness synchronousness, GCRequest request)
     RELEASE_ASSERT_NOT_REACHED();
 }
 
+#if OS(EMSCRIPTEN)
+// In WebAssembly sind lokale Variablen fuer den konservativen GC unsichtbar
+// (sie liegen nicht im linearen Speicher). Der Embedder haelt darum waehrend
+// jeder Arbeit ein DeferGC offen. Auch explizite Anforderungen (collectAsync,
+// collectSync) warten dann, bis das aeusserste DeferGC endet. Dort liegt nichts
+// von JSC auf dem Stack und der GC findet alle Wurzeln im Speicher.
+static thread_local std::optional<GCRequest> s_requestDeferredUntilTopLevel;
+
+static void deferUntilTopLevel(GCRequest request)
+{
+    auto& deferred = s_requestDeferredUntilTopLevel;
+    if (!deferred || !request.subsumedBy(*deferred))
+        deferred = request;
+}
+#endif
+
 void Heap::collectAsync(GCRequest request)
 {
     if (!Options::useGC()) [[unlikely]]
         return;
 
+#if OS(EMSCRIPTEN)
+    if (isDeferred()) {
+        deferUntilTopLevel(request);
+        m_didDeferGCWork = true;
+        return;
+    }
+#endif
+
     if constexpr (validateDFGDoesGC)
         vm().verifyCanGC();
 
