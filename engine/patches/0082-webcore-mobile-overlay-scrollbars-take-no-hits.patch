+#include "config.h"
+#include "ScrollbarsController.h"
+
+#include "WasmPlatform.h"
+
+namespace WebCore {
+
+namespace {
+
+// On a mobile device (coarse primary pointer without hover) overlay scrollbars only show the
+// position, like in mobile Chrome and Safari: they take no hit tests, so taps, touches and
+// elementFromPoint reach the content below them. With a mouse they can be dragged.
+class ScrollbarsControllerWasm final : public ScrollbarsController {
+    WTF_DEPRECATED_MAKE_FAST_ALLOCATED(ScrollbarsControllerWasm);
+public:
+    using ScrollbarsController::ScrollbarsController;
+
+    bool shouldScrollbarParticipateInHitTesting(Scrollbar*) final { return !WasmPlatform::screenInfo().mobile; }
+};
+
+} // namespace
+
+std::unique_ptr<ScrollbarsController> ScrollbarsController::create(ScrollableArea& scrollableArea)
+{
+    return makeUnique<ScrollbarsControllerWasm>(scrollableArea);
+}
+
+} // namespace WebCore
