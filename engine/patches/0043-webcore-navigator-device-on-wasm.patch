+// Workers read navigator.platform on their own thread
+static Lock platformLock;
+
+static String& platformStorage() WTF_REQUIRES_LOCK(platformLock)
+{
+    static NeverDestroyed<String> platform { defaultPlatform };
+    return platform;
+}
+
+void setPlatform(const String& platform)
+{
+    Locker locker { platformLock };
+    platformStorage() = platform.isEmpty() ? String { defaultPlatform } : platform.isolatedCopy();
+}
+
+String platform()
+{
+    Locker locker { platformLock };
+    return platformStorage().isolatedCopy();
+}
