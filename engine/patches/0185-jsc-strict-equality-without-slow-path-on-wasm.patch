-        bbb JSCell::m_type[t1], ObjectType, .slow
+        strictEqualityOperands(.slow, .notStringOrSymbol)
     .notStringOrSymbol:
         equalityOperation(t0, t1, t0)
         return(BooleanTag, t0)
