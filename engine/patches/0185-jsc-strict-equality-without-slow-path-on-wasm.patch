+# The operands of a strict equality, tag and payload in t2 and t0, t3 and t1: jumps to slow for
+# what needs C++, else to compare with two payloads whose equality is the result
+macro strictEqualityOperands(slow, compare)
+    # browser-lite: of two tags, equal only as two numbers (`x === undefined` of an object); the
+    # same cell, and two strings that are no ropes as the same text or two atoms, without C++
+    bineq t2, t3, .differentTags
+    bib t2, LowestTag, slow
+    bineq t2, CellTag, compare
+    bpeq t0, t1, compare
+    bbaeq JSCell::m_type[t0], ObjectType, compare
+    bbaeq JSCell::m_type[t1], ObjectType, compare
+    bbneq JSCell::m_type[t0], StringType, slow
+    bbneq JSCell::m_type[t1], StringType, slow
+    loadp JSString::m_fiber[t0], t0
+    loadp JSString::m_fiber[t1], t1
+    btpnz t0, isRopeInPointer, slow
+    btpnz t1, isRopeInPointer, slow
+    bpeq t0, t1, compare
+    btiz StringImpl::m_hashAndFlags[t0], HashFlagsStringKindIsAtom, slow
+    btiz StringImpl::m_hashAndFlags[t1], HashFlagsStringKindIsAtom, slow
+    jmp compare
+.differentTags:
+    bieq t2, Int32Tag, .firstIsNumber
+    bib t2, LowestTag, .firstIsNumber
+    jmp .unequal
+.firstIsNumber:
+    bieq t3, Int32Tag, slow
+    bib t3, LowestTag, slow
+.unequal:
+    move 0, t0
+    move 1, t1
+    jmp compare
+end
+
+
