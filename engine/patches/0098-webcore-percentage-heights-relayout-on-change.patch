+// The basis each box's percentage heights were last resolved against, for boxes whose containers
+// asked needsLayoutForPercentageHeights(). An entry is dropped as soon as a percentage
+// height of the box resolves against another basis, so an entry always describes the box's layout.
+using PercentageHeightBasisMap = SingleThreadWeakHashMap<const RenderBox, RenderBox::PercentageHeightBasis>;
+static PercentageHeightBasisMap* gPercentageHeightBasisMap = nullptr;
+
+bool RenderBox::tracksPercentageHeightBasis() const
+{
+    // Only block containers in normal flow whose percentage heights depend on nothing but their basis:
+    // replaced boxes, tables, flex and grid items and stretch sizes also depend on other state.
+    if (!is<RenderBlock>(*this) || isRenderTable() || isRenderTableCell() || isOutOfFlowPositioned() || isFlexItem() || isGridItem())
+        return false;
+    auto& style = this->style();
+    if (style.aspectRatio().hasRatio())
+        return false;
+    return !style.logicalHeight().isStretch() && !style.logicalMinHeight().isStretch() && !style.logicalMaxHeight().isStretch()
+        && !style.logicalWidth().isStretch() && !style.logicalMinWidth().isStretch() && !style.logicalMaxWidth().isStretch();
+}
+
+bool RenderBox::replacedSizeIsCurrent() const
+{
+    if (!isRenderReplaced() || needsLayout() || isOutOfFlowPositioned() || isFlexItem() || isGridItem() || shouldApplySizeContainment())
+        return false;
+    // Percentages of replaced boxes resolve through auto height containing blocks, in a table cell against
+    // its current height, which changes while it is laid out.
+    for (CheckedPtr block = containingBlock(); block && !is<RenderView>(*block); block = block->containingBlock()) {
+        if (block->isRenderTableCell())
+            return false;
+        auto& logicalHeight = block->style().logicalHeight();
+        if (!logicalHeight.isAuto() && !logicalHeight.isPercentOrCalculated())
+            break;
+    }
+    LogicalExtentComputedValues width;
+    computeLogicalWidth(width);
+    if (width.extent != logicalWidth() || width.margins.start != marginStart() || width.margins.end != marginEnd())
+        return false;
+    auto height = computeLogicalHeight(logicalHeight(), logicalTop());
+    return height.extent == logicalHeight() && height.margins.before == marginBefore() && height.margins.after == marginAfter();
+}
+
+bool RenderBox::needsLayoutForPercentageHeights() const
+{
+    if (isRenderReplaced())
+        return !replacedSizeIsCurrent();
+    if (!tracksPercentageHeightBasis())
+        return true;
+    auto basis = percentageHeightBasis(UpdatePercentageHeightDescendants::No);
+    if (!gPercentageHeightBasisMap)
+        gPercentageHeightBasisMap = new PercentageHeightBasisMap;
+    auto result = gPercentageHeightBasisMap->add(*this, basis);
+    if (result.isNewEntry)
+        return true;
+    if (result.iterator->value == basis)
+        return false;
+    result.iterator->value = basis;
+    return true;
+}
+
+template<typename SizeType> std::optional<LayoutUnit> RenderBox::computePercentageLogicalHeightGeneric(const SizeType& logicalHeight, UpdatePercentageHeightDescendants updateDescendants) const
+{
+    auto basis = percentageHeightBasis(updateDescendants);
+    if (gPercentageHeightBasisMap) {
+        if (auto entry = gPercentageHeightBasisMap->find(*this); entry != gPercentageHeightBasisMap->end() && entry->value != basis)
+            gPercentageHeightBasisMap->remove(entry);
+    }
+
+    if (basis.resolvesToZero)
+        return 0_lu;
+    if (!basis.availableHeight)
+        return { };
+
+    auto result = [&] {
+        if constexpr (Style::IsPercentage<SizeType>)
+            return Style::evaluate<LayoutUnit>(logicalHeight, *basis.availableHeight);
+        else
+            return Style::evaluate<LayoutUnit>(logicalHeight, *basis.availableHeight, style().usedZoomForLength());
+    }();
+
+    if (basis.subtractBorderAndPadding) {
         result -= borderAndPaddingLogicalHeight();
         return std::max(0_lu, result);
     }
