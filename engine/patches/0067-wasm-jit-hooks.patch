diff --git a/Source/JavaScriptCore/llint/LLIntWasmJIT.h b/Source/JavaScriptCore/llint/LLIntWasmJIT.h
new file mode 100644
index 0000000000..d60ab8e481
--- /dev/null
+++ b/Source/JavaScriptCore/llint/LLIntWasmJIT.h
@@ -0,0 +1,28 @@
+/*
+ * browser-lite: the JIT to WebAssembly (engine/jit of browser-lite, docs/jit.md). JavaScriptCore
+ * runs the C loop; these hooks let hot CodeBlocks run as compiled WebAssembly instead.
+ */
+#pragma once
+
+#include "Instruction.h"
+
+namespace JSC {
+
+class CallFrame;
+class CodeBlock;
+class VM;
+
+namespace LLInt {
+
+// At op_enter (slow_path_enter): runs the compiled code of the CodeBlock, if any. Returns the
+// instruction to go on with (an op_ret, or the exception instructions), nullptr to interpret.
+const JSInstruction* wasmJITEnter(CallFrame*, CodeBlock*);
+
+// The CodeBlock got hot (llint_replace): compiles it, if the JIT is on and it can.
+void wasmJITTierUp(VM&, CodeBlock*);
+
+// The CodeBlock goes away (~CodeBlock): its compiled code too.
+void wasmJITForget(CodeBlock*);
+
+} // namespace LLInt
+} // namespace JSC
diff --git a/Source/JavaScriptCore/runtime/CommonSlowPaths.cpp b/Source/JavaScriptCore/runtime/CommonSlowPaths.cpp
index 83a7cb7be6..84f2ffae85 100644
--- a/Source/JavaScriptCore/runtime/CommonSlowPaths.cpp
+++ b/Source/JavaScriptCore/runtime/CommonSlowPaths.cpp
@@ -60,6 +60,7 @@
 #include "LLIntExceptions.h"
 #include "MathCommon.h"
 #include "ObjectConstructor.h"
+#include "LLIntWasmJIT.h"
 #include "ScopedArguments.h"
 #include "TypeProfilerLog.h"
 #include "runtime/Error.h"
@@ -1227,6 +1228,10 @@ JSC_DEFINE_COMMON_SLOW_PATH(slow_path_enter)
     GET(codeBlock->scopeRegister()) = uncheckedDowncast<JSCallee>(callFrame->jsCallee())->scope();
     if (codeBlock->couldBeTainted()) [[unlikely]]
         vm.setMightBeExecutingTaintedCode();
+    // browser-lite: compiled code (docs/jit.md). The C loop steps over op_enter after this, so
+    // the next instruction is handed back that much earlier
+    if (auto* next = LLInt::wasmJITEnter(callFrame, codeBlock))
+        RETURN_TWO(reinterpret_cast<const JSInstruction*>(reinterpret_cast<const uint8_t*>(next) - pc->size()), callFrame);
     END();
 }
 
