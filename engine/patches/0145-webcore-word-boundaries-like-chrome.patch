+// The rules of Blink's position_units_word.cc (PlatformWordBehavior::kWordDontSkipSpaces) on
+// WebKit's flattened text, where a block boundary is a line break like one in preformatted text.
+static bool isLineBreak(char16_t character)
+{
+    return character == '\n' || character == '\r';
+}
+
+static bool isWhitespace(char16_t character)
+{
+    return character == ' ' || character == '\n' || character == '\t' || character == noBreakSpace;
+}
+
+// A character that ends the word or punctuation run before it.
+static bool isWordBreak(char16_t character)
+{
+    return (u_isprint(character) && !isWhitespace(character)) || U16_IS_SURROGATE(character) || isLineBreak(character) || character == lowLine;
+}
+
+// Punctuation, symbols and characters outside the BMP (emoji): a run of them is one stop.
+static bool isPunctuationOrSymbol(char16_t character)
+{
+    return u_ispunct(character) || (U_GET_GC_MASK(character) & U_GC_S_MASK) || U16_IS_SURROGATE(character);
+}
+
+int findPreviousWordPosition(StringView text, int position)
+{
+    UBreakIterator* it = wordBreakIterator(text);
+    int punctuationRun = -1;
+    int runner = ubrk_preceding(it, position);
+    for (; runner > 0; runner = ubrk_preceding(it, runner)) {
+        if (isPunctuationOrSymbol(text[runner])) {
+            if (u_isalnum(text[runner - 1]))
+                return runner;
+            punctuationRun = runner;
+            continue;
+        }
+        if (punctuationRun >= 0)
+            return punctuationRun;
+        if (isWordBreak(text[runner]))
+            return runner;
+    }
+    // A run that reaches the start of the text may go on in text before it
+    if (!runner && punctuationRun >= 0 && !isPunctuationOrSymbol(text[0]))
+        return punctuationRun;
+    return 0;
+}
+
+int findNextWordPosition(StringView text, int position)
+{
+    unsigned length = text.length();
+    UBreakIterator* it = wordBreakIterator(text);
+    for (int runner = ubrk_following(it, position); runner != UBRK_DONE && static_cast<unsigned>(runner) < length; runner = ubrk_following(it, runner)) {
+        if (isLineBreak(text[runner]))
+            return runner;
+        if (isPunctuationOrSymbol(text[runner])) {
+            if (u_isalnum(text[runner - 1]))
+                return runner;
+            continue;
+        }
+        if (isWordBreak(text[runner - 1]))
+            return runner;
+    }
+    return length;
+}
+
 #endif // !USE(APPKIT)
 
