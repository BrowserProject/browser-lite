+// Whether a word goes on across character depends on the characters on both sides of it (UAX #29
+// WB6, WB7, WB11, WB12: "don't", "3.14"), so a search that starts or ends next to it needs one more.
+static bool joinsWordParts(char32_t character)
+{
+    switch (u_getIntPropertyValue(character, UCHAR_WORD_BREAK)) {
+    case U_WB_MIDLETTER:
+    case U_WB_MIDNUM:
+    case U_WB_MIDNUMLET:
+    case U_WB_SINGLE_QUOTE:
+    case U_WB_DOUBLE_QUOTE:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static unsigned appendFirstCharacter(const SimpleRange& range, Vector<char16_t, 1024>& string)
+{
+    for (TextIterator it(range); !it.atEnd(); it.advance()) {
+        StringView text = it.text();
+        if (text.isEmpty())
+            continue;
+        unsigned length = text.length() > 1 && U16_IS_LEAD(text[0]) ? 2 : 1;
+        append(string, text.left(length));
+        return length;
+    }
+    return 0;
+}
+
+static unsigned prependLastCharacter(const SimpleRange& range, Vector<char16_t, 1024>& string)
+{
+    for (SimplifiedBackwardsTextIterator it(range); !it.atEnd(); it.advance()) {
+        StringView text = it.text();
+        if (text.isEmpty())
+            continue;
+        unsigned length = text.length() > 1 && U16_IS_TRAIL(text[text.length() - 1]) ? 2 : 1;
+        prepend(string, text.substring(text.length() - length));
+        return length;
+    }
+    return 0;
+}
