+#if OS(EMSCRIPTEN)
+// browser-lite: small per thread cache in front of dlmalloc. Emscripten's malloc takes
+// a lock on every call in a build with threads and searches its bins;
+// WebCore/JSC call fastMalloc/fastFree for small blocks very often (CNN:
+// about 7 % of the time in the engine thread). Freed small blocks go into
+// a list per size class of this thread and are handed out again without a lock.
+// Every block stays a normal dlmalloc block (free(), realloc()
+// and malloc_usable_size() keep working). BL_MALLOC_CACHE=0 turns it off.
+namespace {
+
+constexpr size_t smallBlockStep = 16;
+constexpr unsigned smallBlockClasses = 33; // Class k: usable at least k * 16 bytes, up to 512
+constexpr size_t smallBlockMax = smallBlockStep * (smallBlockClasses - 1);
+constexpr uint16_t maxCachedBlocksPerClass = 64;
+
+struct CachedBlock {
+    CachedBlock* next;
+};
+
+struct SmallBlockCache {
+    CachedBlock* heads[smallBlockClasses];
+    uint16_t counts[smallBlockClasses];
+    uint8_t state; // 0 not set up yet, 1 active, 2 off (thread ends or disabled)
+};
+
+thread_local SmallBlockCache smallBlockCache;
+pthread_key_t smallBlockCacheKey;
+
+void flushSmallBlockCache(SmallBlockCache& cache)
+{
+    for (unsigned k = 0; k < smallBlockClasses; ++k) {
+        for (auto* block = cache.heads[k]; block;) {
+            auto* next = block->next;
+            ::free(block);
+            block = next;
+        }
+        cache.heads[k] = nullptr;
+        cache.counts[k] = 0;
+    }
+}
+
+void destroySmallBlockCache(void* pointer)
+{
+    auto& cache = *static_cast<SmallBlockCache*>(pointer);
+    cache.state = 2;
+    flushSmallBlockCache(cache);
+}
+
+bool smallBlockCacheEnabled()
+{
+    static bool enabled = [] {
+        const char* value = getenv("BL_MALLOC_CACHE");
+        if (value && !strcmp(value, "0"))
+            return false;
+        pthread_key_create(&smallBlockCacheKey, destroySmallBlockCache);
+        return true;
+    }();
+    return enabled;
+}
+
+ALWAYS_INLINE SmallBlockCache* activeSmallBlockCache()
+{
+    auto& cache = smallBlockCache;
+    if (cache.state == 1) [[likely]]
+        return &cache;
+    if (cache.state || !smallBlockCacheEnabled()) {
+        cache.state = 2;
+        return nullptr;
+    }
+    cache.state = 1;
+    // When the thread ends, give back to dlmalloc
+    pthread_setspecific(smallBlockCacheKey, &cache);
+    return &cache;
+}
+
+// Small request: first from the cache, otherwise the full class size from dlmalloc
+ALWAYS_INLINE void* allocateSmallBlock(size_t size, bool zeroed)
+{
+    unsigned k = (size + smallBlockStep - 1) / smallBlockStep;
+    void* result = nullptr;
+    if (auto* cache = activeSmallBlockCache()) {
+        if (auto* block = cache->heads[k]) {
+            cache->heads[k] = block->next;
+            --cache->counts[k];
+            result = block;
+        }
+    }
+    if (!result)
+        result = ::malloc(k * smallBlockStep);
+    if (result && zeroed)
+        memset(result, 0, size);
+    return result;
+}
+
+ALWAYS_INLINE bool isSmallAllocation(size_t size)
+{
+    return size - 1 < smallBlockMax;
+}
+
+ALWAYS_INLINE bool cacheSmallBlock(void* object)
+{
+    size_t usable = malloc_usable_size(object);
+    unsigned k = usable / smallBlockStep;
+    if (!k || k >= smallBlockClasses)
+        return false;
+    auto* cache = activeSmallBlockCache();
+    if (!cache || cache->counts[k] >= maxCachedBlocksPerClass)
+        return false;
+    auto* block = static_cast<CachedBlock*>(object);
+    block->next = cache->heads[k];
+    cache->heads[k] = block;
+    ++cache->counts[k];
+    return true;
+}
+
+} // namespace
+#endif
