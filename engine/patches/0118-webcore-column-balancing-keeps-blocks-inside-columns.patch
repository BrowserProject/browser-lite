+bool RenderMultiColumnFlow::keepsLayoutOfBlocksInsideColumns() const
+{
+    if (!m_inBalancingPass || hasColumnSpanner())
+        return false;
+    auto* columnSet = firstMultiColumnSet();
+    if (!columnSet || columnSet != lastMultiColumnSet() || !columnSet->columnHeightComputed() || !columnSet->computedColumnHeight())
+        return false;
+    if (!writingMode().isHorizontal() || writingMode().isBlockFlipped())
+        return false;
+    auto* multicolBlock = multiColumnBlockFlow();
+    return multicolBlock && !multicolBlock->enclosingFragmentedFlow() && !document().printing()
+        && view().frameView().pagination().mode == Pagination::Mode::Unpaginated;
+}
+
+bool RenderMultiColumnFlow::contentStaysInsideColumn(LayoutUnit logicalTop, LayoutUnit logicalBottom) const
+{
+    auto* columnSet = firstMultiColumnSet();
+    if (!columnSet || columnSet != lastMultiColumnSet() || hasColumnSpanner())
+        return false;
+    if (!columnSet->columnHeightComputed())
+        return true;
+    LayoutUnit columnHeight = columnSet->computedColumnHeight();
+    if (columnHeight <= 0)
+        return false;
+    LayoutUnit columnTop = pageLogicalTopForOffset(logicalTop);
+    return logicalTop > columnTop && logicalBottom < columnTop + columnHeight;
+}
