+// The block with the overflow of its content (which is fragmented too), from the offset of its top
+// in the fragmented flow; only for horizontal-tb
+std::optional<std::pair<LayoutUnit, LayoutUnit>> RenderBlockFlow::extentInFragmentedFlow(LayoutUnit pageLogicalOffset) const
+{
+    if (!writingMode().isHorizontal() || writingMode().isBlockFlipped())
+        return std::nullopt;
+    auto layoutOverflow = layoutOverflowRect();
+    auto visualOverflow = visualOverflowRect();
+    LayoutUnit top = std::min({ 0_lu, layoutOverflow.y(), visualOverflow.y() });
+    LayoutUnit bottom = std::max({ logicalHeight(), layoutOverflow.maxY(), visualOverflow.maxY() });
+    return std::pair { pageLogicalOffset + top, pageLogicalOffset + bottom };
+}
+
+// A balancing pass of a multicol (relayoutForPagination) lays out its content again for the new
+// column height. This block keeps its layout when its last one met no column boundary and no
+// forced break and it still lies strictly inside one column: laid out again it would come out the
+// same. Wikipedia's reference lists took 2 to 4 such passes, longer than the rest of the article.
+// Like Blink's legacy LayoutBlock::ChildNeedsRelayoutForPagination.
+bool RenderBlockFlow::keepsLayoutForColumnBalancing()
+{
+    if (!layoutStayedInsideColumn() || paginationStrut() || isFloating() || isOutOfFlowPositioned() || isRenderFragmentedFlow() || multiColumnFlow())
+        return false;
+    auto* layoutState = view().frameView().layoutContext().layoutState();
+    if (!layoutState || !layoutState->isPaginated() || layoutState->lineGrid())
+        return false;
+    CheckedPtr multicolFlow = dynamicDowncast<RenderMultiColumnFlow>(enclosingFragmentedFlow());
+    if (!multicolFlow || !multicolFlow->keepsLayoutOfBlocksInsideColumns())
+        return false;
+    auto pageLogicalOffset = layoutState->pageLogicalOffset(this, logicalTop());
+    auto extent = extentInFragmentedFlow(pageLogicalOffset);
+    if (!extent || !multicolFlow->contentStaysInsideColumn(extent->first, extent->second))
+        return false;
+    setPageLogicalOffset(pageLogicalOffset);
+    return true;
+}
+
+void RenderBlockFlow::markForPaginationRelayoutIfNeeded()
+{
+    if (!needsLayout() && keepsLayoutForColumnBalancing())
+        return;
+    RenderBlock::markForPaginationRelayoutIfNeeded();
+}
