+#if PLATFORM(WASM)
+// browser-lite: an argument after the first as text for the embedder, without running page code:
+// Safari converts only the first argument, and scripts count toString and getter calls to tell
+// whether the console is open. Primitives as strings, errors by their name and message data
+// properties, other objects by class name like the inspector's preview.
+static String argumentPreview(JSC::JSGlobalObject& globalObject, JSC::JSValue value)
+{
+    if (value.isSymbol())
+        return asSymbol(value)->tryGetDescriptiveString().value_or(String());
+    auto* object = value.isObject() ? asObject(value) : nullptr;
+    if (object && is<JSC::ProxyObject>(object))
+        return "Proxy"_s;
+    if (object && !is<JSC::ErrorInstance>(object))
+        return JSC::JSObject::calculatedClassName(object);
+    auto scope = DECLARE_TOP_EXCEPTION_SCOPE(globalObject.vm());
+    auto text = object ? downcast<JSC::ErrorInstance>(object)->sanitizedToString(&globalObject) : value.toWTFString(&globalObject);
+    scope.clearException();
+    if (object && text.isEmpty())
+        return JSC::JSObject::calculatedClassName(object);
+    return text;
+}
+
+// browser-lite: the embedder gets the whole message like Chrome's console, not only the first
+// argument: messageText (WebKit's own conversion of the first argument), whose format specifiers
+// take the next arguments (%c drops its style), then the remaining arguments separated by spaces.
+static String messageWithAllArguments(const String& messageText, const Inspector::ScriptArguments& arguments)
+{
+    StringBuilder builder;
+    size_t next = 1;
+    size_t count = arguments.argumentCount();
+    auto& globalObject = *arguments.globalObject();
+    bool formatted = arguments.argumentAt(0).isString();
+    for (unsigned i = 0; i < messageText.length(); ++i) {
+        char16_t character = messageText[i];
+        if (!formatted || character != '%' || i + 1 >= messageText.length()) {
+            builder.append(character);
+            continue;
+        }
+        char16_t specifier = messageText[i + 1];
+        if (specifier == '%') {
+            builder.append('%');
+            ++i;
+        } else if (specifier == 'c' && next < count) {
+            ++next;
+            ++i;
+        } else if ((specifier == 's' || specifier == 'd' || specifier == 'i' || specifier == 'f' || specifier == 'o' || specifier == 'O') && next < count) {
+            builder.append(argumentPreview(globalObject, arguments.argumentAt(next++)));
+            ++i;
+        } else
+            builder.append(character);
+    }
+    for (; next < count; ++next)
+        builder.append(' ', argumentPreview(globalObject, arguments.argumentAt(next)));
+    return builder.toString();
+}
+#endif
