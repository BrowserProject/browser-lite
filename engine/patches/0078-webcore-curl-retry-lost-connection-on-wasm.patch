+#if PLATFORM(WASM)
+// Like other browsers: a connection from the pool (kept alive, HTTP/2, preconnected) can die
+// while the request is on its way, the server closed it in the meantime. When that happens before
+// any response byte, the request is sent again on a new connection. curl itself only does this
+// for some HTTP/1.1 cases, not for a lost HTTP/2 connection. Not repeated: a request on a new
+// connection and a stream the server reset (CURLE_HTTP2_STREAM), there the server refused it.
+bool CurlRequest::retryOnNewConnection(CURLcode result)
+{
+    static constexpr unsigned maxRetries = 2;
+
+    switch (result) {
+    case CURLE_SEND_ERROR:
+    case CURLE_RECV_ERROR:
+    case CURLE_GOT_NOTHING:
+    case CURLE_HTTP2:
+        break;
+    default:
+        return false;
+    }
+
+    long newConnections = 0;
+    if (m_connectionRetries >= maxRetries || !m_response.headers.isEmpty() || m_totalReceivedSize || !m_curlHandle
+        || curl_easy_getinfo(m_curlHandle->handle(), CURLINFO_NUM_CONNECTS, &newConnections) != CURLE_OK || newConnections)
+        return false;
+
+    ++m_connectionRetries;
+    finalizeTransfer();
+    m_formDataStream.rewind();
+    m_response = CurlResponse { };
+    m_didReceiveResponse = false;
+    m_requestHeaders.clear();
+    m_requestHeaderSize = 0;
+
+    runOnMainThread([this, protectedThis = Ref { *this }] {
+        if (!isCancelled())
+            startWithJobManager();
+    });
+    return true;
+}
+#endif
