     // Block size must be at least as large as the system page size.
+#if OS(EMSCRIPTEN)
+    // browser-lite: CeilingOnPageSize is the WebAssembly page of 64 KB, which says nothing about
+    // how memory is handed out (blocks come from malloc, nothing is decommitted or protected).
+    // Blocks of 16 KB like on other systems: a block that keeps a few live cells keeps a quarter
+    // of the memory.
+    static constexpr size_t blockSize = 16 * KB;
+#else
     static constexpr size_t blockSize = std::max(16 * KB, CeilingOnPageSize);
+#endif
     static_assert(hasOneBitSet(blockSize)); // blockSize must be a power of two.
     static_assert((WeakBlock::blockSize * 16) == 16 * KB);
 
