+#if PLATFORM(WASM)
+IntSize JPEGImageDecoder::frameSizeAtIndex(size_t, SubsamplingLevel subsamplingLevel) const
+{
+    // What jpeg_calc_output_dimensions() gives for a scale of 1 / 2^level: rounded up.
+    auto size = this->size();
+    int denominator = 1 << static_cast<int>(std::min(subsamplingLevel, SubsamplingLevel::Last));
+    return { (size.width() + denominator - 1) / denominator, (size.height() + denominator - 1) / denominator };
+}
+
+void JPEGImageDecoder::setSubsamplingLevel(SubsamplingLevel subsamplingLevel)
+{
+    assertIsHeld(m_lock);
+    subsamplingLevel = std::min(subsamplingLevel, SubsamplingLevel::Last);
+    if (subsamplingLevel == m_subsamplingLevel)
+        return;
+
+    // Another scale starts over with a new reader and frame. A native image
+    // made from the old frame keeps its own reference to the old pixels.
+    m_subsamplingLevel = subsamplingLevel;
+    clear();
+    if (!m_frameBufferCache.isEmpty())
+        m_frameBufferCache[0].clear();
+}
+#endif
