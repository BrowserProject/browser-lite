+
+// browser-lite: persistent bytecode cache for scripts from the network.
+//
+// JavaScriptCore can store compiled bytecode and load it again (like
+// the jsc shell with --diskCachePath): on the first run the
+// CodeCache asks the SourceProvider for stored bytecode, newly generated
+// code (the whole script and later each function on its first call) is added
+// as an update. Here this is attached to CachedScriptSourceProvider; where the
+// bytecode is kept is decided by the embedder (setBytecodeCacheHandlers).
+// On load JSC itself checks the version (JSCBytecodeCacheVersion, build ID)
+// and the key (hash, length, mode and the whole source text).
+
+#include "config.h"
+#include "CachedScriptSourceProvider.h"
+
+#include "CommonVM.h"
+#include "WasmPlatform.h"
+#include <JavaScriptCore/BytecodeCacheError.h>
+#include <JavaScriptCore/CachedBytecode.h>
+#include <JavaScriptCore/CachedTypes.h>
+#include <JavaScriptCore/StrongInlines.h>
+#include <JavaScriptCore/UnlinkedFunctionCodeBlock.h>
+#include <JavaScriptCore/UnlinkedFunctionExecutable.h>
+#include <wtf/HashMap.h>
+#include <wtf/HashSet.h>
+#include <wtf/NeverDestroyed.h>
+
+namespace WebCore {
+
+namespace WasmPlatform {
+
+static TakeBytecodeHandler& takeBytecodeHandler()
+{
+    static NeverDestroyed<TakeBytecodeHandler> handler;
+    return handler;
+}
+
+static StoreBytecodeHandler& storeBytecodeHandler()
+{
+    static NeverDestroyed<StoreBytecodeHandler> handler;
+    return handler;
+}
+
+// Scripts whose new bytecode is not stored yet (main thread only)
+static HashSet<const CachedScriptSourceProvider*>& providersWithBytecode()
+{
+    static NeverDestroyed<HashSet<const CachedScriptSourceProvider*>> providers;
+    return providers;
+}
+
+void setBytecodeCacheHandlers(TakeBytecodeHandler&& take, StoreBytecodeHandler&& store)
+{
+    takeBytecodeHandler() = WTF::move(take);
+    storeBytecodeHandler() = WTF::move(store);
+}
+
+void commitPendingBytecode()
+{
+    for (auto* provider : copyToVector(providersWithBytecode()))
+        provider->commitCachedBytecode();
+}
+
+// Newly compiled functions, not encoded yet (main thread only). Encoding
+// cost time in the middle of loading on the first visit (weather.com 1.35 s),
+// so it only happens when storing while idle.
+struct PendingFunction {
+    JSC::Strong<JSC::UnlinkedFunctionExecutable> executable;
+    JSC::CodeSpecializationKind kind;
+    JSC::Strong<JSC::UnlinkedFunctionCodeBlock> codeBlock;
+};
+
+static HashMap<const CachedScriptSourceProvider*, Vector<PendingFunction>>& pendingFunctions()
+{
+    static NeverDestroyed<HashMap<const CachedScriptSourceProvider*, Vector<PendingFunction>>> functions;
+    return functions;
+}
+
+} // namespace WasmPlatform
+
+// Small scripts compile faster than a round trip through the cache costs
+static constexpr unsigned minimumScriptSizeForBytecodeCache = 4096;
+
+// The embedder hands over fastMalloc blocks (TakeBytecodeHandler), JSC takes them as they are
+static_assert(std::is_same_v<JSC::VMMalloc, FastMalloc>);
+
+bool CachedScriptSourceProvider::shouldCacheBytecode() const
+{
+    return WasmPlatform::takeBytecodeHandler() && WasmPlatform::storeBytecodeHandler()
+        && !m_bytecodeNotCached && m_cachedScript->encodedSize() >= minimumScriptSizeForBytecodeCache;
+}
+
+void CachedScriptSourceProvider::startBytecodeCache()
+{
+    if (shouldCacheBytecode())
+        WasmPlatform::providersWithBytecode().add(this);
+}
+
+void CachedScriptSourceProvider::finishBytecodeCache()
+{
+    commitCachedBytecode();
+    WasmPlatform::providersWithBytecode().remove(this);
+    WasmPlatform::pendingFunctions().remove(this);
+}
+
+RefPtr<JSC::CachedBytecode> CachedScriptSourceProvider::cachedBytecode() const
+{
+    if (!m_bytecodeLoaded) {
+        m_bytecodeLoaded = true;
+        if (shouldCacheBytecode()) {
+            auto bytes = WasmPlatform::takeBytecodeHandler()(*m_cachedScript);
+            if (!bytes) {
+                // Not cached by the embedder: nothing is encoded for it either
+                m_bytecodeNotCached = true;
+                WasmPlatform::providersWithBytecode().remove(this);
+            } else if (!bytes->span().empty())
+                m_cachedBytecode = JSC::CachedBytecode::create(WTF::move(*bytes), { });
+        }
+    }
+    return m_cachedBytecode;
+}
+
+void CachedScriptSourceProvider::cacheBytecode(const JSC::BytecodeCacheGenerator& generator) const
+{
+    if (!shouldCacheBytecode())
+        return;
+    m_bytecodeLoaded = true;
+    if (m_bytecodeCommitted || (m_cachedBytecode && m_cachedBytecode->hasUpdates()))
+        return;
+    // Stored bytecode did not match (script changed): start from scratch,
+    // otherwise an update is only appended to the old content
+    auto update = generator();
+    if (!update)
+        return;
+    m_cachedBytecode = JSC::CachedBytecode::create();
+    m_cachedBytecode->addGlobalUpdate(*update);
+}
+
+void CachedScriptSourceProvider::updateCache(const JSC::UnlinkedFunctionExecutable* executable, const JSC::SourceCode&, JSC::CodeSpecializationKind kind, const JSC::UnlinkedFunctionCodeBlock* codeBlock) const
+{
+    if (!m_cachedBytecode || m_bytecodeCommitted)
+        return;
+    // Only functions from exactly this bytecode (on a hit in the memory
+    // cache they can come from another script with the same content)
+    if (!m_cachedBytecode->leafExecutables().contains(executable))
+        return;
+    auto& vm = commonVM();
+    WasmPlatform::pendingFunctions().ensure(this, [] { return Vector<WasmPlatform::PendingFunction> { }; }).iterator->value.append({
+        { vm, const_cast<JSC::UnlinkedFunctionExecutable*>(executable) },
+        kind,
+        { vm, const_cast<JSC::UnlinkedFunctionCodeBlock*>(codeBlock) },
+    });
+}
+
+void CachedScriptSourceProvider::commitCachedBytecode() const
+{
+    if (m_bytecodeCommitted || !m_cachedBytecode)
+        return;
+    // Encode the remembered functions now (not during a GC, in case the
+    // provider dies during cleanup: then they are dropped)
+    auto pending = WasmPlatform::pendingFunctions().take(this);
+    auto& vm = commonVM();
+    if (vm.heap.mutatorState() == JSC::MutatorState::Running) {
+        for (auto& function : pending) {
+            if (!m_cachedBytecode->leafExecutables().contains(function.executable.get()))
+                continue;
+            JSC::BytecodeCacheError error;
+            auto update = JSC::encodeFunctionCodeBlock(vm, function.codeBlock.get(), error);
+            if (update && !error.isValid())
+                m_cachedBytecode->addFunctionUpdate(function.executable.get(), function.kind, *update);
+        }
+    }
+    if (!m_cachedBytecode->hasUpdates())
+        return;
+    m_bytecodeCommitted = true;
+    WasmPlatform::providersWithBytecode().remove(this);
+    if (!WasmPlatform::storeBytecodeHandler())
+        return;
+    // Like the jsc shell writes a file, only in memory: the previous
+    // bytecode, resized to the new size, with the updates on top
+    auto original = m_cachedBytecode->span();
+    Vector<uint8_t> blob(m_cachedBytecode->sizeForUpdate(), [](size_t) -> uint8_t { return 0; });
+    memcpySpan(blob.mutableSpan().first(std::min(original.size(), blob.size())), original.first(std::min(original.size(), blob.size())));
+    bool valid = true;
+    m_cachedBytecode->commitUpdates([&](off_t offset, std::span<const uint8_t> data) {
+        if (offset < 0 || static_cast<size_t>(offset) + data.size() > blob.size()) {
+            valid = false;
+            return;
+        }
+        memcpySpan(blob.mutableSpan().subspan(offset, data.size()), data);
+    });
+    if (valid)
+        WasmPlatform::storeBytecodeHandler()(*m_cachedScript, WTF::move(blob));
+}
+
+} // namespace WebCore
