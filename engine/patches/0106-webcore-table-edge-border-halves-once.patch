+RenderTable::CollapsedEdgeInnerHalves RenderTable::collapsedEdgeInnerHalves()
+{
+    if (m_collapsedEdgeInnerHalves)
+        return *m_collapsedEdgeInnerHalves;
+    ASSERT(collapseBorders());
+    recalcSectionsIfNeeded();
+    CollapsedEdgeInnerHalves halves;
+    // With collapsed borders the border of a cell is its inner half
+    if (unsigned columns = numEffCols()) {
+        for (auto& section : childrenOfType<RenderTableSection>(*this)) {
+            for (auto* row = section.firstRow(); row; row = row->nextRow()) {
+                for (auto* cell = row->firstCell(); cell; cell = cell->nextCell()) {
+                    if (!colToEffCol(cell->col()))
+                        halves.left = std::max(halves.left, cell->borderLeft());
+                    if (colToEffCol(cell->col() + cell->colSpan() - 1) == columns - 1)
+                        halves.right = std::max(halves.right, cell->borderRight());
+                }
+            }
+        }
+    }
+    m_collapsedEdgeInnerHalves = halves;
+    return halves;
+}
