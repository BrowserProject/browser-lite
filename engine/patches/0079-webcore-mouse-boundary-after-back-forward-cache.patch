+void EventHandler::restoreMouseBoundaryState(Element* lastElementUnderMouse, LocalFrame* lastMouseMoveEventSubframe)
+{
+    Ref frame = m_frame.get();
+    if (lastElementUnderMouse && lastElementUnderMouse->isConnected() && &lastElementUnderMouse->document() == frame->document()) {
+        m_lastElementUnderMouse = lastElementUnderMouse;
+        m_ancestorsOfLastElementUnderMouse.clear();
+        for (RefPtr element = lastElementUnderMouse->parentElementInComposedTree(); element; element = element->parentElementInComposedTree())
+            m_ancestorsOfLastElementUnderMouse.append(element);
+    }
+    if (lastMouseMoveEventSubframe && lastMouseMoveEventSubframe->tree().isDescendantOf(frame.ptr()))
+        m_lastMouseMoveEventSubframe = lastMouseMoveEventSubframe;
+}
