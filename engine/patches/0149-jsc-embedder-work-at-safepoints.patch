@@ -83,6 +83,27 @@ WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN
 
 namespace JSC { namespace LLInt {
 
+#if OS(EMSCRIPTEN)
+// browser-lite: work of the embedder at the safepoints of the interpreter and of compiled code
+// (op_check_traps and the function entry, where the safepoint GC runs): every value of the
+// running script is in the JS stack and the stack pointer of the C loop is below its frames, so
+// the embedder may run other script there and the paused one goes on afterwards
+// (engine/src/EngineLoop.cpp). NeedSafepointGC brings a script to its next safepoint. Set at run
+// time, so no header changes.
+static void (*s_safepointWork)(VM&);
+extern "C" void bl_jsc_set_safepoint_work(void (*)(VM&));
+extern "C" void bl_jsc_set_safepoint_work(void (*work)(VM&))
+{
+    s_safepointWork = work;
+}
+
+static void runSafepointWork(VM& vm)
+{
+    if (s_safepointWork)
+        s_safepointWork(vm);
+}
+#endif
+
 #define LLINT_BEGIN_NO_SET_PC() \
     CodeBlock* codeBlock = callFrame->codeBlock(); \
     JSGlobalObject* globalObject = codeBlock->globalObject(); \
@@ -566,11 +587,11 @@ UGPRPair SYSV_ABI llint_check_stack_and_vm_traps(CallFrame* callFrame, const JSI
     // A trap sets the stack limit so that the next function entry
