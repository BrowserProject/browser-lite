@@ -2403,6 +2434,8 @@ LLINT_SLOW_PATH_DECL(slow_path_handle_traps)
     // Instruction boundary in the interpreter: all values are in the JSC JS stack
     if (vm.traps().hasTrapBit(VMTraps::NeedSafepointGC)) {
