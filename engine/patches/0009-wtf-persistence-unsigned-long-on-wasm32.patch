diff --git a/Source/WTF/wtf/persistence/PersistentDecoder.h b/Source/WTF/wtf/persistence/PersistentDecoder.h
index 7d1d351839..b1128d4c1c 100644
--- a/Source/WTF/wtf/persistence/PersistentDecoder.h
+++ b/Source/WTF/wtf/persistence/PersistentDecoder.h
@@ -59,6 +59,17 @@ public:
     WTF_EXPORT_PRIVATE Decoder& operator>>(std::optional<int64_t>&);
     WTF_EXPORT_PRIVATE Decoder& operator>>(std::optional<float>&);
     WTF_EXPORT_PRIVATE Decoder& operator>>(std::optional<double>&);
+#if OS(EMSCRIPTEN)
+    // wasm32: size_t is "unsigned long" (see PersistentEncoder.h)
+    Decoder& operator>>(std::optional<unsigned long>& result)
+    {
+        std::optional<uint64_t> value;
+        *this >> value;
+        if (value && *value <= std::numeric_limits<unsigned long>::max())
+            result = static_cast<unsigned long>(*value);
+        return *this;
+    }
+#endif
 
     template<typename T>
         requires (!std::is_arithmetic_v<typename std::remove_const<T>> && !std::is_enum_v<T>)
diff --git a/Source/WTF/wtf/persistence/PersistentEncoder.h b/Source/WTF/wtf/persistence/PersistentEncoder.h
index de339625f9..8cb5d49667 100644
--- a/Source/WTF/wtf/persistence/PersistentEncoder.h
+++ b/Source/WTF/wtf/persistence/PersistentEncoder.h
@@ -71,6 +71,10 @@ public:
     WTF_EXPORT_PRIVATE Encoder& operator<<(int64_t);
     WTF_EXPORT_PRIVATE Encoder& operator<<(float);
     WTF_EXPORT_PRIVATE Encoder& operator<<(double);
+#if OS(EMSCRIPTEN)
+    // wasm32: size_t is "unsigned long", neither uint32_t nor uint64_t. Store it as 64 bit.
+    Encoder& operator<<(unsigned long value) { return *this << static_cast<uint64_t>(value); }
+#endif
 
     // FIXME: Port call sites to span() and remove.
     const uint8_t* buffer() const LIFETIME_BOUND { return m_buffer.span().data(); }
