+// The GPU the host context runs on as the host browser tells it to pages
+// (WEBGL_debug_renderer_info, already masked by the host where it masks it),
+// else its plain VENDOR and RENDERER
+EM_JS(char*, blHostGPUString, (int renderer), {
+    var gl = GLctx;
+    var info = gl.getExtension("WEBGL_debug_renderer_info");
+    var value = info ? gl.getParameter(renderer ? info.UNMASKED_RENDERER_WEBGL : info.UNMASKED_VENDOR_WEBGL)
