+#if PLATFORM(WASM)
+// browser-lite: without an inspector the console messages of a service worker reached nobody; the
+// connection hands them to the host (engine/src/ServiceWorkerWasm.cpp)
+static void reportServiceWorkerConsoleMessage(WorkerGlobalScope& scope, const Inspector::ConsoleMessage& message)
+{
+    RefPtr serviceWorker = dynamicDowncast<ServiceWorkerGlobalScope>(scope);
+    if (!serviceWorker)
+        return;
+    callOnMainThread([identifier = serviceWorker->thread()->identifier(), source = message.source(), level = message.level(), text = message.message().isolatedCopy()] {
+        if (RefPtr connection = SWContextManager::singleton().connection())
+            connection->reportConsoleMessage(identifier, source, level, text, 0);
+    });
+}
+#endif
