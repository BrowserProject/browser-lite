diff --git a/Source/JavaScriptCore/llint/LLIntWasmJIT.h b/Source/JavaScriptCore/llint/LLIntWasmJIT.h
index b57f38d780..8803342ca7 100644
--- a/Source/JavaScriptCore/llint/LLIntWasmJIT.h
+++ b/Source/JavaScriptCore/llint/LLIntWasmJIT.h
@@ -32,6 +32,14 @@ void wasmJITLoop(CallFrame*, CodeBlock*, const JSInstruction* pc);
 // at a safepoint looks through them (Heap::collectAtSafepoint).
 unsigned wasmJITGenericEntries();
 
+// Counts one such entry while it lasts: the generic calls of compiled code, and a bound function's
+// call of its JS target (JSBoundFunction.cpp), whose host function holds the bound function in its
+// own frame and the arguments in a MarkedArgumentBuffer.
+struct GenericEntry {
+    GenericEntry();
+    ~GenericEntry();
+};
+
 // The CodeBlock goes away (~CodeBlock): its compiled code too.
 void wasmJITForget(CodeBlock*);
 
