+#pragma once
+
+#include <wtf/Vector.h>
+#include <wtf/text/WTFString.h>
+
+// browser-lite: the network fingerprint of Safari 26 (TLS ClientHello and HTTP
+// request headers), so that bot managers that compare it with the user agent
+// treat the engine like Safari. The HTTP/2 settings are in the curl patch
+// deps/patches/curl/0002-safari-h2-settings.patch. Measured with tls.peet.ws
+// and a header logging server, see docs/architecture.md (Network).
+
+namespace WebCore {
+class ResourceRequest;
+}
+
+namespace WebCore::NetworkFingerprint {
+
+// Safari's TLS 1.2 suites, but ChaCha20 first: WebAssembly has no AES
+// instructions and ChaCha20 is several times faster in software
+inline constexpr auto tls12Ciphers =
+    "ECDHE-ECDSA-CHACHA20-POLY1305:"
+    "ECDHE-RSA-CHACHA20-POLY1305:"
+    "ECDHE-ECDSA-AES256-GCM-SHA384:"
+    "ECDHE-ECDSA-AES128-GCM-SHA256:"
+    "ECDHE-RSA-AES256-GCM-SHA384:"
+    "ECDHE-RSA-AES128-GCM-SHA256:"
+    "ECDHE-ECDSA-AES256-SHA:"
+    "ECDHE-ECDSA-AES128-SHA:"
+    "ECDHE-RSA-AES256-SHA:"
+    "ECDHE-RSA-AES128-SHA:"
+    "AES256-GCM-SHA384:"
+    "AES128-GCM-SHA256:"
+    "AES256-SHA:"
+    "AES128-SHA:"
+    "ECDHE-ECDSA-DES-CBC3-SHA:"
+    "ECDHE-RSA-DES-CBC3-SHA:"
+    "DES-CBC3-SHA";
+
+// Safari's TLS 1.3 suites, ChaCha20 first as above
+inline constexpr auto tls13Ciphers = "TLS_CHACHA20_POLY1305_SHA256:TLS_AES_256_GCM_SHA384:TLS_AES_128_GCM_SHA256";
+
+// Groups, '*' = key share in the ClientHello (hybrid post-quantum and X25519 like Safari)
+inline constexpr auto groups = "*X25519MLKEM768:*X25519:P-256:P-384:P-521";
+
+// The TLS settings OpenSSL only offers on the SSL_CTX: signature algorithms,
+// OCSP and SCT requests, certificate compression, no encrypt-then-MAC and no
+// post-handshake authentication (curl's ssl ctx callback, argument SSL_CTX*)
+void configureSSLContext(void* sslContext);
+
+// Request header for curl; a null value removes a header curl would add itself
+struct RequestHeader {
+    String name;
+    String value;
+};
+
+// The request headers in Safari's order, with its Accept-Language, Priority,
+// Accept-Encoding and Connection, and the body length of requests with a body
+Vector<RequestHeader> requestHeaders(const ResourceRequest&, unsigned long long bodySize);
+
+} // namespace WebCore::NetworkFingerprint
