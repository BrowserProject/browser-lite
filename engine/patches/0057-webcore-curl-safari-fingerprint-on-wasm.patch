+
+#include "config.h"
+#include "NetworkFingerprintWasm.h"
+
+#include "HTTPHeaderNames.h"
+#include "ResourceRequest.h"
+#include <algorithm>
+#include <mutex>
+#include <openssl/evp.h>
+#include <openssl/ssl.h>
+#include <span>
+#include <wtf/Language.h>
+#include <wtf/text/StringBuilder.h>
+
+namespace WebCore::NetworkFingerprint {
+
+using SecurityCallback = int (*)(const SSL*, const SSL_CTX*, int, int, int, void*, void*);
+static SecurityCallback opensslSecurityCallback;
+
+// Safari offers rsa_pkcs1_sha1, OpenSSL leaves SHA-1 out of the offer from
+// security level 1 on. It is offered, but a server signature with it is still
+// refused (SSL_SECOP_SIGALG_CHECK goes to OpenSSL's callback).
+static int securityCallback(const SSL* ssl, const SSL_CTX* context, int operation, int bits, int nid, void* other, void* extra)
+{
+    if (operation == SSL_SECOP_SIGALG_SUPPORTED && nid == NID_sha1)
+        return 1;
+    return opensslSecurityCallback(ssl, context, operation, bits, nid, other, extra);
+}
+
+void configureSSLContext(void* sslContext)
+{
+    auto* context = static_cast<SSL_CTX*>(sslContext);
+
+    // Safari's order including its duplicate rsa_pss_rsae_sha384, which only the
+    // NID form keeps (the string form drops duplicates)
+    static constexpr int signatureAlgorithms[] = {
+        NID_sha256, EVP_PKEY_EC,
+        NID_sha256, EVP_PKEY_RSA_PSS,
+        NID_sha256, EVP_PKEY_RSA,
+        NID_sha384, EVP_PKEY_EC,
+        NID_sha384, EVP_PKEY_RSA_PSS,
+        NID_sha384, EVP_PKEY_RSA_PSS,
+        NID_sha384, EVP_PKEY_RSA,
+        NID_sha512, EVP_PKEY_RSA_PSS,
+        NID_sha512, EVP_PKEY_RSA,
+        NID_sha1, EVP_PKEY_RSA,
+    };
+    SSL_CTX_set1_sigalgs(context, signatureAlgorithms, std::size(signatureAlgorithms));
+    static std::once_flag once;
+    std::call_once(once, [context] {
+        opensslSecurityCallback = SSL_CTX_get_security_callback(context);
+    });
+    SSL_CTX_set_security_callback(context, securityCallback);
+
+    SSL_CTX_set_options(context, SSL_OP_NO_ENCRYPT_THEN_MAC);
+    SSL_CTX_set_post_handshake_auth(context, 0);
+
+    // status_request and signed_certificate_timestamp; the SCTs are accepted
+    // as they are, like without the extension
+    SSL_CTX_set_tlsext_status_type(context, TLSEXT_STATUSTYPE_ocsp);
+    SSL_CTX_enable_ct(context, SSL_CT_VALIDATION_PERMISSIVE);
+
+    int certificateCompression[] = { TLSEXT_comp_cert_zlib };
+    SSL_CTX_set1_cert_comp_preference(context, certificateCompression, std::size(certificateCompression));
+}
+
+// Safari: "en-US,en;q=0.9", every language followed by its base language, with
+// falling quality
+static String acceptLanguage()
+{
+    Vector<String> languages;
+    auto add = [&](const String& language) {
+        if (!language.isEmpty() && !languages.containsIf([&](auto& item) { return equalIgnoringASCIICase(item, language); }))
+            languages.append(language);
+    };
+    for (auto& language : userPreferredLanguages()) {
+        add(language);
+        if (auto dash = language.find('-'); dash != notFound)
+            add(language.left(dash));
+    }
+
+    StringBuilder builder;
+    for (size_t i = 0; i < languages.size(); ++i) {
+        if (i)
+            builder.append(',');
+        builder.append(languages[i]);
+        if (i)
+            builder.append(";q=0."_s, std::max<int>(10 - static_cast<int>(i), 1));
+    }
+    return builder.toString();
+}
+
+// Safari maps the load priority to an urgency (RFC 9218), always incremental
+static ASCIILiteral urgency(ResourceLoadPriority priority)
+{
+    switch (priority) {
+    case ResourceLoadPriority::VeryHigh:
+        return "u=0, i"_s;
+    case ResourceLoadPriority::High:
+        return "u=1, i"_s;
+    case ResourceLoadPriority::Medium:
+        return "u=3, i"_s;
+    case ResourceLoadPriority::Low:
+        return "u=5, i"_s;
+    case ResourceLoadPriority::VeryLow:
+        return "u=7, i"_s;
+    }
+    return "u=3, i"_s;
+}
+
+// Safari's order of the headers WebKit sets. It comes from a hash table and
+// depends on its size: one order up to 6 headers (requests without a body),
+// another one from 7 on (with a body or an Origin). Other headers follow.
+static constexpr HTTPHeaderName shortOrder[] = {
+    HTTPHeaderName::SecFetchDest,
+    HTTPHeaderName::UserAgent,
+    HTTPHeaderName::Accept,
+    HTTPHeaderName::Referer,
+    HTTPHeaderName::SecFetchSite,
+    HTTPHeaderName::SecFetchMode,
+};
+static constexpr HTTPHeaderName longOrder[] = {
+    HTTPHeaderName::Accept,
+    HTTPHeaderName::ContentType,
+    HTTPHeaderName::Origin,
+    HTTPHeaderName::SecFetchSite,
+    HTTPHeaderName::SecFetchMode,
+    HTTPHeaderName::UserAgent,
+    HTTPHeaderName::Referer,
+    HTTPHeaderName::SecFetchDest,
+    HTTPHeaderName::ContentLength,
+};
+
+Vector<RequestHeader> requestHeaders(const ResourceRequest& request, unsigned long long bodySize)
+{
+    struct Entry {
+        std::optional<HTTPHeaderName> name;
+        RequestHeader header;
+    };
+    Vector<Entry> leading;
+    // Set by the page or the engine: kept, but at Safari's place
+    String acceptLanguageValue;
+    String acceptEncodingValue;
+    String priorityValue;
+    String cookieValue;
+    for (auto& field : request.httpHeaderFields()) {
+        if (field.keyAsHTTPHeaderName == HTTPHeaderName::AcceptLanguage)
+            acceptLanguageValue = field.value;
+        else if (field.keyAsHTTPHeaderName == HTTPHeaderName::AcceptEncoding)
+            acceptEncodingValue = field.value;
+        else if (field.keyAsHTTPHeaderName == HTTPHeaderName::Cookie)
+            cookieValue = field.value;
+        else if (!field.keyAsHTTPHeaderName && equalLettersIgnoringASCIICase(field.key, "priority"_s))
+            priorityValue = field.value;
+        else
+            leading.append({ field.keyAsHTTPHeaderName, { field.key, field.value } });
+    }
+
+    // curl sends a body for every method but GET and HEAD (CurlRequest::setupTransfer)
+    auto& method = request.httpMethod();
+    bool hasBody = method != "GET"_s && method != "HEAD"_s;
+    if (hasBody && !request.hasHTTPHeaderField(HTTPHeaderName::ContentLength))
+        leading.append({ HTTPHeaderName::ContentLength, { "Content-Length"_s, String::number(bodySize) } });
+
+    std::span<const HTTPHeaderName> order = longOrder;
+    if (leading.size() <= std::size(shortOrder))
+        order = shortOrder;
+    auto rank = [&](const Entry& entry) {
+        auto position = entry.name ? std::ranges::find(order, *entry.name) : order.end();
+        return static_cast<size_t>(position - order.begin());
+    };
+    std::ranges::stable_sort(leading, { }, rank);
+
+    Vector<RequestHeader> headers;
+    headers.reserveInitialCapacity(leading.size() + 6);
+    for (auto& entry : leading)
+        headers.append(WTF::move(entry.header));
+    headers.append({ "Accept-Language"_s, acceptLanguageValue.isNull() ? acceptLanguage() : acceptLanguageValue });
+    headers.append({ "Priority"_s, priorityValue.isNull() ? String { urgency(request.priority()) } : priorityValue });
+    headers.append({ "Accept-Encoding"_s, acceptEncodingValue.isNull() ? String { "gzip, deflate, br, zstd"_s } : acceptEncodingValue });
+    if (!cookieValue.isNull())
+        headers.append({ "Cookie"_s, cookieValue });
+    // Only on HTTP/1.1, curl leaves it out on HTTP/2
+    headers.append({ "Connection"_s, "keep-alive"_s });
+    // Without it curl adds Content-Type: application/x-www-form-urlencoded
+    if (hasBody && !request.hasHTTPHeaderField(HTTPHeaderName::ContentType))
+        headers.append({ "Content-Type"_s, String { } });
+    return headers;
+}
+
+} // namespace WebCore::NetworkFingerprint
