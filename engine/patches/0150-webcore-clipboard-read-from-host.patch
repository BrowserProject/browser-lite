+        clipboard->m_activeSession = std::nullopt;
+        protect(document->eventLoop())->queueTask(TaskSource::Clipboard, [promise = WTF::move(promise)] mutable {
+            promise->reject(ExceptionCode::NotAllowedError);
+        });
+    });
