+#if PLATFORM(WASM)
+// browser-lite: the fonts of the cascade keep the system fallback for a cluster alive, like the one
+// for a character (FontCascadeFonts::glyphDataForSystemFallback). Their shaped text cache points
+// to it, and a FontCache purge deletes a font that only the FontCache holds. The purge clears the
+// shaped text only of the fonts in the FontCascadeCache, fonts that left it stay in use
+// (SVGTextMetricsBuilder invalidates it), so their next paint of that text would read a deleted
+// font.
+static RefPtr<const Font> keepSystemFallbackAlive(FontCascadeFonts* fonts, Ref<Font>&& font)
+{
+    Ref<const Font> result = font.copyRef();
+    if (fonts)
+        fonts->addSystemFallbackFont(WTF::move(font));
+    return result;
+}
+#endif
