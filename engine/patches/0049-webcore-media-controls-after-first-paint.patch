+DocumentMediaElement* DocumentMediaElement::fromIfExists(Document& document)
+{
+    return downcast<DocumentMediaElement>(Supplement<Document>::from(&document, supplementName()));
+}
+
+void DocumentMediaElement::createControlsAfterPaint(HTMLMediaElement& element)
+{
+    m_controlsAfterPaint.append(element);
+    if (RefPtr page = document().page())
+        page->scheduleRenderingUpdate(RenderingUpdateStep::LayerFlush);
+}
+
+void DocumentMediaElement::didUpdateRendering()
+{
+    if (m_controlsAfterPaint.isEmpty())
+        return;
+    RefPtr view = document().view();
+    if (!view || !view->hasEverPainted())
+        return;
+    for (auto& weakElement : std::exchange(m_controlsAfterPaint, { })) {
+        if (RefPtr element = weakElement.get())
+            element->createMediaControlsSoon();
+    }
+}
