+#if OS(EMSCRIPTEN)
+WorkerDedicatedRunLoop::HostLoop::HostLoop(WorkerDedicatedRunLoop& runLoop, WorkerOrWorkletGlobalScope& context, Function<void()>&& done)
+    : setup(std::make_unique<RunLoopSetup>(runLoop, RunLoopSetup::IsForDebugging::No))
+    , context(&context)
+    , done(WTF::move(done))
+{
+}
+
+WorkerDedicatedRunLoop::HostLoop::~HostLoop() = default;
+
+static thread_local WorkerDedicatedRunLoop* hostDrivenRunLoop;
+
+void WorkerDedicatedRunLoop::runFromHost(WorkerOrWorkletGlobalScope& context, Function<void()>&& done)
+{
+    m_hostLoop = makeUnique<HostLoop>(*this, context, WTF::move(done));
+    hostDrivenRunLoop = this;
+    m_hostThread = pthread_self();
+    // Der Thread endet mit stopFromHost, nicht mit seiner Startfunktion
+    emscripten_runtime_keepalive_push();
+    RunLoop::setWakeUpCallback([this] {
+        scheduleHostPump();
+    });
+    // Wie beim Warten in runInMode: ohne Zugriff auf den Heap, solange nichts laeuft
+    if (CheckedPtr script = context.script())
+        script->releaseHeapAccess();
+    m_hostDriven = true;
+    pumpFromHost();
+}
+
+// Von jedem Thread
+void WorkerDedicatedRunLoop::scheduleHostPump()
+{
+    if (!m_hostDriven || m_hostPumpScheduled.exchange(true))
+        return;
+    if (!emscripten_proxy_async(emscripten_proxy_get_system_queue(), m_hostThread, hostPump, nullptr))
+        m_hostPumpScheduled = false;
+}
+
+// Ueber den Thread, nicht ueber "this": ein Aufruf kann nach dem Ende ankommen
+void WorkerDedicatedRunLoop::hostPump(void*)
+{
+    if (auto* runLoop = hostDrivenRunLoop)
+        runLoop->pumpFromHost();
+}
+
+void WorkerDedicatedRunLoop::hostTimerFired(void*)
+{
+    if (auto* runLoop = hostDrivenRunLoop) {
+        runLoop->m_hostLoop->timer = 0;
+        runLoop->pumpFromHost();
+    }
+}
+
+void WorkerDedicatedRunLoop::pumpFromHost()
+{
+    m_hostPumpScheduled = false;
+    bool terminated = false;
+    {
+        RefPtr context = m_hostLoop->context;
+        CheckedPtr script = context->script();
+        if (script)
+            script->acquireHeapAccess();
+        ModePredicate predicate(defaultMode(), false);
+        auto start = MonotonicTime::now();
+        while (true) {
+            {
+                JSC::JSLockHolder lock(context->vm());
+                JSC::DeferGC deferGC(context->vm());
+                RunLoop::cycle();
+            }
+            bool timerDue = m_sharedTimer->isActive() && m_sharedTimer->fireTimeDelay() <= 0_s;
+            if (m_messageQueue.isEmpty() && !m_messageQueue.killed() && !timerDue)
+                break;
+            if (runInMode(context.get(), predicate).messageQueueResult == MessageQueueTerminated) {
+                terminated = true;
+                break;
+            }
+            // Auch bei Dauerarbeit kommt der Event-Loop regelmaessig dran
+            if (MonotonicTime::now() - start > 50_ms) {
+                scheduleHostPump();
+                break;
+            }
+        }
+        if (script && !terminated)
+            script->releaseHeapAccess();
+    }
+    if (terminated)
+        stopFromHost();
+    else
+        armHostTimer();
+}
+
+void WorkerDedicatedRunLoop::armHostTimer()
+{
+    auto& host = *m_hostLoop;
+    auto next = RunLoop::nextTimerFireTime();
+    if (m_sharedTimer->isActive()) {
+        auto sharedTimer = MonotonicTime::now() + m_sharedTimer->fireTimeDelay();
+        next = next ? std::min(*next, sharedTimer) : sharedTimer;
+    }
+    if (host.timer && (!next || *next < host.timerDeadline)) {
+        emscripten_clear_timeout(host.timer);
+        host.timer = 0;
+    }
+    if (!next || host.timer)
+        return;
+    host.timerDeadline = *next;
+    host.timer = emscripten_set_timeout(hostTimerFired, std::max(0.0, (*next - MonotonicTime::now()).milliseconds()), nullptr);
+}
+
+void WorkerDedicatedRunLoop::stopFromHost()
+{
+    auto host = std::exchange(m_hostLoop, nullptr);
+    m_hostDriven = false;
+    hostDrivenRunLoop = nullptr;
+    if (host->timer)
+        emscripten_clear_timeout(host->timer);
+    RunLoop::setWakeUpCallback({ });
+    runCleanupTasks(host->context.get());
+    auto done = WTF::move(host->done);
+    host = nullptr;
+    // Danach kann "this" schon abgebaut sein
+    done();
+    emscripten_runtime_keepalive_pop();
+}
