+// Loads the script of a paint worklet like a module (CORS, MIME type) and hands it
+// to the worklet for evaluation. The worklet environment runs on the main thread, it has
+// no event loop: so the script is evaluated as a classic script.
+class PaintWorkletModuleLoader final : public RefCounted<PaintWorkletModuleLoader>, private WorkerScriptLoaderClient {
+public:
+    static Ref<PaintWorkletModuleLoader> create(PaintWorklet& worklet, URL&& url)
+    {
+        return adoptRef(*new PaintWorkletModuleLoader(worklet, WTF::move(url)));
+    }
+
+    void ref() const final { RefCounted::ref(); }
+    void deref() const final { RefCounted::deref(); }
+
+    const URL& url() const LIFETIME_BOUND { return m_url; }
+    const WorkerScriptLoader& scriptLoader() const LIFETIME_BOUND { return m_scriptLoader; }
+
+    void addPromise(DOMPromiseDeferred<void>&& promise) { m_promises.append(WTF::move(promise)); }
+    Vector<DOMPromiseDeferred<void>> takePromises() { return std::exchange(m_promises, { }); }
+
+    void load(Document& document, FetchRequestCredentials credentials)
+    {
+        FetchOptions options;
+        options.mode = FetchOptions::Mode::Cors;
+        options.credentials = credentials;
+        options.destination = FetchOptions::Destination::Paintworklet;
+        m_scriptLoader->loadAsynchronously(document, ResourceRequest { URL { m_url } }, WorkerScriptLoader::Source::ModuleScript, WTF::move(options),
+            ContentSecurityPolicyEnforcement::EnforceScriptSrcDirective, ServiceWorkersMode::All, *this, WorkerRunLoop::defaultMode());
+    }
+
+    void cancel() { m_scriptLoader->cancel(); }
+
+private:
+    PaintWorkletModuleLoader(PaintWorklet& worklet, URL&& url)
+        : m_worklet(worklet)
+        , m_scriptLoader(WorkerScriptLoader::create())
+        , m_url(WTF::move(url))
+    {
+    }
+
+    void didReceiveResponse(ScriptExecutionContextIdentifier, std::optional<ResourceLoaderIdentifier>, const ResourceResponse&) final { }
+
+    void notifyFinished(std::optional<ScriptExecutionContextIdentifier>) final
+    {
+        m_worklet->didLoadModule(*this);
+    }
+
+    const Ref<PaintWorklet> m_worklet;
+    const Ref<WorkerScriptLoader> m_scriptLoader;
+    const URL m_url;
+    Vector<DOMPromiseDeferred<void>> m_promises;
+};
+
+PaintWorklet::PaintWorklet(Document& document)
+    : Worklet(document)
+{
+}
+
+PaintWorklet::~PaintWorklet() = default;
+
+void PaintWorklet::addModule(const String& moduleURL, WorkletOptions&& options, DOMPromiseDeferred<void>&& promise)
+{
+    RefPtr document = this->document();
+    if (!document || !document->hasBrowsingContext()) {
+        promise.reject(Exception { ExceptionCode::InvalidStateError, "This frame is detached"_s });
+        return;
+    }
+
+    URL url = document->encodingParseURL(moduleURL);
+    if (!url.isValid()) {
+        promise.reject(Exception { ExceptionCode::SyntaxError, "Module URL is invalid"_s });
+        return;
+    }
+
+    // The loader checks redirects (EnforceScriptSrcDirective)
+    if (!protect(document->contentSecurityPolicy())->allowScriptFromSource(url, document->currentParserSourcePosition())) {
+        promise.reject(Exception { ExceptionCode::SecurityError, "Not allowed by CSP"_s });
+        return;
+    }
+
+    // Like the module map of the specification: load and evaluate each URL only once
+    if (m_loadedModules.contains(url)) {
+        promise.resolve();
+        return;
+    }
+    if (RefPtr loader = m_moduleLoaders.get(url)) {
+        loader->addPromise(WTF::move(promise));
+        return;
+    }
+
+    Ref loader = PaintWorkletModuleLoader::create(*this, WTF::move(url));
+    loader->addPromise(WTF::move(promise));
+    m_moduleLoaders.add(loader->url(), loader);
+    loader->load(*document, options.credentials);
+}
+
+void PaintWorklet::didLoadModule(PaintWorkletModuleLoader& loader)
+{
+    Ref protectedLoader { loader };
+    m_moduleLoaders.remove(loader.url());
+
+    auto result = evaluateModule(loader.scriptLoader());
+    if (!result.hasException())
+        m_loadedModules.add(loader.url());
+    for (auto& promise : loader.takePromises()) {
+        if (result.hasException())
+            promise.reject(Exception { result.exception() });
+        else
+            promise.resolve();
+    }
+}
+
+ExceptionOr<void> PaintWorklet::evaluateModule(const WorkerScriptLoader& scriptLoader)
+{
+    RefPtr document = this->document();
+    if (!document || !document->hasBrowsingContext())
+        return Exception { ExceptionCode::InvalidStateError, "This frame is detached"_s };
+
+    // As with modules: only with a JavaScript MIME type
+    if (scriptLoader.failed() || !MIMETypeRegistry::isSupportedJavaScriptMIMEType(scriptLoader.responseMIMEType()))
+        return Exception { ExceptionCode::AbortError, "Unable to load a worklet's module"_s };
+
+    // Paint worklets have no sensitive APIs, the origin of the source does not matter
+    auto maybeContext = PaintWorkletGlobalScope::tryCreate(*document, ScriptSourceCode(scriptLoader.script().toString(), JSC::SourceTaintedOrigin::Untainted, URL { scriptLoader.responseURL() }));
+    if (!maybeContext) [[unlikely]]
+        return Exception { ExceptionCode::OutOfMemoryError };
+    Ref context = maybeContext.releaseNonNull();
+    String exceptionMessage;
+    context->evaluate(&exceptionMessage);
+
+    // Each module has its own environment. As in the shared environment of the
+    // specification, a name is registered only once, the first registration stays.
+    bool registered = false;
+    if (exceptionMessage.isNull()) {
+        Locker locker { context->paintDefinitionLock() };
+        for (auto& name : context->paintDefinitionMap().keys()) {
+            if (document->paintWorkletGlobalScopeForName(name))
+                continue;
+            document->setPaintWorkletGlobalScopeForName(name, context.copyRef());
+            registered = true;
+        }
+    }
+    if (!registered)
+        context->prepareForDestruction();
+
+    if (!exceptionMessage.isNull())
+        return Exception { ExceptionCode::AbortError, exceptionMessage };
+    return { };
+}
+
+void PaintWorklet::stop()
+{
+    auto loaders = std::exchange(m_moduleLoaders, { });
+    for (Ref loader : loaders.values())
+        loader->cancel();
+}
