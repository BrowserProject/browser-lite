+
+#include "config.h"
+#include "AudioFileReader.h"
+
+#if ENABLE(WEB_AUDIO)
+
+#include "AudioBus.h"
+#include <emscripten/emscripten.h>
+#include <emscripten/proxying.h>
+#include <emscripten/threading.h>
+#include <wtf/FileSystem.h>
+#include <wtf/text/MakeString.h>
+
+// decodeAudioData ueber den Dekoder des Host-Browsers (kann MP3, AAC, Opus,
+// Vorbis, FLAC, WAV, ...). Der Aufruf kommt auf einem Hintergrund-Thread der
+// Engine (AsyncAudioDecoder) und wartet, bis der Haupt-Thread fertig ist.
+
+namespace WebCore {
+
+namespace {
+
+struct DecodeRequest {
+    std::span<const uint8_t> data;
+    float sampleRate { 0 };
+    em_proxying_ctx* context { nullptr };
+    float* channelData { nullptr };
+    unsigned numberOfChannels { 0 };
+    size_t length { 0 };
+    float resultSampleRate { 0 };
+};
+
+void startDecodeOnMainThread(em_proxying_ctx* context, void* argument)
+{
+    auto* request = static_cast<DecodeRequest*>(argument);
+    request->context = context;
+    EM_ASM({
+        var request = $0;
+        var debug = Module.ENV && Module.ENV.BL_DEBUG && Module.ENV.BL_DEBUG !== '0';
+        if (debug)
+            console.log('[audio] dekodieren: ' + $2 + ' Bytes, Rate ' + $3);
+        var bytes = HEAPU8.slice($1, $1 + $2);
+        var done = function(buffer) {
+            if (debug)
+                console.log('[audio] dekodiert: ' + (buffer ? buffer.length + ' Frames' : 'Fehler'));
+            if (!buffer) {
+                _bl__audio_decoded(request, 0, 0, 0, 0);
+                return;
+            }
+            var channels = buffer.numberOfChannels;
+            var length = buffer.length;
+            var ptr = _malloc(channels * length * 4);
+            if (!ptr) {
+                _bl__audio_decoded(request, 0, 0, 0, 0);
+                return;
+            }
+            for (var c = 0; c < channels; c++)
+                HEAPF32.set(buffer.getChannelData(c), (ptr >> 2) + c * length);
+            _bl__audio_decoded(request, ptr, channels, length, buffer.sampleRate);
+        };
+        try {
+            // decodeAudioData rechnet auf die Rate des Kontexts um
+            var context = new OfflineAudioContext(1, 1, $3 || 48000);
+            context.decodeAudioData(bytes.buffer).then(done, function() { done(null); });
+        } catch (e) {
+            done(null);
+        }
+    }, request, request->data.data(), request->data.size(), request->sampleRate);
+}
+
+} // namespace
+
+extern "C" EMSCRIPTEN_KEEPALIVE void bl__audio_decoded(DecodeRequest* request, float* channelData, unsigned numberOfChannels, unsigned length, float sampleRate)
+{
+    request->channelData = channelData;
+    request->numberOfChannels = numberOfChannels;
+    request->length = length;
+    request->resultSampleRate = sampleRate;
+    emscripten_proxy_finish(request->context);
+}
+
+RefPtr<AudioBus> createBusFromInMemoryAudioFile(std::span<const uint8_t> data, bool mixToMono, float sampleRate)
+{
+    if (data.empty() || emscripten_is_main_runtime_thread())
+        return nullptr;
+
+    DecodeRequest request;
+    request.data = data;
+    request.sampleRate = sampleRate;
+    if (!emscripten_proxy_sync_with_ctx(emscripten_proxy_get_system_queue(), emscripten_main_runtime_thread_id(), startDecodeOnMainThread, &request))
+        return nullptr;
+    if (!request.channelData)
+        return nullptr;
+
+    auto bus = AudioBus::create(request.numberOfChannels, request.length);
+    for (unsigned channel = 0; channel < request.numberOfChannels; ++channel)
+        memcpySpan(bus->channel(channel)->mutableSpan(), std::span<const float> { request.channelData + channel * request.length, request.length });
+    free(request.channelData);
+    bus->setSampleRate(request.resultSampleRate);
+
+    if (mixToMono && request.numberOfChannels > 1)
+        return AudioBus::createByMixingToMono(bus.get());
+    return bus;
+}
+
+// HRTF-Daten fuer PannerNode (panningModel "HRTF"), liegen in engine.data
+RefPtr<AudioBus> AudioBus::loadPlatformResource(const char* name, float sampleRate)
+{
+    auto data = FileSystem::readEntireFile(makeString("/usr/share/webkit/audio/"_s, String::fromUTF8(name), ".wav"_s));
+    if (!data)
+        return nullptr;
+    return createBusFromInMemoryAudioFile(data->span(), false, sampleRate);
+}
+
+} // namespace WebCore
+
+#endif // ENABLE(WEB_AUDIO)
