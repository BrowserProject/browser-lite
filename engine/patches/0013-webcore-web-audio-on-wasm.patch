+#include "config.h"
+#include "AudioDestinationResampler.h"
+
+#if ENABLE(WEB_AUDIO)
+
+#include "AudioBus.h"
+#include "AudioUtilities.h"
+#include "SharedAudioDestination.h"
+#include <atomic>
+#include <emscripten/emscripten.h>
+#include <unistd.h>
+#include <wtf/MainThread.h>
+#include <wtf/MonotonicTime.h>
+#include <wtf/Threading.h>
+
+// Audio-Ausgabe fuer browser-lite.
+//
+// Ein eigener Thread rendert den Web-Audio-Graphen in einen Ringpuffer im
+// gemeinsamen WASM-Speicher. Die Oberflaeche liest ihn mit einem AudioWorklet
+// im Web Audio des Host-Browsers (web/audio-worklet.js) und spielt ihn ab.
+//
+// Ringpuffer: Kopf mit laufenden Zaehlern (geschrieben/gelesen, in Frames),
+// einem Herzschlag des Worklets und danach die Samples (float, Kanaele verschachtelt).
+// Wenn niemand liest (Host-AudioContext noch gesperrt bis zum ersten Klick),
+// rendern wir trotzdem im Takt der Uhr weiter und werfen das Ergebnis weg.
+// So laeuft currentTime weiter, wie in einem normalen Browser.
+
+namespace WebCore {
+
+namespace {
+
+constexpr float outputSampleRate = 48000;
+constexpr uint32_t ringCapacityFrames = 8192; // Zweierpotenz
+// So viel wird im Voraus gerendert (ca. 64 ms bei 48 kHz)
+constexpr uint32_t targetBufferedFrames = 24 * AudioUtilities::renderQuantumSize;
+constexpr Seconds readerTimeout = 250_ms;
+
+struct RingHeader {
+    std::atomic<uint32_t> writeFrame;
+    std::atomic<uint32_t> readFrame;
+    uint32_t capacityFrames;
+    uint32_t channels;
+    // Zaehlt bei jedem process() des Worklets, auch wenn nichts im Ring ist
+    std::atomic<uint32_t> heartbeat;
+    uint32_t reserved[3];
+};
+static_assert(sizeof(RingHeader) == 32);
+
+std::atomic<int> nextDestinationId { 1 };
+
+class AudioDestinationWasm final : public AudioDestinationResampler, public ThreadSafeRefCounted<AudioDestinationWasm, WTF::DestructionThread::Main> {
+public:
+    explicit AudioDestinationWasm(const CreationOptions& options)
+        : AudioDestinationResampler(options, outputSampleRate)
+        , m_id(nextDestinationId++)
+        , m_channels(options.numberOfOutputChannels)
+    {
+        size_t bytes = sizeof(RingHeader) + sizeof(float) * ringCapacityFrames * m_channels;
+        m_ring = static_cast<uint8_t*>(calloc(1, bytes));
+        RELEASE_ASSERT(m_ring);
+        auto* header = new (m_ring) RingHeader { };
+        header->capacityFrames = ringCapacityFrames;
+        header->channels = m_channels;
+        for (unsigned i = 0; i < m_channels; ++i) {
+            Vector<float> channel;
+            channel.grow(AudioUtilities::renderQuantumSize);
+            channel.fill(0);
+            m_planar.append(WTF::move(channel));
+        }
+    }
+
+    ~AudioDestinationWasm()
+    {
+        stopThread();
+        // Der Speicher gehoert ab jetzt der Oberflaeche: das Worklet liest
+        // vielleicht noch, darum gibt sie ihn erst nach dem Abbauen frei.
+        MAIN_THREAD_ASYNC_EM_ASM({
+            if (Module.onEngineAudio)
+                Module.onEngineAudio('close', $0, $1, 0, 0, 0);
+            else
+                _free($1);
+        }, m_id, m_ring);
+    }
+
+    void ref() const final { ThreadSafeRefCounted::ref(); }
+    void deref() const final { ThreadSafeRefCounted::deref(); }
+
+private:
+    void startRendering(CompletionHandler<void(bool)>&& completionHandler) final
+    {
+        ASSERT(isMainThread());
+        if (!m_thread) {
+            m_stop = false;
+            m_thread = Thread::create("WebAudio Wasm"_s, [this] {
+                renderLoop();
+            }, ThreadType::Audio, Thread::QOS::UserInteractive);
+        }
+        MAIN_THREAD_ASYNC_EM_ASM({
+            if (Module.onEngineAudio)
+                Module.onEngineAudio('start', $0, $1, $2, $3, $4);
+        }, m_id, m_ring, ringCapacityFrames, m_channels, outputSampleRate);
+        setIsPlaying(true);
+        callOnMainThread([completionHandler = WTF::move(completionHandler)]() mutable {
+            completionHandler(true);
+        });
+    }
+
+    void stopRendering(CompletionHandler<void(bool)>&& completionHandler) final
+    {
+        ASSERT(isMainThread());
+        stopThread();
+        MAIN_THREAD_ASYNC_EM_ASM({
+            if (Module.onEngineAudio)
+                Module.onEngineAudio('stop', $0, $1, 0, 0, 0);
+        }, m_id, m_ring);
+        setIsPlaying(false);
+        callOnMainThread([completionHandler = WTF::move(completionHandler)]() mutable {
+            completionHandler(true);
+        });
+    }
+
+    void stopThread()
+    {
+        if (!m_thread)
+            return;
+        m_stop = true;
+        m_thread->waitForCompletion();
+        m_thread = nullptr;
+    }
+
+    RingHeader& header() { return *reinterpret_cast<RingHeader*>(m_ring); }
+    float* samples() { return reinterpret_cast<float*>(m_ring + sizeof(RingHeader)); }
+
+    // Ein Render-Quantum (128 Frames) rendern, optional in den Ring schreiben
+    void renderQuantum(bool writeToRing)
+    {
+        constexpr size_t frames = AudioUtilities::renderQuantumSize;
+        for (unsigned i = 0; i < m_channels; ++i)
+            m_outputBus->setChannelMemory(i, m_planar[i].mutableSpan());
+        // Wie bei Cocoa: zuerst Fertiges aus dem FIFO holen, dann nachrendern
+        auto framesToRender = pullRendered(frames);
+        AudioDestinationResampler::render(m_framesRendered / static_cast<double>(outputSampleRate), MonotonicTime::now(), framesToRender);
+        m_framesRendered += frames;
+
+        if (!writeToRing)
+            return;
+        auto& ring = header();
+        uint32_t write = ring.writeFrame.load(std::memory_order_relaxed);
+        float* data = samples();
+        for (size_t frame = 0; frame < frames; ++frame) {
+            size_t index = ((write + frame) & (ringCapacityFrames - 1)) * m_channels;
+            for (unsigned channel = 0; channel < m_channels; ++channel)
+                data[index + channel] = m_planar[channel][frame];
+        }
+        ring.writeFrame.store(write + frames, std::memory_order_release);
+    }
+
+    void renderLoop()
+    {
+        auto& ring = header();
+        uint32_t lastHeartbeat = ring.heartbeat.load(std::memory_order_acquire);
+        auto lastReadProgress = MonotonicTime::now() - readerTimeout;
+        auto pacedSince = MonotonicTime::now();
+        double pacedFrames = 0;
+
+        while (!m_stop) {
+            auto now = MonotonicTime::now();
+            uint32_t heartbeat = ring.heartbeat.load(std::memory_order_acquire);
+            if (heartbeat != lastHeartbeat) {
+                lastHeartbeat = heartbeat;
+                lastReadProgress = now;
+            }
+
+            if (now - lastReadProgress < readerTimeout) {
+                // Die Oberflaeche spielt ab: Ring bis zum Ziel auffuellen
+                while (!m_stop) {
+                    uint32_t buffered = ring.writeFrame.load(std::memory_order_relaxed) - ring.readFrame.load(std::memory_order_acquire);
+                    if (buffered + AudioUtilities::renderQuantumSize > targetBufferedFrames)
+                        break;
+                    renderQuantum(true);
+                }
+                pacedSince = now;
+                pacedFrames = 0;
+            } else {
+                // Niemand liest: im Takt der Uhr rendern und wegwerfen
+                pacedFrames += (now - pacedSince).seconds() * outputSampleRate;
+                pacedSince = now;
+                pacedFrames = std::min<double>(pacedFrames, outputSampleRate / 5);
+                while (!m_stop && pacedFrames >= AudioUtilities::renderQuantumSize) {
+                    renderQuantum(false);
+                    pacedFrames -= AudioUtilities::renderQuantumSize;
+                }
+            }
+            usleep(4000);
+        }
+    }
+
+    const int m_id;
+    const unsigned m_channels;
+    uint8_t* m_ring { nullptr };
+    Vector<Vector<float>> m_planar;
+    RefPtr<Thread> m_thread;
+    std::atomic<bool> m_stop { false };
+    uint64_t m_framesRendered { 0 };
+};
+
+} // namespace
+
+Ref<AudioDestination> AudioDestination::create(const CreationOptions& options)
+{
+    return SharedAudioDestination::create(options, [](const CreationOptions& options) -> Ref<AudioDestination> {
+        return adoptRef(*new AudioDestinationWasm(options));
+    });
+}
+
+float AudioDestination::hardwareSampleRate()
+{
+    return outputSampleRate;
+}
+
+unsigned long AudioDestination::maxChannelCount()
+{
+    return 2;
+}
+
+} // namespace WebCore
+
+#endif // ENABLE(WEB_AUDIO)
