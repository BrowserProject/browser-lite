+
+#include "config.h"
+#include "FFTFrame.h"
+
+#if ENABLE(WEB_AUDIO)
+
+#include "VectorMath.h"
+#include <array>
+#include <complex>
+#include <numbers>
+#include <wtf/Lock.h>
+#include <wtf/NeverDestroyed.h>
+#include <wtf/Vector.h>
+
+// FFT fuer Web Audio (OscillatorNode, AnalyserNode, ConvolverNode, ...).
+// Einfache Radix-2-FFT ueber komplexe Zahlen. Das Format der Daten ist wie bei
+// der Cocoa-Variante: realData/imagData haben fftSize/2 Werte, Index 0 hat in
+// realData den Gleichanteil und in imagData den Nyquist-Wert ("packed").
+
+namespace WebCore {
+
+namespace {
+
+constexpr unsigned minFFTPow2Size = 2;
+constexpr unsigned maxFFTPow2Size = 24;
+
+using Complex = std::complex<float>;
+
+// Drehfaktoren e^(-2*pi*i*k/n) fuer k < n/2, pro Groesse einmal berechnet
+const Vector<Complex>& twiddles(unsigned log2Size)
+{
+    static Lock lock;
+    static NeverDestroyed<std::array<Vector<Complex>, maxFFTPow2Size + 1>> tables;
+    Locker locker { lock };
+    auto& table = tables.get()[log2Size];
+    if (table.isEmpty()) {
+        size_t size = size_t { 1 } << log2Size;
+        table.reserveInitialCapacity(size / 2);
+        for (size_t k = 0; k < size / 2; ++k) {
+            double angle = -2.0 * std::numbers::pi * static_cast<double>(k) / static_cast<double>(size);
+            table.append(Complex(static_cast<float>(std::cos(angle)), static_cast<float>(std::sin(angle))));
+        }
+    }
+    return table;
+}
+
+// Vorwaerts-FFT in place (fuer die inverse vorher und nachher konjugieren)
+void transform(std::span<Complex> data, unsigned log2Size)
+{
+    size_t size = data.size();
+    // Bit-Umkehr
+    for (size_t i = 1, j = 0; i < size; ++i) {
+        size_t bit = size >> 1;
+        for (; j & bit; bit >>= 1)
+            j ^= bit;
+        j ^= bit;
+        if (i < j)
+            std::swap(data[i], data[j]);
+    }
+    auto& w = twiddles(log2Size);
+    for (size_t length = 2; length <= size; length <<= 1) {
+        size_t half = length / 2;
+        size_t step = size / length;
+        for (size_t start = 0; start < size; start += length) {
+            for (size_t k = 0; k < half; ++k) {
+                Complex odd = data[start + k + half] * w[k * step];
+                Complex even = data[start + k];
+                data[start + k] = even + odd;
+                data[start + k + half] = even - odd;
+            }
+        }
+    }
+}
+
+// Arbeitsspeicher pro Thread, damit nicht jede FFT neu Speicher holt
+std::span<Complex> scratch(size_t size)
+{
+    static thread_local Vector<Complex> buffer;
+    if (buffer.size() < size)
+        buffer.grow(size);
+    return buffer.mutableSpan().first(size);
+}
+
+} // namespace
+
+FFTFrame::FFTFrame(unsigned fftSize)
+    : m_FFTSize(fftSize)
+    , m_log2FFTSize(static_cast<unsigned>(std::log2(fftSize)))
+    , m_realData(fftSize / 2)
+    , m_imagData(fftSize / 2)
+{
+}
+
+FFTFrame::FFTFrame()
+    : m_FFTSize(0)
+    , m_log2FFTSize(0)
+{
+}
+
+FFTFrame::FFTFrame(const FFTFrame& frame)
+    : m_FFTSize(frame.m_FFTSize)
+    , m_log2FFTSize(frame.m_log2FFTSize)
+    , m_realData(frame.m_FFTSize / 2)
+    , m_imagData(frame.m_FFTSize / 2)
+{
+    memcpySpan(m_realData.span(), frame.realData().span());
+    memcpySpan(m_imagData.span(), frame.imagData().span());
+}
+
+FFTFrame::~FFTFrame() = default;
+
+void FFTFrame::initialize()
+{
+}
+
+void FFTFrame::doFFT(std::span<const float> data)
+{
+    auto buffer = scratch(m_FFTSize);
+    for (size_t i = 0; i < m_FFTSize; ++i)
+        buffer[i] = Complex(i < data.size() ? data[i] : 0, 0);
+    transform(buffer, m_log2FFTSize);
+
+    unsigned half = m_FFTSize / 2;
+    auto real = m_realData.span();
+    auto imag = m_imagData.span();
+    real[0] = buffer[0].real();
+    imag[0] = buffer[half].real(); // Nyquist, wie bei Cocoa gepackt
+    for (unsigned k = 1; k < half; ++k) {
+        real[k] = buffer[k].real();
+        imag[k] = buffer[k].imag();
+    }
+}
+
+void FFTFrame::doInverseFFT(std::span<float> data)
+{
+    unsigned half = m_FFTSize / 2;
+    auto real = m_realData.span();
+    auto imag = m_imagData.span();
+    // Ganzes Spektrum aufbauen (reelles Signal: X[n-k] = conj(X[k])), konjugiert
+    auto buffer = scratch(m_FFTSize);
+    buffer[0] = Complex(real[0], 0);
+    buffer[half] = Complex(imag[0], 0);
+    for (unsigned k = 1; k < half; ++k) {
+        buffer[k] = Complex(real[k], -imag[k]);
+        buffer[m_FFTSize - k] = Complex(real[k], imag[k]);
+    }
+    transform(buffer, m_log2FFTSize);
+    // So dass x == IFFT(FFT(x))
+    float scale = 1.0f / m_FFTSize;
+    for (unsigned i = 0; i < m_FFTSize && i < data.size(); ++i)
+        data[i] = buffer[i].real() * scale;
+}
+
+int FFTFrame::minFFTSize()
+{
+    return 1 << minFFTPow2Size;
+}
+
+int FFTFrame::maxFFTSize()
+{
+    return 1 << maxFFTPow2Size;
+}
