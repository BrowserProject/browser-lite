+
+bool SkiaCompositingLayer::isAncestorOf(const SkiaCompositingLayer& layer) const
+{
+    for (auto* parent = layer.m_parent.get(); parent; parent = parent->m_parent.get()) {
+        if (parent == this)
+            return true;
+    }
+    return false;
+}
+
+// The layer itself at opacity 1 (the embedder applies the opacity), its ancestors only for their clips.
+// Other layers are not walked.
+void SkiaCompositingLayer::paintOnlyLayer(SkCanvas& canvas, PaintContext& context)
+{
+    if (context.onlyLayer == this) {
+        if (!hasVisiblePaintableContent())
+            return;
+        SetForScope scopedOpacity(context.opacity, 1.f);
+        paintWithReplica(canvas, context);
+        return;
+    }
+    if (isAncestorOf(*context.onlyLayer))
+        paintSelfAndChildren(canvas, context);
+}
+
+bool SkiaCompositingLayer::letsEmbedderShowDescendants() const
+{
+    return opacity() == 1 && m_animations.isEmpty() && !filter() && !m_mask && !m_replica && !isReplica() && !m_blendMode
+        && !m_preserves3D && !m_backdrop.filter;
+}
+
+std::optional<SkiaCompositingLayer::OpacityAnimation> SkiaCompositingLayer::opacityAnimation() const
+{
+    if (m_animations.size() != 1 || !m_animationsState || !m_animationsState->isRunning)
+        return std::nullopt;
+    auto& animation = m_animations.animations()[0];
+    if (animation.keyframes().property() != AnimatedProperty::Opacity || animation.state() != TextureMapperAnimation::State::Playing
+        || animation.duration() <= 0 || animation.runningTime() < 0_s)
+        return std::nullopt;
+    double iterations = animation.iterationCount() == GraphicsLayerAnimation::IterationCountInfinite ? std::numeric_limits<double>::infinity() : animation.iterationCount();
+    return OpacityAnimation { m_animationTime - animation.runningTime(), animation.runningTime(), Seconds(animation.duration()), iterations };
+}
+
+float SkiaCompositingLayer::opacityAt(Seconds runningTime)
+{
+    auto animation = opacityAnimation();
+    if (!animation)
+        return opacity();
+    TextureMapperAnimation::ApplicationResult result;
+    m_animations.apply(result, animation->start + runningTime, TextureMapperAnimation::KeepInternalState::Yes);
+    return result.opacity.value_or(m_opacity);
+}
 #endif
 
