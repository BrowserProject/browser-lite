+#if PLATFORM(WASM)
+// browser-lite: a layer drawn after an embedder layer over it: the embedder cannot show that one over the target
+void SkiaCompositingLayer::markOverlappedEmbedderLayers(PaintContext& context, const SkiaCompositingLayer& layer, const FloatRect& rectInFrame)
+{
+    auto* embedderLayers = context.collectState->embedderLayers;
+    if (!embedderLayers || rectInFrame.isEmpty())
+        return;
+    auto rect = enclosingIntRect(rectInFrame);
+    for (auto& embedderLayer : *embedderLayers) {
+        if (embedderLayer.layer.ptr() != &layer && embedderLayer.rect.intersects(rect))
+            embedderLayer.overlapped = true;
+    }
+}
+
+// Lists the layer if the embedder could show it (PreparedFrame::embedderLayers). true: the embedder shows
+// it, the walk leaves it out (no damage, no rect to track).
+bool SkiaCompositingLayer::collectEmbedderLayer(SkCanvas& canvas, PaintContext& context)
+{
+    auto& state = *context.collectState;
+    if (!state.embedderLayers || state.embedderLayersBlocked || !m_children.isEmpty() || m_mask || m_replica || isReplica() || m_blendMode
+        || m_preserves3D || isLeafOf3DRenderingContext() || m_backdrop.filter || filter() || m_contentsBuffer || m_debugBorder || m_repaintCount
+        || m_rect.isEmpty() || !m_visible || !m_contentsVisible || !hasVisualContent() || !opacityAnimation())
+        return false;
+    auto transform = combinedTransform(context);
+    if (!transform.isAffine() || !SkM44(transform).asM33().rectStaysRect())
+        return false;
+    auto paintedRect = transform.mapRect(paintedLayerRect());
+    auto rect = enclosingIntRect(paintedRect);
+    rect.intersect(canvas.getDeviceClipBounds());
+    if (rect.isEmpty())
+        return false;
+    // Of two embedder layers over each other, the one drawn first stays in the frame
+    for (auto& embedderLayer : *state.embedderLayers) {
+        if (embedderLayer.rect.intersects(rect))
+            embedderLayer.overlapped = true;
+    }
+    state.embedderLayers->append({ *this, rect, paintedRect, opacity(), m_drawnByEmbedder && (hasLayerDamage() || m_groupPropertyChanged), false });
+    return m_drawnByEmbedder;
 }
+#endif
 
