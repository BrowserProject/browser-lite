@@ -201,7 +204,7 @@ void updateStrings(ShimContext& context)
 
 } // namespace
 
-// Host context in the engine worker on its own OffscreenCanvas. Drawing only
+// Host context in the thread's worker on its own OffscreenCanvas. Drawing only
 // goes into framebuffers of WebKit, so no depth/stencil/antialiasing.
 //
 // Every query of the host context is a synchronous call to the GPU process,
@@ -648,9 +651,28 @@ bool makeHostCurrent(HostContext& host)
 // A replaced host context lives until the last context on it is gone
 void deleteHostIfUnused(HostContext* host)
 {
-    if (host->users || host == hosts[0] || host == hosts[1])
+    if (host->users)
         return;
-    EM_ASM({ GL.deleteContext($0); }, host->handle);
+    // The main thread keeps its host contexts for the next page
+    // (angleShimPrewarm). A worker's thread releases them with its last
+    // context: a page worker ends with its contexts, and the Web Worker of
+    // its thread runs other threads afterwards.
+    for (auto*& kept : hosts) {
+        if (kept != host)
+            continue;
+        if (isMainThread())
+            return;
+        kept = nullptr;
+    }
+    // Lost at once: the host browser frees its GPU memory without waiting
+    // for its garbage collector
+    EM_ASM({
+        var context = GL.getContext($0);
+        var extension = context && context.GLctx.getExtension("WEBGL_lose_context");
+        if (extension && !context.GLctx.isContextLost())
+            extension.loseContext();
+        GL.deleteContext($0);
+    }, host->handle);
     delete host;
 }
 
