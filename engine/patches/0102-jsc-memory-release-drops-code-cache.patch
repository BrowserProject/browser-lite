 #include "WorkerThread.h"
+#include <JavaScriptCore/CodeCacheRelease.h>
 #include <JavaScriptCore/VM.h>
 #include <wtf/ResourceUsage.h>
 #include <wtf/SystemTracing.h>
@@ -165,6 +166,10 @@ static void releaseCriticalMemory(Synchronous synchronous, MaintainBackForwardCa
             GarbageCollectionController::singleton().deleteAllCode(JSC::PreventCollectionAndDeleteAllCode);
         else
             GarbageCollectionController::singleton().deleteAllCode(JSC::DeleteAllCodeIfNotCollecting);
+    } else {
+        // browser-lite: the code of the pages stays, but not the code cache, which kept the
+        // bytecode and the sources of the scripts of every page that is gone
+        JSC::clearCodeCache(commonVM());
     }
 
