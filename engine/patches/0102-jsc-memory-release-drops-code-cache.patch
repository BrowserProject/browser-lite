diff --git a/Source/JavaScriptCore/runtime/CodeCacheRelease.h b/Source/JavaScriptCore/runtime/CodeCacheRelease.h
new file mode 100644
index 0000000000..e2a44c239d
--- /dev/null
+++ b/Source/JavaScriptCore/runtime/CodeCacheRelease.h
@@ -0,0 +1,18 @@
+/*
+ * browser-lite: lets a memory release drop the code cache of the VM (docs/architecture.md of browser-lite).
+ */
+#pragma once
+
+#include "JSExportMacros.h"
+
+namespace JSC {
+
+class VM;
+
+// Empties the cache of the bytecode of evaluated scripts (programs, modules, eval, the Function
+// constructor), which holds it and the script sources with strong references until a later add
+// prunes it, also for pages that are gone. The functions that live keep their code. Runs once no
+// JS is on the stack.
+JS_EXPORT_PRIVATE void clearCodeCache(VM&);
+
+} // namespace JSC
