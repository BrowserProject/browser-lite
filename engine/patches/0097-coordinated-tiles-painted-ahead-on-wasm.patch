+
+void SkiaPaintingEngine::PrepaintQueue::append(Function<void()>&& job)
+{
+    {
+        Locker locker { m_lock };
+        m_jobs.append(WTF::move(job));
+        if (m_running >= m_maxRunning)
+            return;
+        ++m_running;
+    }
+    m_pool->postTask([queue = Ref { *this }] {
+        queue->runNext();
+    });
+}
+
+void SkiaPaintingEngine::PrepaintQueue::runNext()
+{
+    Function<void()> job;
+    {
+        Locker locker { m_lock };
+        if (m_jobs.isEmpty()) {
+            --m_running;
+            return;
+        }
+        job = m_jobs.takeFirst();
+    }
+    job();
+    // Behind the tiles of rendering updates posted meanwhile
+    m_pool->postTask([queue = Ref { *this }] {
+        queue->runNext();
+    });
+}
