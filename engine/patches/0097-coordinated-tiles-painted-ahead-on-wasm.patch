+static constexpr Seconds s_aheadTime = 1_s;
+// A longer gap between two positions counts as this long (the view moved during it)
+static constexpr Seconds s_motionWindow = 500_ms;
+// After this long at the same place the view stands still
+static constexpr Seconds s_motionTimeout = 250_ms;
+// At most this many view heights (or widths) ahead; a farther jump between two positions is no motion
+static constexpr float s_maxAheadViews = 2.5;
+static constexpr float s_jumpViews = 8;
+
+void CoordinatedBackingStoreProxy::updateMotion(const IntRect& visibleRect)
+{
+    auto now = MonotonicTime::now();
+    if (visibleRect.isEmpty() || !m_hasLastLocation) {
+        m_hasLastLocation = !visibleRect.isEmpty();
+        m_lastLocation = visibleRect.location();
+        m_lastMoveTime = now;
+        m_velocity = { };
+        m_aheadRect = { };
+        m_lastAheadRect = { };
+        m_lastVelocity = { };
+        return;
+    }
+
+    auto delta = visibleRect.location() - m_lastLocation;
+    if (delta.isZero()) {
+        if (now - m_lastMoveTime > s_motionTimeout)
+            m_velocity = { };
+    } else {
+        auto elapsed = std::clamp(now - m_lastMoveTime, 4_ms, s_motionWindow);
+        bool jump = std::abs(delta.width()) > s_jumpViews * visibleRect.width() || std::abs(delta.height()) > s_jumpViews * visibleRect.height();
+        m_velocity = jump ? FloatSize { } : FloatSize { static_cast<float>(delta.width() / elapsed.seconds()), static_cast<float>(delta.height() / elapsed.seconds()) };
+        if (jump) {
+            m_lastAheadRect = { };
+            m_lastVelocity = { };
+        }
+        m_lastLocation = visibleRect.location();
+        m_lastMoveTime = now;
+    }
+
+    if (m_velocity.isZero()) {
+        m_aheadRect = { };
+        return;
+    }
+    auto ahead = [&](float velocity, int viewSize) {
+        float limit = s_maxAheadViews * viewSize;
+        return std::clamp(velocity * static_cast<float>(s_aheadTime.seconds()), -limit, limit);
+    };
+    FloatRect reached(visibleRect);
+    reached.move(ahead(m_velocity.width(), visibleRect.width()), ahead(m_velocity.height(), visibleRect.height()));
+    m_aheadRect = unionRect(visibleRect, enclosingIntRect(reached));
+
+    // A slower motion in the same direction keeps the tiles painted farther ahead before, but none
+    // behind the view
+    bool sameDirection = (m_velocity.width() * m_lastVelocity.width() + m_velocity.height() * m_lastVelocity.height()) > 0;
+    auto kept = sameDirection ? unionRect(m_lastAheadRect, m_aheadRect) : m_aheadRect;
+    if (m_velocity.height() > 0)
+        kept.shiftYEdgeTo(std::max(kept.y(), visibleRect.y()));
+    else if (m_velocity.height() < 0)
+        kept.shiftMaxYEdgeTo(std::min(kept.maxY(), visibleRect.maxY()));
+    if (m_velocity.width() > 0)
