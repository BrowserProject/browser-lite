+void CoordinatedBackingStoreProxy::paintDirtyTiles(SkiaPaintingEngine& paintingEngine, const Ref<SkiaRecordingResult>& recording, CoordinatedPlatformLayer& layer, Vector<Update::TileUpdate>& tilesToUpdate)
+{
+    // The rendering update waits only for tiles in view that have contents already, so a change
+    // shows everywhere at once. Tiles out of view, and new tiles while the view moves, paint after
+    // them and show when they are done: nearest to the view first, those behind a motion last.
+    bool moving = !m_velocity.isZero();
+    FloatRect visible(m_visibleRect);
+    auto prepaintOrder = [&](const Tile& tile) -> float {
+        if (tile.rect.intersects(m_visibleRect))
+            return 0;
+        auto center = FloatRect(tile.rect).center();
+        float dx = std::max({ 0.f, visible.x() - center.x(), center.x() - visible.maxX() });
+        float dy = std::max({ 0.f, visible.y() - center.y(), center.y() - visible.maxY() });
+        auto towards = center - visible.center();
+        bool behind = moving && towards.width() * m_velocity.width() + towards.height() * m_velocity.height() < 0;
+        return std::hypot(dx, dy) + (behind ? 1e7f : 0);
+    };
+
+    Vector<std::pair<float, Tile*>> prepaintTiles;
+    for (auto& tile : m_tiles.values()) {
+        if (!tile.isDirty())
+            continue;
+        if (!tile.rect.intersects(m_visibleRect) || (moving && tile.neverPainted)) {
+            prepaintTiles.append({ prepaintOrder(tile), &tile });
+            continue;
+        }
+        IntRect updateRect(tile.dirtyRect);
+        updateRect.move(-tile.rect.x(), -tile.rect.y());
+        auto buffer = paintingEngine.replay(*layer.owner(), recording.copyRef(), tile.rect, tile.dirtyRect);
+        tilesToUpdate.append({ tile.id, tile.rect, WTF::move(updateRect), WTF::move(buffer) });
+        tile.markClean();
+        tile.prepainted = false;
+        tile.neverPainted = false;
+    }
+
+    std::ranges::sort(prepaintTiles, { }, [](auto& entry) { return entry.first; });
+    for (auto& entry : prepaintTiles) {
+        auto& tile = *entry.second;
+        IntRect updateRect(tile.dirtyRect);
+        updateRect.move(-tile.rect.x(), -tile.rect.y());
+        auto buffer = paintingEngine.prepaint(*layer.owner(), recording.copyRef(), tile.rect, tile.dirtyRect);
+        tilesToUpdate.append({ tile.id, tile.rect, WTF::move(updateRect), WTF::move(buffer), true });
+        tile.markClean();
+        tile.prepainted = true;
+        tile.neverPainted = false;
+    }
