+// Same check as performGetByIDHelper in the .asm, for places that have no fast path
+// in the interpreter on 32 bit (op_instanceof)
+static ALWAYS_INLINE bool tryCachedGetByID(const GetByIdModeMetadata& metadata, JSCell* cell, JSValue& result)
+{
+    StructureID structureID = cell->structureID();
+    switch (metadata.mode) {
+    case GetByIdMode::Default:
+        if (!metadata.defaultMode.structureID || metadata.defaultMode.structureID != structureID)
+            return false;
+        result = asObject(cell)->getDirect(metadata.defaultMode.cachedOffset);
+        return true;
+    case GetByIdMode::ProtoLoad:
+        if (metadata.protoLoadMode.structureID != structureID)
+            return false;
+        result = metadata.protoLoadMode.cachedSlot->getDirect(metadata.protoLoadMode.cachedOffset);
+        return true;
+    case GetByIdMode::Unset:
+        if (metadata.unsetMode.structureID != structureID)
+            return false;
+        result = jsUndefined();
+        return true;
+    case GetByIdMode::ArrayLength:
+        return false;
+    }
+    return false;
+}
