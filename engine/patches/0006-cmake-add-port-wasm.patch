+# WebCore for PORT=Wasm (browser-lite).
+# Network: curl, graphics: Skia, theme: Adwaita. Platform glue in platform/wasm/.
+include(platform/Adwaita.cmake)
+include(platform/Curl.cmake)
+include(platform/ImageDecoders.cmake)
+include(platform/OpenSSL.cmake)
+include(platform/Skia.cmake)
+include(platform/TextureMapper.cmake)
+
+# WebGL has its own bridge (platform/wasm/GraphicsContextGLWasm.cpp)
+list(REMOVE_ITEM WebCore_SOURCES
+    platform/graphics/texmap/GraphicsContextGLTextureMapperANGLE.cpp
+    platform/graphics/texmap/coordinated/GraphicsContextGLTextureMapperANGLECoordinated.cpp
+)
+
+list(APPEND WebCore_PRIVATE_INCLUDE_DIRECTORIES
+    "${WEBCORE_DIR}/platform"
+    "${WEBCORE_DIR}/platform/generic"
+    "${WEBCORE_DIR}/platform/graphics/egl"
+    "${WEBCORE_DIR}/platform/graphics/opengl"
+    "${WEBCORE_DIR}/platform/graphics/texmap"
+    "${WEBCORE_DIR}/platform/graphics/texmap/coordinated"
+    "${WEBCORE_DIR}/platform/mediacapabilities"
+    "${WEBCORE_DIR}/platform/video-codecs"
+    "${WEBCORE_DIR}/platform/wasm"
+)
+
+list(APPEND WebCore_SOURCES
+    # Accessibility: like PlayStation/Haiku (notifications through the ChromeClient)
+    accessibility/playstation/AXObjectCachePlayStation.cpp
+    accessibility/playstation/AccessibilityObjectPlayStation.cpp
+
+    # These libwpe files do not need libwpe at all, they are enabled for us
+    editing/libwpe/EditorLibWPE.cpp
+    platform/libwpe/PasteboardLibWPE.cpp
+
+    platform/audio/wasm/AudioDestinationWasm.cpp
+    platform/audio/wasm/AudioFileReaderWasm.cpp
+    platform/audio/wasm/FFTFrameWasm.cpp
+
+    platform/generic/KeyedDecoderGeneric.cpp
+    platform/generic/KeyedEncoderGeneric.cpp
+
+    platform/graphics/PlatformDisplay.cpp
+    platform/graphics/egl/GLContext.cpp
+    platform/graphics/egl/GLContextWrapper.cpp
+    platform/graphics/egl/GLDisplay.cpp
+    platform/graphics/egl/GLFence.cpp
+    platform/graphics/egl/GLFenceEGL.cpp
+    platform/graphics/egl/GLFenceGL.cpp
+
+    platform/text/Hyphenation.cpp
+    platform/text/LocaleICU.cpp
+
+    platform/unix/LoggingUnix.cpp
+    platform/unix/SharedMemoryUnix.cpp
+
+    page/glib/DragControllerGLib.cpp
+    platform/wasm/CurlSSLHandleWasm.cpp
+    platform/skia/DragImageSkia.cpp
+    platform/wasm/DragWasm.cpp
+    platform/wasm/GraphicsContextGLWasm.cpp
+    platform/wasm/angle/ANGLEShimForwardWasm.cpp
+    platform/wasm/angle/ANGLEShimWasm.cpp
+    platform/wasm/GraphicsLayerWasm.cpp
+    platform/wasm/MIMETypeRegistryWasm.cpp
+    platform/wasm/NetworkStateNotifierWasm.cpp
+    platform/wasm/PlatformKeyboardEventWasm.cpp
+    platform/wasm/PlatformPasteboardWasm.cpp
+    platform/wasm/PlatformScreenWasm.cpp
+    platform/wasm/PlatformSpeechSynthesizerWasm.cpp
+    platform/wasm/SystemFontDatabaseWasm.cpp
+    platform/wasm/UserAgentWasm.cpp
+    platform/wasm/WasmPlatform.cpp
+)
+
+list(APPEND WebCore_PRIVATE_FRAMEWORK_HEADERS
+    platform/wasm/WasmPlatform.h
+    platform/wasm/angle/ANGLEShimWasm.h
+)
+
+list(APPEND WebCore_LIBRARIES
+    Fontconfig::Fontconfig
+    Freetype::Freetype
+)
+
+# browser-lite: also build the embedder (engine/ in the browser-lite repo) once
+# WebCore/CMakeLists.txt is done (then all include lists are complete).
+if (BROWSER_LITE_ENGINE_DIR)
+    cmake_language(DEFER CALL include "${BROWSER_LITE_ENGINE_DIR}/engine.cmake")
+endif ()
diff --git a/Source/cmake/OptionsWasm.cmake b/Source/cmake/OptionsWasm.cmake
new file mode 100644
index 0000000000..7449ec4a3b
--- /dev/null
+++ b/Source/cmake/OptionsWasm.cmake
@@ -0,0 +1,171 @@
+# PORT=Wasm (browser-lite): WebCore + JavaScriptCore to WebAssembly with Emscripten.
+#
+# - Single process: no WebKit2/IPC, no WebKitLegacy. The embedder (browser-lite
+#   engine/) attaches WebCore::Page directly.
+# - Structured like the PlayStation port (curl, generic RunLoop, static),
+#   graphics like WPE (Skia), theme like Win (Adwaita).
+# - JavaScriptCore with CLoop, no JIT (WASM cannot generate code by itself).
+#
+# Built with tools/build-webcore.sh from the browser-lite repo.
+
+if (NOT EMSCRIPTEN)
+    message(FATAL_ERROR "PORT=Wasm only works with Emscripten (emcmake cmake ...)")
+endif ()
+
+find_package(Threads REQUIRED)
+
+set(CMAKE_C_VISIBILITY_PRESET hidden)
+set(CMAKE_CXX_VISIBILITY_PRESET hidden)
+set(CMAKE_VISIBILITY_INLINES_HIDDEN ON)
+
+add_definitions(-DBUILDING_WASM__)
+add_definitions(-DWTF_PLATFORM_WASM=1)
+
+set(PROJECT_VERSION_MAJOR 0)
+set(PROJECT_VERSION_MINOR 1)
+set(PROJECT_VERSION_MICRO 0)
+set(PROJECT_VERSION ${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}.${PROJECT_VERSION_MICRO})
+
+set(ENABLE_WEBCORE ON)
+set(ENABLE_WEBKIT OFF)
+set(ENABLE_WEBKIT_LEGACY OFF)
+set(ENABLE_WEBINSPECTORUI OFF)
+set(ENABLE_WEBGPU OFF)
+set(ENABLE_TOOLS OFF)
+
+WEBKIT_OPTION_BEGIN()
+
+WEBKIT_OPTION_DEFINE(ENABLE_STATIC_JSC "Whether to build JavaScriptCore as a static library." PUBLIC ON)
+
+# JavaScriptCore: only the CLoop interpreter
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_JIT PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_DFG_JIT PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_FTL_JIT PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_C_LOOP PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBASSEMBLY PRIVATE OFF)
+# Thread::suspend does not work in WASM, so never the sampling profiler
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_SAMPLING_PROFILER PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_REMOTE_INSPECTOR PRIVATE OFF)
+# bmalloc/libpas do not fit the linear memory of WASM
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_SYSTEM_MALLOC PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_ISO_MALLOC PRIVATE OFF)
+
+# Graphics
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_SKIA PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_SKIA_ENCODERS PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_WOFF2 PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_AVIF PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_JPEGXL PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_LCMS PRIVATE OFF)
+
+# <video>/<audio>: played back in the host browser (engine/src/media)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_VIDEO PRIVATE ON)
+# Web Audio: output through an AudioWorklet of the host browser (platform/audio/wasm)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEB_AUDIO PRIVATE ON)
+# WebGL without ANGLE, directly on the WebGL of the host browser (platform/wasm/angle)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBGL PRIVATE ON)
+# MSE: WebCore with its own parsers, played back through the MediaSource of the host browser (engine/src/media)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MEDIA_SOURCE PRIVATE ON)
+# Camera, microphone and screen of the host browser (engine/src/media/MediaStreamWasm.cpp)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MEDIA_STREAM PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MEDIA_RECORDER PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEB_RTC PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_ENCRYPTED_MEDIA PRIVATE OFF)
+# Devices and services of the host browser (engine/src, data comes from the UI)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_GAMEPAD PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_SPEECH_SYNTHESIS PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_NOTIFICATIONS PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_GEOLOCATION PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_TOUCH_EVENTS PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_POINTER_LOCK PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MEDIA_SESSION PRIVATE ON)
+# Selecting with the mouse depends on drag support in WebCore
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_DRAG_SUPPORT PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_OFFSCREEN_CANVAS PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_OFFSCREEN_CANVAS_IN_WORKERS PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_VARIATION_FONTS PRIVATE ON)
+# Fullscreen: the UI enlarges the page area in the host browser
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_FULLSCREEN_API PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBXR PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_XSLT PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MATHML PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_DARK_MODE_CSS PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_SMOOTH_SCROLLING PRIVATE ON)
+# Scrolling on its own thread (ScrollingTreeCoordinated), even while JS is blocking
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_ASYNC_SCROLLING PRIVATE ON)
+# Orientation and motion sensors of the host (engine/src/DeviceClients.cpp)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_DEVICE_ORIENTATION PRIVATE ON)
+# WebCodecs through the WebCodecs of the host browser (engine/src/media/WebCodecsWasm.cpp)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEB_CODECS PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_RESOURCE_USAGE PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_PERIODIC_MEMORY_MONITOR PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBDRIVER PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MINIBROWSER PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_API_TESTS PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_LAYOUT_TESTS PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_GPU_PROCESS PRIVATE OFF)
+
+WEBKIT_OPTION_END()
+
+if (NOT ENABLE_STATIC_JSC)
+    message(FATAL_ERROR "PORT=Wasm needs ENABLE_STATIC_JSC=ON (WASM is linked fully statically)")
+endif ()
+
+# Event loop: WTF RunLoopGeneric, driven by the embedder (no GLib)
+SET_AND_EXPOSE_TO_BUILD(USE_GENERIC_EVENT_LOOP 1)
+SET_AND_EXPOSE_TO_BUILD(WTF_DEFAULT_EVENT_LOOP 0)
+
+find_package(ICU 70.1 REQUIRED COMPONENTS data i18n uc)
+
+SET_AND_EXPOSE_TO_BUILD(USE_CURL ON)
+SET_AND_EXPOSE_TO_BUILD(USE_OPENSSL ON)
+SET_AND_EXPOSE_TO_BUILD(USE_HARFBUZZ ON)
+SET_AND_EXPOSE_TO_BUILD(USE_THEME_ADWAITA ON)
+SET_AND_EXPOSE_TO_BUILD(USE_UNIX_DOMAIN_SOCKETS ON)
+SET_AND_EXPOSE_TO_BUILD(USE_INSPECTOR_SOCKET_SERVER ${ENABLE_REMOTE_INSPECTOR})
+# Layers (compositing) like WPE: GraphicsLayerCoordinated, painted by Skia,
+# composited in the engine worker (engine/src/LayerTreeHostWasm.cpp). Whether a page
+# uses layers is decided by the engine at runtime.
+SET_AND_EXPOSE_TO_BUILD(USE_TEXTURE_MAPPER ON)
+SET_AND_EXPOSE_TO_BUILD(USE_COORDINATED_GRAPHICS ON)
+SET_AND_EXPOSE_TO_BUILD(ENABLE_DEVELOPER_MODE ${DEVELOPER_MODE})
+
+# All libraries come from the browser-lite sysroot (CMAKE_FIND_ROOT_PATH)
+find_package(Brotli REQUIRED COMPONENTS dec)
+find_package(CURL 7.85.0 REQUIRED)
+find_package(Fontconfig 2.13.0 REQUIRED)
+find_package(Freetype 2.9.0 REQUIRED)
+find_package(HarfBuzz 2.7.4 REQUIRED COMPONENTS ICU)
+find_package(JPEG 1.5.2 REQUIRED)
+find_package(LibPSL 0.20.2 REQUIRED)
+find_package(LibXml2 2.9.7 REQUIRED)
+find_package(OpenSSL REQUIRED)
+find_package(PNG REQUIRED)
+find_package(SQLite3 3.23.1 REQUIRED)
+if (NOT TARGET SQLite3::SQLite3) # CMake < 4.3
+    add_library(SQLite3::SQLite3 ALIAS SQLite::SQLite3)
+endif ()
+find_package(WebP REQUIRED COMPONENTS demux)
+find_package(ZLIB 1.2.11 REQUIRED)
+
+if (ENABLE_XSLT)
+    find_package(LibXslt 1.1.13 REQUIRED)
+endif ()
+
+if (USE_WOFF2)
+    find_package(WOFF2 1.0.2 COMPONENTS dec)
+    if (NOT WOFF2_FOUND)
+        message(FATAL_ERROR "libwoff2dec is missing from the sysroot")
+    endif ()
+endif ()
+
+# EGL and GLES2 come from Emscripten itself (headers in the Emscripten sysroot,
+# the implementation is a JS library on top of WebGL, -lEGL -lGL at link time).
+# There are no .a files, hence empty INTERFACE targets.
+set(EGL_LIBRARIES "")
+if (NOT TARGET EGL::EGL)
+    add_library(EGL::EGL INTERFACE IMPORTED)
+endif ()
+if (NOT TARGET OpenGL::GLES)
+    add_library(OpenGL::GLES INTERFACE IMPORTED)
+endif ()
