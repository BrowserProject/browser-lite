diff --git a/Source/WebCore/dom/EventSender.h b/Source/WebCore/dom/EventSender.h
index 521743318b..86aca194f7 100644
--- a/Source/WebCore/dom/EventSender.h
+++ b/Source/WebCore/dom/EventSender.h
@@ -47,6 +47,14 @@ public:
     void cancelEvent(T&);
     void cancelEvent(T&, const AtomString& eventType);
     void dispatchPendingEvents(Page*);
+    // browser-lite: the events of a sender whose document suspended its active DOM objects (a
+    // page below a dialog, a hidden view that waits for the user) wait in the list without the
+    // timer; the document calls this when it resumes them
+    void resumeEvents()
+    {
+        if (!m_dispatchSoonList.isEmpty() && !m_timer.isActive())
+            m_timer.startOneShot(0_s);
+    }
 
 #if ASSERT_ENABLED
     bool hasPendingEvents(T& sender) const
@@ -134,7 +142,10 @@ template<typename T, typename WeakPtrImpl> void EventSender<T, WeakPtrImpl>::dis
         if (!weakSender)
             continue;
         auto sender = std::exchange(weakSender, nullptr);
-        if (!page || sender->document().page() == page)
+        // browser-lite: no event in a document that waits, resumeEvents() goes on
+        if (sender->document().activeDOMObjectsAreSuspended())
+            m_dispatchSoonList.append(DispatchTask { *sender, eventType });
+        else if (!page || sender->document().page() == page)
             sender->dispatchPendingEvent(this, eventType);
         else
             dispatchEventSoon(*sender, eventType);
