+#if OS(EMSCRIPTEN)
+// browser-lite: without a JIT for regular expressions a pattern that backtracks a lot costs 10 to
+// 30 times more here than in the regular expressions of the host browser (the engine runs in a
+// worker of it). The embedder can run a pattern there (setHostMatch). A pattern of a RegExp goes
+// there when its measured interpretation costs much per character of the input; everything else
+// (cheap patterns, loops over long strings) stays in this interpreter.
+using HostMatch = unsigned (*)(unsigned id, const String& source, unsigned flags, StringView input, unsigned start, unsigned* output, unsigned outputSize);
+static constexpr unsigned HostMatchDeclined = offsetNoMatch - 1;
+
+struct HostPattern {
+    String source;
+    OptionSet<Flags> flags;
+    unsigned id { 0 };
+    double nanosPerCharacter { 0 };
+    unsigned calls { 0 };
+    bool interpretOnly { false };
+};
+
+static Lock s_hostPatternsLock;
+static HashMap<const BytecodePattern*, HostPattern>& hostPatterns() WTF_REQUIRES_LOCK(s_hostPatternsLock)
+{
+    static NeverDestroyed<HashMap<const BytecodePattern*, HostPattern>> patterns;
+    return patterns;
+}
+static HostMatch s_hostMatch;
+static bool s_hostMatchAlways;
+static unsigned s_lastHostPatternId;
+
+// always: every pattern goes there, not only those measured expensive (tests)
+void setHostMatch(HostMatch, bool always);
+void setHostMatch(HostMatch match, bool always)
+{
+    s_hostMatch = match;
+    s_hostMatchAlways = always;
+}
+
+void registerHostPattern(const BytecodePattern*, const String& source, OptionSet<Flags>);
+void registerHostPattern(const BytecodePattern* bytecode, const String& source, OptionSet<Flags> flags)
+{
+    // Duplicate named groups use extra output slots the host does not fill
+    if (!s_hostMatch || !bytecode || bytecode->hasDuplicateNamedCaptureGroups())
+        return;
+    Locker locker { s_hostPatternsLock };
+    hostPatterns().set(bytecode, HostPattern { source.isolatedCopy(), flags, ++s_lastHostPatternId });
+}
+
+void unregisterHostPattern(const BytecodePattern*);
+void unregisterHostPattern(const BytecodePattern* bytecode)
+{
+    if (!bytecode)
+        return;
+    Locker locker { s_hostPatternsLock };
+    hostPatterns().remove(bytecode);
+}
+
+// Measured calls before the first decision (their cheapest counts: the first call can wait for
+// code), then every 32nd call measures again, also of a pattern that runs in the host
+static constexpr unsigned hostSampleCalls = 4;
+static constexpr unsigned hostSampleInterval = 32;
+// The host costs a call into JS and a copy of the input: only patterns that cost far more per
+// character, and only inputs where it adds up
+static constexpr double hostNanosPerCharacter = 40;
+static constexpr double hostMinimumNanos = 30000;
+static constexpr unsigned hostMaximumLength = 256 * 1024;
+
+unsigned interpret(BytecodePattern* bytecode, StringView input, unsigned start, unsigned* output)
+{
+    if (!s_hostMatch || input.length() > hostMaximumLength)
+        return interpretBytecode(bytecode, input, start, output);
+    unsigned id = 0;
+    unsigned call = 0;
+    String source;
+    OptionSet<Flags> flags;
+    {
+        Locker locker { s_hostPatternsLock };
+        auto it = hostPatterns().find(bytecode);
+        if (it == hostPatterns().end() || it->value.interpretOnly)
+            return interpretBytecode(bytecode, input, start, output);
+        auto& pattern = it->value;
+        call = pattern.calls++;
+        bool measure = call < hostSampleCalls || !(call % hostSampleInterval);
+        bool expensive = call >= hostSampleCalls && pattern.nanosPerCharacter >= hostNanosPerCharacter && pattern.nanosPerCharacter * input.length() >= hostMinimumNanos;
+        if (s_hostMatchAlways || (expensive && !measure)) {
+            id = pattern.id;
+            source = pattern.source;
+            flags = pattern.flags;
+        } else if (!measure || !input.length())
+            call = std::numeric_limits<unsigned>::max();
+    }
+    if (id) {
+        auto result = s_hostMatch(id, source, static_cast<unsigned>(flags.toRaw()), input, start, output, bytecode->m_offsetsSize);
+        if (result != HostMatchDeclined)
+            return result;
+        Locker locker { s_hostPatternsLock };
+        if (auto it = hostPatterns().find(bytecode); it != hostPatterns().end())
+            it->value.interpretOnly = true;
+        return interpretBytecode(bytecode, input, start, output);
+    }
+    if (call == std::numeric_limits<unsigned>::max())
+        return interpretBytecode(bytecode, input, start, output);
+    auto begin = MonotonicTime::now();
+    auto result = interpretBytecode(bytecode, input, start, output);
+    double nanosPerCharacter = (MonotonicTime::now() - begin).nanoseconds() / input.length();
+    Locker locker { s_hostPatternsLock };
+    if (auto it = hostPatterns().find(bytecode); it != hostPatterns().end()) {
+        auto& pattern = it->value;
+        if (!call)
+            pattern.nanosPerCharacter = nanosPerCharacter;
+        else if (call < hostSampleCalls)
+            pattern.nanosPerCharacter = std::min(pattern.nanosPerCharacter, nanosPerCharacter);
+        else
+            pattern.nanosPerCharacter = (pattern.nanosPerCharacter * 3 + nanosPerCharacter) / 4;
+    }
+    return result;
+}
+#else
+unsigned interpret(BytecodePattern* bytecode, StringView input, unsigned start, unsigned* output)
+{
+    return interpretBytecode(bytecode, input, start, output);
+}
+#endif
