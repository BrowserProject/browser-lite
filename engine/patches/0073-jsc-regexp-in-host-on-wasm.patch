+#if OS(EMSCRIPTEN)
+// browser-lite: without a JIT for regular expressions a pattern that backtracks a lot costs 10 to
+// 30 times more here than in the regular expressions of the host browser (the engine runs in a
+// worker of it). The embedder can run a pattern there (setHostMatch). A pattern of a RegExp goes
+// there when its measured interpretation costs much per character of the input; everything else
+// (cheap patterns, loops over long strings) stays in this interpreter.
+using HostMatch = unsigned (*)(unsigned id, const String& source, unsigned flags, StringView input, unsigned start, unsigned* output, unsigned outputSize);
+static constexpr unsigned HostMatchDeclined = offsetNoMatch - 1;
+
+// What the measurements found out about a pattern (its source and flags). It outlives the
+// bytecode that measured it: a RegExp the GC collected or whose code a memory release deleted
+// compiles again with the same pattern, and its first calls then go on where the last ones
+// stopped instead of being measured in the interpreter again.
+struct HostPatternCost : ThreadSafeRefCounted<HostPatternCost> {
+    WTF_MAKE_STRUCT_TZONE_ALLOCATED(HostPatternCost);
+    explicit HostPatternCost(unsigned id)
+        : id(id)
+    {
+    }
+    unsigned id;
+    double nanosPerCharacter { 0 };
+    // The last measured call: a later one counts at most this much, so that a single call the
+    // system held up (another thread, a coarse clock) does not move the pattern
+    double lastNanosPerCharacter { 0 };
+    unsigned calls { 0 };
+    bool interpretOnly { false };
+    // Its last call in the host took at least hostMinimumNanos beyond the cost of the call itself
+    bool heavyInHost { false };
+};
+
+WTF_MAKE_TZONE_ALLOCATED_IMPL(HostPatternCost);
+
+struct HostPattern {
+    // This thread's copy for the host. The cost's key has its own copy, touched only under the
+    // lock: the patterns of all threads share the costs.
+    String source;
+    OptionSet<Flags> flags;
+    RefPtr<HostPatternCost> cost;
+};
+
+static Lock s_hostPatternsLock;
+static HashMap<const BytecodePattern*, HostPattern>& hostPatterns() WTF_REQUIRES_LOCK(s_hostPatternsLock)
+{
+    static NeverDestroyed<HashMap<const BytecodePattern*, HostPattern>> patterns;
+    return patterns;
+}
+static HashMap<RegExpKey, RefPtr<HostPatternCost>>& hostPatternCosts() WTF_REQUIRES_LOCK(s_hostPatternsLock)
+{
+    static NeverDestroyed<HashMap<RegExpKey, RefPtr<HostPatternCost>>> costs;
+    return costs;
+}
+// Costs of patterns without bytecode are kept until there are this many, then dropped
+static constexpr unsigned hostPatternCostsKept = 1024;
+static unsigned s_pruneHostPatternCostsAt WTF_GUARDED_BY_LOCK(s_hostPatternsLock) = hostPatternCostsKept;
+static HostMatch s_hostMatch;
+static bool s_hostMatchAlways;
+static unsigned s_lastHostPatternId WTF_GUARDED_BY_LOCK(s_hostPatternsLock);
+
+// always: every pattern goes there, not only those measured expensive (tests)
+void setHostMatch(HostMatch, bool always);
+void setHostMatch(HostMatch match, bool always)
+{
+    s_hostMatch = match;
+    s_hostMatchAlways = always;
+}
+
+static Ref<HostPatternCost> hostPatternCost(const String& source, OptionSet<Flags> flags) WTF_REQUIRES_LOCK(s_hostPatternsLock)
+{
+    auto& costs = hostPatternCosts();
+    if (auto it = costs.find(RegExpKey(flags, source)); it != costs.end())
+        return *it->value;
+    if (costs.size() >= s_pruneHostPatternCostsAt) {
+        costs.removeIf([](auto& entry) {
+            return entry.value->hasOneRef();
+        });
+        s_pruneHostPatternCostsAt = std::max<unsigned>(hostPatternCostsKept, costs.size() * 2);
+    }
+    Ref cost = adoptRef(*new HostPatternCost(++s_lastHostPatternId));
+    costs.add(RegExpKey(flags, source.isolatedCopy()), cost.copyRef());
+    return cost;
+}
+
+void registerHostPattern(const BytecodePattern*, const String& source, OptionSet<Flags>);
+void registerHostPattern(const BytecodePattern* bytecode, const String& source, OptionSet<Flags> flags)
+{
+    // Duplicate named groups use extra output slots the host does not fill
+    if (!s_hostMatch || !bytecode || bytecode->hasDuplicateNamedCaptureGroups())
+        return;
+    Locker locker { s_hostPatternsLock };
+    hostPatterns().set(bytecode, HostPattern { source.isolatedCopy(), flags, hostPatternCost(source, flags) });
+}
+
+void unregisterHostPattern(const BytecodePattern*);
+void unregisterHostPattern(const BytecodePattern* bytecode)
+{
+    if (!bytecode)
+        return;
+    Locker locker { s_hostPatternsLock };
+    hostPatterns().remove(bytecode);
+}
+
+// The first call of a pattern is measured here and decides. After that a call that stays here
+// measures again every 32nd call, which costs only the clock. A call that would go to the host
+// is measured here only as call 32, 64, 128 and so on, because that costs the whole
+// interpretation (10 to 50 ms for a cookie regexp of 20min.ch), and not at all while the
+// pattern's calls in the host are heavy: the interpreter is many times slower than the host's
+// RegExp. A first call that was held up (another thread, code still loading) sends a cheap
+// pattern to the host until call 32.
+static constexpr unsigned hostSampleInterval = 32;
+// A call into the host costs about 1.5 us plus 2.5 ns per character of the input, which is
+// copied into a JS string each time (Chromium): a pattern goes there when it costs 4 times that
+// per character here, and only for calls of at least 30 us, well above the resolution of the
+// host's clock (5 us in Chromium, 20 us in Firefox)
+static constexpr double hostCallNanos = 1500;
+static constexpr double hostCopyNanosPerCharacter = 2.5;
+static constexpr double hostNanosPerCharacter = 4 * hostCopyNanosPerCharacter;
+static constexpr double hostMinimumNanos = 30000;
+static constexpr unsigned hostMaximumLength = 256 * 1024;
+
+static bool remeasure(unsigned call, bool expensive, bool heavyInHost)
+{
+    if (!call)
+        return true;
+    if (expensive)
+        return !heavyInHost && call >= hostSampleInterval && !(call & (call - 1));
+    return !(call % hostSampleInterval);
+}
+
+unsigned interpret(BytecodePattern* bytecode, StringView input, unsigned start, unsigned* output)
+{
+    if (!s_hostMatch || input.length() > hostMaximumLength)
+        return interpretBytecode(bytecode, input, start, output);
+    unsigned id = 0;
+    unsigned call = 0;
+    String source;
+    OptionSet<Flags> flags;
+    {
+        Locker locker { s_hostPatternsLock };
+        auto it = hostPatterns().find(bytecode);
+        if (it == hostPatterns().end() || it->value.cost->interpretOnly)
+            return interpretBytecode(bytecode, input, start, output);
+        auto& pattern = it->value;
+        auto& cost = *pattern.cost;
+        call = cost.calls++;
+        bool expensive = call && cost.nanosPerCharacter >= hostNanosPerCharacter && cost.nanosPerCharacter * input.length() >= hostMinimumNanos;
+        bool measure = remeasure(call, expensive, cost.heavyInHost);
+        if (s_hostMatchAlways || (expensive && !measure)) {
+            id = cost.id;
+            source = pattern.source;
+            flags = pattern.flags;
+        } else if (!measure || !input.length())
+            call = std::numeric_limits<unsigned>::max();
+    }
+    if (id) {
+        auto begin = MonotonicTime::now();
+        auto result = s_hostMatch(id, source, static_cast<unsigned>(flags.toRaw()), input, start, output, bytecode->m_offsetsSize);
+        double nanos = (MonotonicTime::now() - begin).nanoseconds();
+        bool declined = result == HostMatchDeclined;
+        {
+            Locker locker { s_hostPatternsLock };
+            if (auto it = hostPatterns().find(bytecode); it != hostPatterns().end()) {
+                auto& cost = *it->value.cost;
+                if (declined)
+                    cost.interpretOnly = true;
+                else
+                    cost.heavyInHost = nanos >= hostCallNanos + hostCopyNanosPerCharacter * input.length() + hostMinimumNanos;
+            }
+        }
+        return declined ? interpretBytecode(bytecode, input, start, output) : result;
+    }
+    if (call == std::numeric_limits<unsigned>::max())
+        return interpretBytecode(bytecode, input, start, output);
+    auto begin = MonotonicTime::now();
+    auto result = interpretBytecode(bytecode, input, start, output);
+    double nanosPerCharacter = (MonotonicTime::now() - begin).nanoseconds() / input.length();
+    Locker locker { s_hostPatternsLock };
+    if (auto it = hostPatterns().find(bytecode); it != hostPatterns().end()) {
+        auto& cost = *it->value.cost;
+        if (!call)
+            cost.nanosPerCharacter = nanosPerCharacter;
+        else
+            cost.nanosPerCharacter = (cost.nanosPerCharacter * 3 + std::min(nanosPerCharacter, cost.lastNanosPerCharacter)) / 4;
+        cost.lastNanosPerCharacter = nanosPerCharacter;
+    }
+    return result;
+}
+#else
+unsigned interpret(BytecodePattern* bytecode, StringView input, unsigned start, unsigned* output)
+{
+    return interpretBytecode(bytecode, input, start, output);
+}
+#endif
+
 // These should be the same for both char16_t & Latin1Character.
 static_assert(sizeof(BackTrackInfoPatternCharacter) == (YarrStackSpaceForBackTrackInfoPatternCharacter * sizeof(uintptr_t)));
