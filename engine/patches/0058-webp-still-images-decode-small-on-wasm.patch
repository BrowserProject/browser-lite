+#if PLATFORM(WASM)
+IntSize WEBPImageDecoder::frameSizeAtIndex(size_t, SubsamplingLevel subsamplingLevel) const
+{
+    // Like JPEG (patch 0054): a scale of 1 / 2^level, rounded up. Animations
+    // keep the full size, their frames build on each other.
+    auto size = this->size();
+    if (!decodesScaled())
+        return size;
+    int denominator = 1 << static_cast<int>(std::min(subsamplingLevel, SubsamplingLevel::Last));
+    return { (size.width() + denominator - 1) / denominator, (size.height() + denominator - 1) / denominator };
+}
+
+void WEBPImageDecoder::setSubsamplingLevel(SubsamplingLevel subsamplingLevel)
+{
+    assertIsHeld(m_lock);
+    subsamplingLevel = decodesScaled() ? std::min(subsamplingLevel, SubsamplingLevel::Last) : SubsamplingLevel::Default;
+    if (subsamplingLevel == m_subsamplingLevel)
+        return;
+
+    // Another scale decodes the frame again. A native image made from the old
+    // frame keeps its own reference to the old pixels.
+    m_subsamplingLevel = subsamplingLevel;
+    if (!m_frameBufferCache.isEmpty())
+        m_frameBufferCache[0].clear();
+}
+#endif
