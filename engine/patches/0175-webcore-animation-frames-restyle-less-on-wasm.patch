+
+void SVGElement::updateInstancesForAttributeChange(const QualifiedName& name, const AtomString& newValue)
+{
+    if (instanceUpdatesBlocked())
+        return;
+    auto instances = copyToVectorOf<Ref<SVGElement>>(this->instances());
