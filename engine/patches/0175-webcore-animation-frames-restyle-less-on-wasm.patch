+// browser-lite: whether a selector may match the element itself (no pseudo-element given) or its ::before or
+// ::after, by the ids, classes and tag of its rightmost compound and the pseudo-element there.
+static bool subjectMayMatch(const CSSSelector& selector, const Element& element, std::optional<CSSSelector::PseudoElement> pseudoElement = std::nullopt)
+{
+    bool inQuirksMode = element.document().inQuirksMode();
+    bool matchesPseudoElement = false;
+    for (auto* simpleSelector = &selector; simpleSelector; simpleSelector = simpleSelector->precedingInComplexSelector()) {
+        switch (simpleSelector->match()) {
+        case CSSSelector::Match::Tag: {
+            auto& localName = simpleSelector->tagQName().localName();
+            if (localName != starAtom() && !equalIgnoringASCIICase(localName, element.localName()))
+                return false;
+            break;
+        }
+        case CSSSelector::Match::Id:
+            if (!inQuirksMode && element.getIdAttribute() != simpleSelector->value())
+                return false;
+            break;
+        case CSSSelector::Match::Class:
+            if (!inQuirksMode && !element.hasClassName(simpleSelector->value()))
+                return false;
+            break;
+        case CSSSelector::Match::PseudoElement:
+            if (!pseudoElement || simpleSelector->pseudoElement() != *pseudoElement)
+                return false;
+            matchesPseudoElement = true;
+            break;
+        default:
+            break;
+        }
+        if (simpleSelector->relation() != CSSSelector::Relation::Subselector)
+            break;
+    }
