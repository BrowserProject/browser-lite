+// browser-lite: work goes in the order in which it was queued, like in Chrome and the HTML
+// standard: a timer that came due during a long task runs after what was posted before its
+// deadline. A function carries its queue time: when it was dispatched, or for a function that another
+// function of this thread dispatches (the next step of delivering what was posted, such as a
+// message of a MessagePort that a worker posted), the time of that function. Only one step
+// inherits, so a function that keeps dispatching itself gets newer times. What a function queues
+// in WebCore's event loop takes its time too (bl_wtf_function_queue_time), so the event loop
+// orders it against the timers by when it was posted. A cycle runs the functions before the
+// timers (RunLoopGeneric.cpp).
+struct FunctionQueueTime {
+    MonotonicTime time;
+    bool inherited { false };
+};
+static thread_local std::optional<FunctionQueueTime> s_runningFunction;
+static thread_local bool s_dispatchedInheritedTime;
+
+static Function<void()> withQueueTime(const RunLoop& runLoop, Function<void()>&& function)
+{
+    FunctionQueueTime queued { MonotonicTime::now() };
+    if (s_runningFunction && !s_runningFunction->inherited && runLoop.isCurrent()) {
+        queued = { s_runningFunction->time, true };
+        s_dispatchedInheritedTime = true;
+    }
+    return [queued, function = WTF::move(function)]() mutable {
+        auto outer = std::exchange(s_runningFunction, queued);
+        function();
+        s_runningFunction = outer;
+    };
+}
+
+// Seconds of the MonotonicTime when the running function was queued, 0 outside of a function
+extern "C" double bl_wtf_function_queue_time();
+extern "C" double bl_wtf_function_queue_time()
+{
+    return s_runningFunction ? s_runningFunction->time.secondsSinceEpoch().value() : 0;
+}
+
+// Whether a function dispatched one with an inherited time since the last call
+extern "C" bool bl_wtf_take_inherited_dispatch();
+extern "C" bool bl_wtf_take_inherited_dispatch()
+{
+    return std::exchange(s_dispatchedInheritedTime, false);
+}
 #endif
 
