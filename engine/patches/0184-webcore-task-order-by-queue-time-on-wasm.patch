+
+// browser-lite: a task with the time it was queued: now, or when a RunLoop function delivers what
+// was posted earlier (a message of a MessagePort or a worker) that function's queue time
+// (RunLoop.cpp). The event loop runs when its oldest task was queued
+// (WindowEventLoop::scheduleToRun), so WebCore's timers order its tasks against the timers by
+// that time: a timer that came due during a long task runs after the messages that were posted
+// before its deadline, also when they wait behind other tasks of the event loop, as in Chrome.
+class EventLoopTaskWithQueueTime final : public EventLoopTask {
+    WTF_MAKE_TZONE_ALLOCATED(EventLoopTaskWithQueueTime);
+public:
+    EventLoopTaskWithQueueTime(std::unique_ptr<EventLoopTask>&& task, MonotonicTime queueTime)
+        : EventLoopTask(task->taskSource(), *task->group())
+        , m_task(WTF::move(task))
+        , m_queueTime(queueTime)
+    {
+    }
+
+    void execute() final { m_task->execute(); }
+    MonotonicTime queueTime() const { return m_queueTime; }
+
+private:
+    std::unique_ptr<EventLoopTask> m_task;
+    MonotonicTime m_queueTime;
+};
+
+WTF_MAKE_TZONE_ALLOCATED_IMPL(EventLoopTaskWithQueueTime);
+
+static MonotonicTime queueTime(const std::unique_ptr<EventLoopTask>& task)
+{
+    return static_cast<const EventLoopTaskWithQueueTime&>(*task).queueTime();
+}
+
+// Of the tasks that can run (those of a suspended document wait for it)
+static MonotonicTime oldestQueueTime(const EventLoop::TaskVector& tasks)
+{
+    auto oldest = MonotonicTime::now();
+    for (auto& task : tasks) {
+        auto* group = task->group();
+        if (group && !group->isSuspended() && !group->isStoppedPermanently())
+            oldest = std::min(oldest, queueTime(task));
+    }
+    return oldest;
+}
+
+// When the event loop that schedules itself next runs (WindowEventLoop::scheduleToRun)
+static thread_local MonotonicTime s_timeToRun;
+
+MonotonicTime eventLoopTimeToRun();
+MonotonicTime eventLoopTimeToRun()
+{
+    return s_timeToRun;
+}
+#endif
+
 void EventLoop::queueTask(std::unique_ptr<EventLoopTask>&& task)
 {
     ASSERT(task->taskSource() != TaskSource::Microtask);
     ASSERT(task->group());
     ASSERT(isContextThread());
+#if OS(EMSCRIPTEN)
+    // Delivering what was posted earlier keeps the time it was posted; what a script queues (also
+    // one that a RunLoop function runs, such as a script of the parser) is queued now
+    auto* vm = isMainThread() ? commonVMOrNull() : nullptr;
+    double functionQueueTime = vm && !vm->entryScope ? bl_wtf_function_queue_time() : 0;
+    auto time = functionQueueTime ? MonotonicTime::fromRawSeconds(functionQueueTime) : MonotonicTime::now();
+    bool earliest = time < oldestQueueTime(m_tasks);
+    m_tasks.append(makeUnique<EventLoopTaskWithQueueTime>(WTF::move(task), time));
+    // A task queued earlier than those the scheduled run waits for moves the run earlier
+    if (functionQueueTime && earliest && microtaskQueue().isScheduledToRun()) {
+        s_timeToRun = time;
+        scheduleToRun();
+        return;
+    }
+    scheduleToRunIfNeeded();
+#else
     scheduleToRunIfNeeded();
     m_tasks.append(WTF::move(task));
+#endif
 }
 
