+++ b/Source/WebCore/css/themeAdwaita.css
@@ -70,3 +70,18 @@ input[type="search"]::-webkit-search-results-decoration:hover,
 input[type="search"]::-webkit-search-cancel-button:hover {
     opacity: 1;
 }
+
+#if defined(WTF_PLATFORM_WASM) && WTF_PLATFORM_WASM
+/* browser-lite: buttons, checkboxes and radios take the room they take in Chrome and Firefox */
+input:is([type="button"], [type="submit"], [type="reset"]), input[type="file"]::file-selector-button, button {
+    padding-block: 1px;
+}
+
+input[type="checkbox"] {
+    margin: 3px 3px 3px 4px;
+}
+
+input[type="radio"] {
+    margin: 3px 3px 0 5px;
+}
+#endif
