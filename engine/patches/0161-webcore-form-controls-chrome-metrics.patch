diff --git a/Source/WebCore/platform/wasm/SystemFontDatabaseWasm.cpp b/Source/WebCore/platform/wasm/SystemFontDatabaseWasm.cpp
index 02c0095288..4e635fab72 100644
--- a/Source/WebCore/platform/wasm/SystemFontDatabaseWasm.cpp
+++ b/Source/WebCore/platform/wasm/SystemFontDatabaseWasm.cpp
@@ -37,10 +37,22 @@ SystemFontDatabase& SystemFontDatabase::singleton()
     return database.get();
 }
 
-auto SystemFontDatabase::platformSystemFontShorthandInfo(FontShorthand) -> SystemFontShorthandInfo
+auto SystemFontDatabase::platformSystemFontShorthandInfo(FontShorthand fontShorthand) -> SystemFontShorthandInfo
 {
     // system-ui and friends: the standard font (fontconfig picks the matching Noto font)
-    return { WebKitFontFamilyNames::standardFamily, 16, normalWeightValue() };
+    float size = 16;
+    switch (fontShorthand) {
+    case FontShorthand::WebkitMiniControl:
+    case FontShorthand::WebkitSmallControl:
+    case FontShorthand::WebkitControl:
+        // The font of form controls (html.css): 2pt less than the default 16px, 13.333px like
+        // Chrome and Firefox
+        size = 16 - 2.f * 96 / 72;
+        break;
+    default:
+        break;
+    }
+    return { WebKitFontFamilyNames::standardFamily, size, normalWeightValue() };
 }
 
 void SystemFontDatabase::platformInvalidate()
