+// browser-lite: when sheets were removed (and others added) and the remaining ones kept their
+// order, the rules of the removed and added sheets are all that changed for an element; the
+// resolver is built anew but only the elements they may match restyle, like in Blink. Before, a
+// removed sheet restyled the whole document (a route change of a single page app removing the
+// <style> of a video player: 1.3 s with 3800 elements on a phone).
+Scope::StyleSheetChange Scope::analyzeStyleSheetRemoval(const Vector<Ref<CSSStyleSheet>>& newStylesheets)
+{
+    HashSet<const CSSStyleSheet*> oldSheets;
+    for (auto& sheet : m_activeStyleSheets)
+        oldSheets.add(sheet.ptr());
+    HashSet<const CSSStyleSheet*> newSheets;
+    for (auto& sheet : newStylesheets)
+        newSheets.add(sheet.ptr());
+
+    Vector<const CSSStyleSheet*> keptInOldOrder;
+    Vector<Ref<StyleSheetContents>> removedSheets;
+    for (auto& sheet : m_activeStyleSheets) {
+        if (newSheets.contains(sheet.ptr()))
+            keptInOldOrder.append(sheet.ptr());
+        else
+            removedSheets.append(protect(sheet->contents()));
+    }
+    Vector<const CSSStyleSheet*> keptInNewOrder;
+    Vector<Ref<StyleSheetContents>> addedSheets;
+    for (auto& sheet : newStylesheets) {
+        if (oldSheets.contains(sheet.ptr()))
+            keptInNewOrder.append(sheet.ptr());
+        else
+            addedSheets.append(protect(sheet->contents()));
+    }
+
+    if (keptInOldOrder != keptInNewOrder)
+        return { ResolverUpdateType::Reconstruct };
+    return { ResolverUpdateType::Reconstruct, WTF::move(addedSheets), WTF::move(removedSheets), true };
+}
