 namespace WebCore {
 
 WTF_MAKE_TZONE_ALLOCATED_IMPL(CurlRequest);
 
+#if PLATFORM(WASM)
+// The engine's sockets go through a relay (Wisp) that does not confirm a new stream:
+// it counts as open at once, and a connect that fails at the relay only shows up when
+// reading or writing. The socket error tells what happened (Sockets.cpp in the
+// embedding); map it to the code curl would give while connecting. The relay is the proxy.
+static CURLcode connectionErrorOnWasm(CURLcode result, long socketError)
+{
+    switch (socketError) {
+    case EADDRNOTAVAIL: // a name the relay cannot resolve
+        return CURLE_COULDNT_RESOLVE_HOST;
+    case ECONNREFUSED:
+        return CURLE_COULDNT_CONNECT;
+    case EHOSTUNREACH:
+        // For curl this is also CURLE_COULDNT_CONNECT. CURLE_INTERFACE_FAILED never occurs
+        // otherwise (no CURLOPT_INTERFACE), so it stays distinct from "refused".
+        return CURLE_INTERFACE_FAILED;
+    case ETIMEDOUT:
+        return CURLE_OPERATION_TIMEDOUT;
+    case ENETUNREACH: // no relay
+        return CURLE_COULDNT_RESOLVE_PROXY;
+    case EACCES: // the relay blocks the target
+        return CURLE_REMOTE_ACCESS_DENIED;
+    default:
+        return result;
+    }
+}
+#endif
+
