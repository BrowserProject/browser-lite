 namespace WebCore {
 
 WTF_MAKE_TZONE_ALLOCATED_IMPL(CurlRequest);
 
+#if PLATFORM(WASM)
+// Die Sockets der Engine gehen ueber ein Relay (Wisp), das einen neuen Stream nicht
+// bestaetigt: er gilt sofort als offen, ein Aufbau, der beim Relay scheitert, zeigt sich
+// erst beim Lesen oder Schreiben. Der Fehler des Sockets sagt, was war (Sockets.cpp im
+// Embedding), daraus der Code, den curl beim Verbinden gaebe. Das Relay ist der Proxy.
+static CURLcode connectionErrorOnWasm(CURLcode result, long socketError)
+{
+    switch (socketError) {
+    case EADDRNOTAVAIL: // ein Name, den das Relay nicht aufloesen kann
+        return CURLE_COULDNT_RESOLVE_HOST;
+    case ECONNREFUSED:
+        return CURLE_COULDNT_CONNECT;
+    case EHOSTUNREACH:
+        // Fuer curl ist das auch CURLE_COULDNT_CONNECT. CURLE_INTERFACE_FAILED gibt es
+        // sonst nie (kein CURLOPT_INTERFACE), so bleibt es von "abgewiesen" getrennt.
+        return CURLE_INTERFACE_FAILED;
+    case ETIMEDOUT:
+        return CURLE_OPERATION_TIMEDOUT;
+    case ENETUNREACH: // kein Relay
+        return CURLE_COULDNT_RESOLVE_PROXY;
+    case EACCES: // das Relay sperrt das Ziel
+        return CURLE_REMOTE_ACCESS_DENIED;
+    default:
+        return result;
+    }
+}
+#endif
