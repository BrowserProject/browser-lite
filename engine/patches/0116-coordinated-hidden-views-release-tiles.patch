@@ -971,6 +971,34 @@ void CoordinatedPlatformLayer::didPrepaintTile()
     if (m_client)
         m_client->didPrepaintTile();
 }
+
+bool CoordinatedPlatformLayer::releaseTiles()
+{
+    assertIsMainThread();
+    {
+        Locker locker { m_lock };
+        if (!m_backingStoreProxy)
+            return false;
+        m_backingStoreProxy->invalidate();
+        m_backingStoreProxy = nullptr;
+        m_pendingChanges.add(Change::BackingStore);
+    }
+    m_pendingTilesCreation = false;
+    // The commit this asks for makes a new backing store (updateContents) and paints all its tiles
+    if (GraphicsLayer* owner = m_owner)
+        owner->setNeedsDisplay();
+    return true;
+}
+
+void CoordinatedPlatformLayer::releaseTargetTiles()
+{
+    ASSERT(!isMainThread());
+    Locker locker { m_lock };
+    // With a backing store again, the pending change gives the target a new one
+    if (m_backingStoreProxy || !m_skiaTarget)
+        return;
+    m_skiaTarget->setUseBackingStore(false);
+}
 #endif
 
