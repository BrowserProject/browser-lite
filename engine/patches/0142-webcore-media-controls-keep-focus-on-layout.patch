+
+// browser-lite: a layout that moves a control to another container takes it out of the tree for
+// a moment, and that drops its focus without a blur, so the focus of the page fell to the body:
+// the start button is the play button, which moves into the controls bar when playback starts.
+// The focused element of each shadow root of the controls before the layout, and whether it shows
+// its focus.
+function focusedElementsOfShadowRoots(nodes)
+{
+    const focusedElements = new Map;
+    for (const node of nodes) {
+        const root = node.element.getRootNode();
+        const element = root instanceof ShadowRoot && !focusedElements.has(root) && root.activeElement;
+        if (element)
+            focusedElements.set(root, { element, focusVisible: element.matches(":focus-visible") });
+    }
+    return focusedElements;
+}
+
+// Gives the focus back to a control that lost it in the layout and is still there, else to the
+// media element, so the keys of the media controls keep working, like in Chrome.
+function restoreFocus(focusedElements)
+{
+    for (const [root, { element, focusVisible }] of focusedElements) {
+        if (root.activeElement)
+            continue;
+        if (element.isConnected && element.getRootNode() === root)
+            element.focus({ preventScroll: true, focusVisible });
+        else if (root.host?.isConnected)
+            root.host.focus({ preventScroll: true, focusVisible });
+    }
 }
 
