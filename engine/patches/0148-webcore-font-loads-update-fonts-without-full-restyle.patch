+void ComputedStyle::updateFontsAfterFontChange(const ComputedStyle* previousParentStyle, const ComputedStyle& parentStyle, FontSelector* fontSelector)
+{
+    if (previousParentStyle) {
+        if (m_inheritedData.ptr() == previousParentStyle->m_inheritedData.ptr()) {
+            m_inheritedData = parentStyle.m_inheritedData;
+            return;
+        }
+        if (m_inheritedData->fontData.ptr() == previousParentStyle->m_inheritedData->fontData.ptr()) {
+            m_inheritedData.access().fontData = parentStyle.m_inheritedData->fontData;
+            return;
+        }
+    }
+    FontCascade fontCascade { FontCascadeDescription { fontDescription() }, this->fontCascade() };
+    fontCascade.update(fontSelector);
+    setFontCascade(WTF::move(fontCascade));
+}
