+// browser-lite: holds back the load event of a document while an event of a sender that delays it
+// waits (the load event of an image, like Blink's IncrementLoadEventDelayCount)
+class EventSenderLoadEventDelay {
+    WTF_MAKE_NONCOPYABLE(EventSenderLoadEventDelay);
+public:
+    EventSenderLoadEventDelay() = default;
+    explicit EventSenderLoadEventDelay(Document& document)
+        : m_document(document)
+    {
+        document.incrementLoadEventDelayCount();
+    }
+    EventSenderLoadEventDelay(EventSenderLoadEventDelay&& other)
+        : m_document(std::exchange(other.m_document, nullptr))
+    {
+    }
+    EventSenderLoadEventDelay& operator=(EventSenderLoadEventDelay&& other)
+    {
+        if (this != &other) {
+            release();
+            m_document = std::exchange(other.m_document, nullptr);
+        }
+        return *this;
+    }
+    ~EventSenderLoadEventDelay() { release(); }
+
+    void release()
+    {
+        if (RefPtr document = std::exchange(m_document, nullptr).get())
+            document->decrementLoadEventDelayCount();
+    }
+
+private:
+    WeakPtr<Document, WeakPtrImplWithEventTargetData> m_document;
+};
