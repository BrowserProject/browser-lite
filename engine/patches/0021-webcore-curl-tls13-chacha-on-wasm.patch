diff --git a/Source/WebCore/platform/network/curl/CurlContext.cpp b/Source/WebCore/platform/network/curl/CurlContext.cpp
index b9c680d990..be2ad78e06 100644
--- a/Source/WebCore/platform/network/curl/CurlContext.cpp
+++ b/Source/WebCore/platform/network/curl/CurlContext.cpp
@@ -337,6 +337,12 @@ void CurlHandle::enableSSL()
     }
 
     setSslCipherList(sslHandle.cipherList().data());
+#if PLATFORM(WASM)
+    // Die Liste oben gilt nur bis TLS 1.2. Fuer TLS 1.3 nimmt OpenSSL sonst
+    // AES-256-GCM zuerst. In WebAssembly gibt es keine AES-Hardware, ChaCha20
+    // ist in Software ein Mehrfaches schneller (wie bei Handys ohne AES).
+    curl_easy_setopt(m_handle, CURLOPT_TLS13_CIPHERS, "TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384");
+#endif
 
     if (const auto& ecCurves = sslHandle.ecCurves(); !ecCurves.isNull())
         setSslECCurves(ecCurves.data());
