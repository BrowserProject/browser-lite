+void Page::setDefersStyleAndLayout(bool defers)
+{
+    if (std::exchange(m_defersStyleAndLayout, defers) == defers || defers)
+        return;
+    forEachDocument([](Document& document) {
+        if (document.backForwardCacheState() != Document::NotInBackForwardCache)
+            return;
+        if (document.childNeedsStyleRecalc() || document.hasPendingFullStyleRebuild())
+            document.scheduleStyleRecalc();
+        if (RefPtr view = document.view())
+            view->layoutContext().scheduleLayout();
+    });
+}
