+bool LocalFrameViewLayoutContext::layoutTimerDeferred() const
+{
+    RefPtr page = frame().page();
+    return page && page->defersStyleAndLayout();
+}
+
 void LocalFrameViewLayoutContext::layoutTimerFired()
 {
+    // browser-lite: started before the page deferred it (Page::setDefersStyleAndLayout)
+    if (layoutTimerDeferred())
+        return;
 #if !LOG_DISABLED
     if (!document()->ownerElement())
         LOG_WITH_STREAM(Layout, stream << "LocalFrameViewLayoutContext for LocalFrameView " << frame().view() << " layout timer fired at " << document()->timeSinceDocumentCreation().value());
