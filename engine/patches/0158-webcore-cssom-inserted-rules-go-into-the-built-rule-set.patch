+    RELEASE_ASSERT(isMainThread());
+    RELEASE_ASSERT(!m_isInvalidatingStyleWithRuleSets);
+
+    RuleFeatureSet insertedFeatures;
+    if (!m_authorStyle->insertRules(insertions, mediaQueryEvaluator, insertedFeatures))
+        return false;
+
+    // Like collectFeatures for the inserted rules only
+    if (m_defaultStyleVersionOnFeatureCollection < UserAgentStyle::defaultStyleVersion)
+        collectFeatures();
+    else {
+        m_features.add(insertedFeatures);
+        clearFeatureCaches();
+    }
+    return true;
 }
 
