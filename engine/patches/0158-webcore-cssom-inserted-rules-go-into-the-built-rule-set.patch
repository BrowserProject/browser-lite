+bool Scope::insertChangedRulesIntoResolver(std::span<const Ref<CSSStyleSheet>> activeStyleSheets, const Vector<ChangedRule>& changedRules)
+{
+    if (m_shadowRoot || !m_resolver || changedRules.isEmpty())
+        return false;
+    if (!std::ranges::equal(activeStyleSheets, m_activeStyleSheets, [](auto& a, auto& b) { return a.ptr() == b.ptr(); }))
+        return false;
+
+    HashSet<const StyleRuleBase*> insertedRules;
+    for (auto& changedRule : changedRules) {
+        if (!changedRule.insertedInto)
+            return false;
+        insertedRules.add(changedRule.rule.ptr());
+    }
+
+    Vector<RuleSet::Insertion> insertions;
+    for (auto& changedRule : changedRules) {
+        Ref sheet = *changedRule.insertedInto;
+        if (!sheet->mediaQueries().isEmpty() || !activeStyleSheetsContains(sheet) || !RuleSet::isInsertable(changedRule.rule))
+            return false;
+        Ref contents = sheet->contents();
+        if (!contents->importRules().isEmpty())
+            return false;
+        auto& rules = contents->childRules();
+        auto index = rules.findIf([&](auto& rule) {
+            return rule.ptr() == changedRule.rule.ptr();
+        });
+        if (index == notFound)
+            return false;
+
+        // The next rule of the sheet the rule set has, else the previous one
+        std::optional<size_t> anchor;
+        bool isAnchorUsable = true;
+        auto consider = [&](size_t candidate) {
+            Ref rule = rules[candidate];
+            if (insertedRules.contains(rule.ptr()) || RuleSet::addsNoRuleData(rule))
+                return false;
+            isAnchorUsable = RuleSet::isInsertable(rule);
+            anchor = candidate;
+            return true;
+        };
+        bool isBeforeAnchor = true;
+        for (size_t candidate = index + 1; candidate < rules.size(); ++candidate) {
+            if (consider(candidate))
+                break;
+        }
+        if (!anchor) {
+            isBeforeAnchor = false;
+            for (size_t candidate = index; candidate-- > 0;) {
+                if (consider(candidate))
+                    break;
+            }
+        }
+        if (!anchor || !isAnchorUsable)
+            return false;
+
+        insertions.append({ changedRule.rule, rules[*anchor], isBeforeAnchor, static_cast<unsigned>(index) });
+    }
+
+    SetForScope isUpdatingStyleResolver { m_isUpdatingStyleResolver, true };
+    Ref resolver = *m_resolver;
+    return resolver->ruleSets().insertAuthorRules(insertions, resolver->mediaQueryEvaluator());
+}
