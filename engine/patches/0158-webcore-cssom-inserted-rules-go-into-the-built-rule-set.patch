+// browser-lite: CSS-in-JS libraries (styled-components, emotion) insert hundreds of rules into a
+// sheet while a page renders and read layout between them; a new rule set for all sheets of the
+// document per style update cost 5 to 25 ms each on blick.ch. Inserting them keeps the order of the
+// cascade: the positions after an inserted rule move up by its number of rule datas.
+bool RuleSet::isInsertable(const StyleRuleBase& rule)
+{
+    if (rule.type() == StyleRuleType::Style)
+        return true;
+    auto* mediaRule = dynamicDowncast<StyleRuleMedia>(rule);
+    if (!mediaRule)
+        return false;
+    for (auto& child : mediaRule->childRules()) {
+        if (child->type() != StyleRuleType::Style)
+            return false;
+    }
+    return true;
+}
+
+bool RuleSet::addsNoRuleData(const StyleRuleBase& rule)
+{
+    switch (rule.type()) {
+    case StyleRuleType::FontFace:
+    case StyleRuleType::Keyframes:
+    case StyleRuleType::Property:
+    case StyleRuleType::CounterStyle:
+    case StyleRuleType::FontPaletteValues:
+    case StyleRuleType::FontFeatureValues:
+        return true;
+    case StyleRuleType::Media:
+        return uncheckedDowncast<StyleRuleMedia>(rule).childRules().isEmpty();
+    default:
+        return false;
+    }
+}
+
+template<typename Function> static void forEachInsertableStyleRule(const StyleRuleBase& rule, NOESCAPE const Function& function)
+{
+    if (auto* mediaRule = dynamicDowncast<StyleRuleMedia>(rule)) {
+        for (auto& child : mediaRule->childRules())
+            function(uncheckedDowncast<StyleRule>(child.get()));
+        return;
+    }
+    function(uncheckedDowncast<StyleRule>(rule));
+}
+
+bool RuleSet::insertRules(const Vector<Insertion>& insertions, const MQ::MediaQueryEvaluator& evaluator, RuleFeatureSet& insertedFeatures)
+{
+    RELEASE_ASSERT(!m_isBuilding);
+
+    // The first and last position of the rule datas of every anchor's style rules
+    HashMap<const StyleRule*, std::pair<unsigned, unsigned>> anchorPositions;
+    for (auto& insertion : insertions) {
+        ASSERT(isInsertable(insertion.rule) && isInsertable(insertion.anchor));
+        forEachInsertableStyleRule(insertion.anchor, [&](const StyleRule& rule) {
+            anchorPositions.add(&rule, std::pair { std::numeric_limits<unsigned>::max(), 0u });
+        });
+    }
+    traverseRuleDatas([&](const RuleData& ruleData) {
+        auto iterator = anchorPositions.find(&ruleData.styleRule());
+        if (iterator == anchorPositions.end())
+            return;
+        iterator->value.first = std::min(iterator->value.first, ruleData.position());
+        iterator->value.second = std::max(iterator->value.second, ruleData.position());
+    });
+
+    struct Pending {
+        unsigned position;
+        bool isAfterAnchor;
+        unsigned indexInSheet;
+        Ref<RuleSet> ruleSet;
+    };
+    Vector<Pending> pending;
+    unsigned insertedCount = 0;
+    for (auto& insertion : insertions) {
+        std::optional<unsigned> position;
+        bool isMissing = false;
+        forEachInsertableStyleRule(insertion.anchor, [&](const StyleRule& rule) {
+            auto [first, last] = anchorPositions.get(&rule);
+            if (first > last) {
+                isMissing = true;
+                return;
+            }
+            position = insertion.isBeforeAnchor ? std::min(position.value_or(first), first) : std::max(position.value_or(last + 1), last + 1);
+        });
+        if (isMissing || !position)
+            return false;
+
+        auto ruleSet = RuleSet::create();
+        {
+            RuleSetBuilder builder(ruleSet, evaluator, nullptr, RuleSetBuilder::ShrinkToFit::Disable);
+            builder.addInsertedRule(insertion.rule);
+        }
+        ASSERT(ruleSet->m_cascadeLayers.isEmpty() && ruleSet->m_containerQueries.isEmpty() && ruleSet->m_scopeRules.isEmpty());
+        insertedCount += ruleSet->ruleCount();
+        pending.append({ *position, !insertion.isBeforeAnchor, insertion.indexInSheet, WTF::move(ruleSet) });
+    }
+
+    // RuleData::m_position has 21 bits
+    if (m_ruleCount + insertedCount >= (1u << 21))
+        return false;
+
+    // At one position the rules after the end of a sheet come before those before the first rule
+    // of the next sheet, rules before one anchor in the order of the sheet
+    std::ranges::sort(pending, [](auto& a, auto& b) {
+        if (a.position != b.position)
+            return a.position < b.position;
+        if (a.isAfterAnchor != b.isAfterAnchor)
+            return a.isAfterAnchor;
+        return a.indexInSheet < b.indexInSheet;
+    });
+
+    // An old position moves up by the rule datas inserted at it or before it
+    Vector<std::pair<unsigned, unsigned>> insertedUpTo;
+    unsigned total = 0;
+    for (auto& entry : pending) {
+        total += entry.ruleSet->ruleCount();
+        if (!insertedUpTo.isEmpty() && insertedUpTo.last().first == entry.position)
+            insertedUpTo.last().second = total;
+        else
+            insertedUpTo.append({ entry.position, total });
+    }
+    auto newPosition = [&](size_t position) -> unsigned {
+        auto next = std::upper_bound(insertedUpTo.begin(), insertedUpTo.end(), position, [](size_t value, auto& entry) {
+            return value < entry.first;
+        });
+        return position + (next == insertedUpTo.begin() ? 0 : (next - 1)->second);
+    };
+
+    m_isBuilding = true;
+
+    traverseRuleDatas([&](RuleData& ruleData) {
+        ruleData.setPosition(newPosition(ruleData.position()));
+    });
+    auto movePositions = [&](Vector<unsigned>& identifiers) {
+        if (identifiers.isEmpty())
+            return;
+        Vector<unsigned> moved(newPosition(identifiers.size() - 1) + 1, [](size_t) { return 0u; });
+        for (size_t position = 0; position < identifiers.size(); ++position)
+            moved[newPosition(position)] = identifiers[position];
+        identifiers = WTF::move(moved);
+    };
+    movePositions(m_cascadeLayerIdentifierForRulePosition);
+    movePositions(m_containerQueryIdentifierForRulePosition);
+    movePositions(m_scopeRuleIdentifierForRulePosition);
+    for (auto& dynamicRules : m_dynamicMediaQueryRules) {
+        for (auto& position : dynamicRules.affectedRulePositions)
+            position = newPosition(position);
+    }
+
+    unsigned inserted = 0;
+    for (auto& entry : pending) {
+        addInsertedRuleDatas(entry.ruleSet, entry.position + inserted);
+        inserted += entry.ruleSet->ruleCount();
+        insertedFeatures.add(entry.ruleSet->m_features);
+    }
+    m_ruleCount += inserted;
+
+    m_isBuilding = false;
+    return true;
+}
+
+void RuleSet::addInsertedRuleDatas(const RuleSet& inserted, unsigned firstPosition)
+{
+    // The buckets of traverseRuleDatas, as addRuleToBucket chose them in the inserted set
+    auto appendVector = [&](RuleDataVector& vector, const RuleDataVector& insertedVector) {
+        for (auto ruleData : insertedVector) {
+            ruleData.setPosition(firstPosition + ruleData.position());
+            vector.append(WTF::move(ruleData));
+        }
+    };
+    auto appendMap = [&](AtomRuleMap& map, const AtomRuleMap& insertedMap) {
+        for (auto& [key, insertedVector] : insertedMap) {
+            auto& vector = map.add(key, nullptr).iterator->value;
+            if (!vector)
+                vector = makeUnique<RuleDataVector>();
+            appendVector(*vector, *insertedVector);
+        }
+    };
+    appendMap(m_idRules, inserted.m_idRules);
+    appendMap(m_classRules, inserted.m_classRules);
+    appendMap(m_attributeLocalNameRules, inserted.m_attributeLocalNameRules);
+    appendMap(m_attributeLowercaseLocalNameRules, inserted.m_attributeLowercaseLocalNameRules);
+    appendMap(m_tagLocalNameRules, inserted.m_tagLocalNameRules);
+    appendMap(m_tagLowercaseLocalNameRules, inserted.m_tagLowercaseLocalNameRules);
+    appendMap(m_userAgentPartRules, inserted.m_userAgentPartRules);
+    appendMap(m_namedPseudoElementRules, inserted.m_namedPseudoElementRules);
+    appendVector(m_linkPseudoClassRules, inserted.m_linkPseudoClassRules);
+#if ENABLE(VIDEO)
+    appendVector(m_cuePseudoRules, inserted.m_cuePseudoRules);
+#endif
+    appendVector(m_hostPseudoClassRules, inserted.m_hostPseudoClassRules);
+    appendVector(m_slottedPseudoElementRules, inserted.m_slottedPseudoElementRules);
+    appendVector(m_partPseudoElementRules, inserted.m_partPseudoElementRules);
+    appendVector(m_focusPseudoClassRules, inserted.m_focusPseudoClassRules);
+    appendVector(m_focusVisiblePseudoClassRules, inserted.m_focusVisiblePseudoClassRules);
+    appendVector(m_fullscreenPseudoClassRules, inserted.m_fullscreenPseudoClassRules);
+    appendVector(m_rootElementRules, inserted.m_rootElementRules);
+    appendVector(m_universalRules, inserted.m_universalRules);
+    appendVector(m_universalPseudoElementRules, inserted.m_universalPseudoElementRules);
+
+    m_universalHTMLPseudoElementTypes.add(inserted.m_universalHTMLPseudoElementTypes);
+    m_universalPseudoElementTypes.add(inserted.m_universalPseudoElementTypes);
+    m_hasHostPseudoClassRulesMatchingInShadowTree = m_hasHostPseudoClassRulesMatchingInShadowTree || inserted.m_hasHostPseudoClassRulesMatchingInShadowTree;
+    m_hasHostOrScopePseudoClassRulesInUniversalBucket = m_hasHostOrScopePseudoClassRulesInUniversalBucket || inserted.m_hasHostOrScopePseudoClassRulesInUniversalBucket;
+    m_hasViewportDependentMediaQueries = m_hasViewportDependentMediaQueries || inserted.m_hasViewportDependentMediaQueries;
+
+    m_features.add(inserted.m_features);
+
+    for (auto& insertedRules : inserted.m_dynamicMediaQueryRules) {
+        auto dynamicRules = insertedRules;
+        for (auto& position : dynamicRules.affectedRulePositions)
+            position += firstPosition;
+        m_dynamicMediaQueryRules.append(WTF::move(dynamicRules));
+    }
+}
