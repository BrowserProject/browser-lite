+
+// The element under a mouse that did not move changed (layout, DOM): the chrome hears about it
+// like after a move, so the link address and tooltip it shows follow (Blink recomputes the hover
+// with a fake move). The main frame hit tests into the subframes, from the mouse it last saw.
+void EventHandler::reportElementUnderStillMouse()
+{
+    RefPtr page = m_frame->page();
+    RefPtr mainFrame = page ? page->localMainFrame() : nullptr;
+    if (!mainFrame)
+        return;
+    auto& handler = mainFrame->eventHandler();
+    if (!handler.m_lastKnownMousePosition || handler.m_lastKnownMousePositionSource == LastKnownMousePositionSource::Touch)
+        return;
+    RefPtr view = mainFrame->view();
+    if (!view)
+        return;
+    auto point = view->windowToContents(flooredIntPoint(*handler.m_lastKnownMousePosition));
+    auto result = handler.hitTestResultAtPoint(point, { HitTestRequest::Type::ReadOnly, HitTestRequest::Type::DisallowUserAgentShadowContent, HitTestRequest::Type::AllowChildFrameContent });
+    page->chrome().mouseDidMoveOverElement(result, PlatformKeyboardEvent::currentStateOfModifierKeys());
 }
 
