diff --git a/Source/WebCore/platform/VideoPixelFormat.cpp b/Source/WebCore/platform/VideoPixelFormat.cpp
index db5cd94470..3c9ce86346 100644
--- a/Source/WebCore/platform/VideoPixelFormat.cpp
+++ b/Source/WebCore/platform/VideoPixelFormat.cpp
@@ -74,6 +74,16 @@ std::optional<VideoPixelFormat> convertVideoFramePixelFormat(uint32_t format, bo
     default:
         break;
     }
+#elif PLATFORM(WASM)
+    // browser-lite: VideoFrameWasm reports VideoPixelFormat + 1 (0 = unknown)
+    if (format && format <= static_cast<uint32_t>(VideoPixelFormat::BGRX) + 1) {
+        auto pixelFormat = static_cast<VideoPixelFormat>(format - 1);
+        if (shouldDiscardAlpha && pixelFormat == VideoPixelFormat::RGBA)
+            return VideoPixelFormat::RGBX;
+        if (shouldDiscardAlpha && pixelFormat == VideoPixelFormat::BGRA)
+            return VideoPixelFormat::BGRX;
+        return pixelFormat;
+    }
 #else
     UNUSED_PARAM(format);
     UNUSED_PARAM(shouldDiscardAlpha);
