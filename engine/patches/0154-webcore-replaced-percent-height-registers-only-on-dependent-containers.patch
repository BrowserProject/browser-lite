+// browser-lite: whether the available height of |block| (RenderBox::availableLogicalHeightUsing) comes from its
+// containing block. It does not when the block is a flex item with a used size for percentage resolution, a grid
+// item with a grid area, or a box of auto height that takes it from its aspect ratio, unless a percentage minimum or
+// maximum height constrains it against the containing block.
+static bool availableLogicalHeightDependsOnContainingBlock(RenderBlock& block)
+{
+    auto& style = block.style();
+    if (style.logicalMinHeight().isPercentOrCalculated() || style.logicalMaxHeight().isPercentOrCalculated())
+        return true;
+    if (block.isFlexItem() && downcast<RenderFlexibleBox>(*block.parent()).usedFlexItemOverridingLogicalHeightForPercentageResolution(block))
+        return false;
+    if (block.isGridItem()) {
+        if (auto gridAreaContentLogicalHeight = block.gridAreaContentLogicalHeight(); gridAreaContentLogicalHeight && *gridAreaContentLogicalHeight)
+            return false;
+    }
+    if (style.logicalHeight().isAuto() && !block.isOutOfFlowPositioned() && block.shouldComputeLogicalHeightFromAspectRatio())
+        return false;
+    return true;
+}
