+
+#include "config.h"
+#include "CryptoKeyOKP.h"
+
+#include "CryptoKeyPair.h"
+#include "ExceptionOr.h"
+#include "OpenSSLCryptoUniquePtr.h"
+#include <openssl/evp.h>
+#include <openssl/x509.h>
+#include <wtf/text/Base64.h>
+
+namespace WebCore {
+
+// Ed25519 and X25519 through the EVP_PKEY interface of OpenSSL. The keys are
+// stored raw in m_data as in the other ports: 32 bytes private or public.
+
+static constexpr size_t okpKeySize = 32;
+
+static int evpTypeForCurve(CryptoKeyOKP::NamedCurve curve)
+{
+    return curve == CryptoKeyOKP::NamedCurve::Ed25519 ? EVP_PKEY_ED25519 : EVP_PKEY_X25519;
+}
+
+static EvpPKeyPtr evpKeyFromRaw(CryptoKeyOKP::NamedCurve curve, CryptoKeyType type, const Vector<uint8_t>& data)
+{
+    auto span = data.span();
+    if (type == CryptoKeyType::Private)
+        return EvpPKeyPtr(EVP_PKEY_new_raw_private_key(evpTypeForCurve(curve), nullptr, span.data(), span.size()));
+    return EvpPKeyPtr(EVP_PKEY_new_raw_public_key(evpTypeForCurve(curve), nullptr, span.data(), span.size()));
+}
+
+static std::optional<Vector<uint8_t>> rawPublicKey(EVP_PKEY* key)
+{
+    size_t size = 0;
+    if (EVP_PKEY_get_raw_public_key(key, nullptr, &size) <= 0 || size != okpKeySize)
+        return std::nullopt;
+    Vector<uint8_t> result(size);
+    if (EVP_PKEY_get_raw_public_key(key, result.mutableSpan().data(), &size) <= 0)
+        return std::nullopt;
+    return result;
+}
+
+static std::optional<Vector<uint8_t>> rawPrivateKey(EVP_PKEY* key)
+{
+    size_t size = 0;
+    if (EVP_PKEY_get_raw_private_key(key, nullptr, &size) <= 0 || size != okpKeySize)
+        return std::nullopt;
+    Vector<uint8_t> result(size);
+    if (EVP_PKEY_get_raw_private_key(key, result.mutableSpan().data(), &size) <= 0)
+        return std::nullopt;
+    return result;
+}
+
+bool CryptoKeyOKP::supportsNamedCurve()
+{
+    return true;
+}
+
+std::optional<CryptoKeyPair> CryptoKeyOKP::platformGeneratePair(CryptoAlgorithmIdentifier identifier, NamedCurve namedCurve, bool extractable, CryptoKeyUsageBitmap usages)
+{
+    EvpPKeyCtxPtr context(EVP_PKEY_CTX_new_id(evpTypeForCurve(namedCurve), nullptr));
+    if (!context || EVP_PKEY_keygen_init(context.get()) <= 0)
+        return std::nullopt;
+
+    EVP_PKEY* generated = nullptr;
+    if (EVP_PKEY_keygen(context.get(), &generated) <= 0)
+        return std::nullopt;
+    EvpPKeyPtr key(generated);
+
+    auto publicKeyData = rawPublicKey(key.get());
+    auto privateKeyData = rawPrivateKey(key.get());
+    if (!publicKeyData || !privateKeyData)
+        return std::nullopt;
+
+    bool isPublicKeyExtractable = true;
+    auto publicKey = CryptoKeyOKP::create(identifier, namedCurve, CryptoKeyType::Public, WTF::move(*publicKeyData), isPublicKeyExtractable, usages);
+    ASSERT(publicKey);
+    auto privateKey = CryptoKeyOKP::create(identifier, namedCurve, CryptoKeyType::Private, WTF::move(*privateKeyData), extractable, usages);
+    ASSERT(privateKey);
+    return CryptoKeyPair { WTF::move(publicKey), WTF::move(privateKey) };
+}
+
+bool CryptoKeyOKP::platformCheckPairedKeys(CryptoAlgorithmIdentifier, NamedCurve namedCurve, const Vector<uint8_t>& privateKey, const Vector<uint8_t>& publicKey)
+{
+    auto key = evpKeyFromRaw(namedCurve, CryptoKeyType::Private, privateKey);
+    if (!key)
+        return false;
+    auto derivedPublicKey = rawPublicKey(key.get());
+    return derivedPublicKey && *derivedPublicKey == publicKey;
+}
+
+RefPtr<CryptoKeyOKP> CryptoKeyOKP::importSpki(CryptoAlgorithmIdentifier identifier, NamedCurve curve, Vector<uint8_t>&& keyData, bool extractable, CryptoKeyUsageBitmap usages)
+{
+    // SubjectPublicKeyInfo per RFC 8410: OID id-Ed25519 or id-X25519, without parameters
+    auto span = keyData.span();
+    const uint8_t* pointer = span.data();
+    EvpPKeyPtr key(d2i_PUBKEY(nullptr, &pointer, span.size()));
+    if (!key || pointer != span.data() + span.size())
+        return nullptr;
+    if (EVP_PKEY_get_base_id(key.get()) != evpTypeForCurve(curve))
+        return nullptr;
+
+    auto publicKeyData = rawPublicKey(key.get());
+    if (!publicKeyData)
+        return nullptr;
+    return create(identifier, curve, CryptoKeyType::Public, WTF::move(*publicKeyData), extractable, usages);
+}
+
+ExceptionOr<Vector<uint8_t>> CryptoKeyOKP::exportSpki() const
+{
+    if (type() != CryptoKeyType::Public)
+        return Exception { ExceptionCode::InvalidAccessError };
+
+    auto key = evpKeyFromRaw(m_curve, CryptoKeyType::Public, m_data);
+    if (!key)
+        return Exception { ExceptionCode::OperationError };
+
+    int length = i2d_PUBKEY(key.get(), nullptr);
+    if (length <= 0)
+        return Exception { ExceptionCode::OperationError };
+    Vector<uint8_t> result(length);
+    uint8_t* pointer = result.mutableSpan().data();
+    if (i2d_PUBKEY(key.get(), &pointer) != length)
+        return Exception { ExceptionCode::OperationError };
+    return result;
+}
+
+RefPtr<CryptoKeyOKP> CryptoKeyOKP::importPkcs8(CryptoAlgorithmIdentifier identifier, NamedCurve curve, Vector<uint8_t>&& keyData, bool extractable, CryptoKeyUsageBitmap usages)
+{
+    // PrivateKeyInfo per RFC 8410: the private key is inside as an OCTET STRING
+    auto span = keyData.span();
+    const uint8_t* pointer = span.data();
+    PKCS8PrivKeyInfoPtr info(d2i_PKCS8_PRIV_KEY_INFO(nullptr, &pointer, span.size()));
+    if (!info || pointer != span.data() + span.size())
+        return nullptr;
+
+    EvpPKeyPtr key(EVP_PKCS82PKEY(info.get()));
+    if (!key || EVP_PKEY_get_base_id(key.get()) != evpTypeForCurve(curve))
+        return nullptr;
+
+    auto privateKeyData = rawPrivateKey(key.get());
+    if (!privateKeyData)
+        return nullptr;
+    return create(identifier, curve, CryptoKeyType::Private, WTF::move(*privateKeyData), extractable, usages);
+}
+
+ExceptionOr<Vector<uint8_t>> CryptoKeyOKP::exportPkcs8() const
+{
+    if (type() != CryptoKeyType::Private)
+        return Exception { ExceptionCode::InvalidAccessError };
+
+    auto key = evpKeyFromRaw(m_curve, CryptoKeyType::Private, m_data);
+    if (!key)
+        return Exception { ExceptionCode::OperationError };
+
+    PKCS8PrivKeyInfoPtr info(EVP_PKEY2PKCS8(key.get()));
+    if (!info)
+        return Exception { ExceptionCode::OperationError };
+
+    int length = i2d_PKCS8_PRIV_KEY_INFO(info.get(), nullptr);
+    if (length <= 0)
+        return Exception { ExceptionCode::OperationError };
+    Vector<uint8_t> result(length);
+    uint8_t* pointer = result.mutableSpan().data();
+    if (i2d_PKCS8_PRIV_KEY_INFO(info.get(), &pointer) != length)
+        return Exception { ExceptionCode::OperationError };
+    return result;
+}
+
+String CryptoKeyOKP::generateJwkD() const
+{
+    ASSERT(type() == CryptoKeyType::Private);
+    return base64URLEncodeToString(m_data);
+}
+
+String CryptoKeyOKP::generateJwkX() const
+{
+    if (type() == CryptoKeyType::Public)
+        return base64URLEncodeToString(m_data);
+
+    ASSERT(type() == CryptoKeyType::Private);
+    auto key = evpKeyFromRaw(m_curve, CryptoKeyType::Private, m_data);
+    if (!key)
+        return { };
+    auto publicKeyData = rawPublicKey(key.get());
+    if (!publicKeyData)
+        return { };
+    return base64URLEncodeToString(*publicKeyData);
+}
+
+Vector<uint8_t> CryptoKeyOKP::platformExportRaw() const
+{
+    return m_data;
+}
+
+} // namespace WebCore
