+#include "config.h"
+#include "CryptoAlgorithmEd25519.h"
+
+#include "CryptoKeyOKP.h"
+#include "ExceptionOr.h"
+#include "OpenSSLCryptoUniquePtr.h"
+#include <openssl/evp.h>
+
+namespace WebCore {
+
+// Ed25519 (RFC 8032) without prehash: EVP_DigestSign with an empty digest
+
+ExceptionOr<Vector<uint8_t>> CryptoAlgorithmEd25519::platformSign(const CryptoKeyOKP& key, const Vector<uint8_t>& data)
+{
+    auto keyData = key.platformKey().span();
+    EvpPKeyPtr pkey(EVP_PKEY_new_raw_private_key(EVP_PKEY_ED25519, nullptr, keyData.data(), keyData.size()));
+    if (!pkey)
+        return Exception { ExceptionCode::OperationError };
+
+    EvpDigestCtxPtr context(EVP_MD_CTX_new());
+    if (!context || EVP_DigestSignInit(context.get(), nullptr, nullptr, nullptr, pkey.get()) <= 0)
+        return Exception { ExceptionCode::OperationError };
+
+    size_t signatureSize = 0;
+    auto dataSpan = data.span();
+    if (EVP_DigestSign(context.get(), nullptr, &signatureSize, dataSpan.data(), dataSpan.size()) <= 0)
+        return Exception { ExceptionCode::OperationError };
+    Vector<uint8_t> signature(signatureSize);
+    if (EVP_DigestSign(context.get(), signature.mutableSpan().data(), &signatureSize, dataSpan.data(), dataSpan.size()) <= 0)
+        return Exception { ExceptionCode::OperationError };
+    signature.shrink(signatureSize);
+    return signature;
+}
+
+ExceptionOr<bool> CryptoAlgorithmEd25519::platformVerify(const CryptoKeyOKP& key, const Vector<uint8_t>& signature, const Vector<uint8_t>& data)
+{
+    if (signature.size() != 64)
+        return false;
+
+    auto keyData = key.platformKey().span();
+    EvpPKeyPtr pkey(EVP_PKEY_new_raw_public_key(EVP_PKEY_ED25519, nullptr, keyData.data(), keyData.size()));
+    if (!pkey)
+        return false;
+
+    EvpDigestCtxPtr context(EVP_MD_CTX_new());
+    if (!context || EVP_DigestVerifyInit(context.get(), nullptr, nullptr, nullptr, pkey.get()) <= 0)
+        return false;
+
+    auto signatureSpan = signature.span();
+    auto dataSpan = data.span();
+    return EVP_DigestVerify(context.get(), signatureSpan.data(), signatureSpan.size(), dataSpan.data(), dataSpan.size()) == 1;
+}
+
+} // namespace WebCore
