+#include "config.h"
+#include "CryptoAlgorithmX25519.h"
+
+#include "CryptoKeyOKP.h"
+#include "OpenSSLCryptoUniquePtr.h"
+#include <openssl/evp.h>
+
+namespace WebCore {
+
+// X25519 (RFC 7748). OpenSSL itself rejects an all zero result.
+std::optional<Vector<uint8_t>> CryptoAlgorithmX25519::platformDeriveBits(const CryptoKeyOKP& baseKey, const CryptoKeyOKP& publicKey)
+{
+    auto baseKeyData = baseKey.platformKey().span();
+    auto publicKeyData = publicKey.platformKey().span();
+    EvpPKeyPtr privateKey(EVP_PKEY_new_raw_private_key(EVP_PKEY_X25519, nullptr, baseKeyData.data(), baseKeyData.size()));
+    EvpPKeyPtr peerKey(EVP_PKEY_new_raw_public_key(EVP_PKEY_X25519, nullptr, publicKeyData.data(), publicKeyData.size()));
+    if (!privateKey || !peerKey)
+        return std::nullopt;
+
+    EvpPKeyCtxPtr context(EVP_PKEY_CTX_new(privateKey.get(), nullptr));
+    if (!context || EVP_PKEY_derive_init(context.get()) <= 0 || EVP_PKEY_derive_set_peer(context.get(), peerKey.get()) <= 0)
+        return std::nullopt;
+
+    size_t length = 0;
+    if (EVP_PKEY_derive(context.get(), nullptr, &length) <= 0)
+        return std::nullopt;
+    Vector<uint8_t> result(length);
+    if (EVP_PKEY_derive(context.get(), result.mutableSpan().data(), &length) <= 0)
+        return std::nullopt;
+    result.shrink(length);
+    return result;
+}
+
+} // namespace WebCore
