     }
+    auto placeholderRun = RenderBlock::constructTextRun(m_placeholder, style);
+    inlineSize = std::max(inlineSize, font->width(protect(placeholderRun)));
     style.setLogicalMinWidth(Style::MinimumSize::Fixed { inlineSize / style.usedZoomForLength().value });
 }
 
