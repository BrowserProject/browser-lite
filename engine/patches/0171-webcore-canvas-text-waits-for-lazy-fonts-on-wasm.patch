 WEBCORE_EXPORT void setHardwareConcurrency(unsigned);
 WEBCORE_EXPORT unsigned hardwareConcurrency();
 
+// Text drawn or measured into a 2D canvas: the page reads the result back at once
+// (measureText, getImageData), so the embedder lets the fonts that load on demand wait like local
+// fonts while such text is shaped, unlike the text of the layout. begin runs before its fonts are
+// looked up, end after; both on the thread of the canvas. Set before the first page.
+struct CanvasTextCallbacks {
+    void (*begin)() { nullptr };
+    void (*end)() { nullptr };
+};
+WEBCORE_EXPORT void setCanvasTextCallbacks(const CanvasTextCallbacks&);
+class CanvasTextScope {
+    WTF_MAKE_NONCOPYABLE(CanvasTextScope);
+public:
+    WEBCORE_EXPORT CanvasTextScope();
+    WEBCORE_EXPORT ~CanvasTextScope();
+};
