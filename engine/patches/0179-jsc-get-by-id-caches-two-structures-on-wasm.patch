@@ -920,10 +920,17 @@ static ALWAYS_INLINE bool tryCachedGetByID(const GetByIdModeMetadata& metadata,
     StructureID structureID = cell->structureID();
     switch (metadata.mode) {
     case GetByIdMode::Default:
-        if (!metadata.defaultMode.structureID || metadata.defaultMode.structureID != structureID)
+        if (!structureID)
             return false;
-        result = asObject(cell)->getDirect(metadata.defaultMode.cachedOffset);
-        return true;
+        if (metadata.defaultMode.structureID == structureID) {
+            result = asObject(cell)->getDirect(metadata.defaultMode.cachedOffset);
+            return true;
+        }
+        if (metadata.defaultMode.secondStructureID == structureID) {
+            result = asObject(cell)->getDirect(metadata.secondCachedOffset);
+            return true;
+        }
+        return false;
     case GetByIdMode::ProtoLoad:
         if (metadata.protoLoadMode.structureID != structureID)
             return false;
@@ -991,6 +998,18 @@ static JSValue performLLIntGetByID(BytecodeIndex bytecodeIndex, CodeBlock* codeB
         Structure* structure = baseCell->structure();
         if (slot.isValue() && slot.slotBase() == baseValue) {
             ConcurrentJSLocker locker(codeBlock->m_lock);
+#if OS(EMSCRIPTEN)
+            // A site that sees two shapes (an object literal's and a class instance's, the props of
+            // two components) keeps the structure it had as a second one, which the fast path
+            // checks too: interpreted code has no polymorphic cache of the JITs, every alternation
+            // came here and replaced the other shape. The GC drops a dead second structure.
+            StructureID previousStructureID;
+            PropertyOffset previousOffset = 0;
+            if (metadata.mode == GetByIdMode::Default && llintTuningEnabled()) {
+                previousStructureID = metadata.defaultMode.structureID;
+                previousOffset = metadata.defaultMode.cachedOffset;
+            }
+#endif
             // Start out by clearing out the old cache.
             metadata.clearToDefaultModeWithoutCache();
 
@@ -1000,6 +1019,12 @@ static JSValue performLLIntGetByID(BytecodeIndex bytecodeIndex, CodeBlock* codeB
             if (structure->propertyAccessesAreCacheable() && !structure->needImpurePropertyWatchpoint()) {
                 metadata.defaultMode.structureID = structure->id();
                 metadata.defaultMode.cachedOffset = slot.cachedOffset();
+#if OS(EMSCRIPTEN)
+                if (previousStructureID && previousStructureID != structure->id() && previousOffset == static_cast<int16_t>(previousOffset)) {
+                    metadata.defaultMode.secondStructureID = previousStructureID;
+                    metadata.secondCachedOffset = static_cast<int16_t>(previousOffset);
+                }
+#endif
                 vm.writeBarrier(codeBlock);
             }
         } else if (metadata.hitCountForLLIntCaching && (slot.isValue() || slot.isUnset())) [[unlikely]] {
@@ -1036,6 +1061,11 @@ LLINT_SLOW_PATH_DECL(slow_path_get_length)
 
     if (baseValue.isCell())
         metadata.m_arrayProfile.observeStructure(baseValue.asCell()->structure());
+#if OS(EMSCRIPTEN)
+    // A string's length has no cache (it is no property of a structure): without the lookup
+    if (baseValue.isString() && llintTuningEnabled())
+        LLINT_RETURN_PROFILED(jsNumber(asString(baseValue)->length()));
+#endif
     JSValue result = performLLIntGetByID(codeBlock->bytecodeIndex(pc), codeBlock, globalObject, baseValue, ident, metadata.m_modeMetadata);
     LLINT_RETURN_PROFILED(result);
 }
