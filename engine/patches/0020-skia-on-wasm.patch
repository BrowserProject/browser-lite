+// browser-lite: Others in the engine also switch the WebGL context (WebGL of
+// web pages). So make Skia's own context current before every GL call of Skia;
+// the engine provides the function (engine/src/GpuRaster.cpp).
+extern "C" void bl_skia_ensure_gl_context() __attribute__((weak));
+
+template<auto F> struct SkiaGLCall;
+template<typename R, typename... A, R (*F)(A...)> struct SkiaGLCall<F> {
+    static R call(A... args) {
+        if (bl_skia_ensure_gl_context)
+            bl_skia_ensure_gl_context();
+        return F(args...);
+    }
+};
+
+#define GET_PROC(F) functions->f##F = SkiaGLCall<emscripten_gl##F>::call
+#define GET_PROC_SUFFIX(F, S) functions->f##F = SkiaGLCall<emscripten_gl##F##S>::call
 
