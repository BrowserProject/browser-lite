diff --git a/Source/WebCore/platform/graphics/texmap/BitmapTexture.cpp b/Source/WebCore/platform/graphics/texmap/BitmapTexture.cpp
index 9fee5e03f2..f060106844 100644
--- a/Source/WebCore/platform/graphics/texmap/BitmapTexture.cpp
+++ b/Source/WebCore/platform/graphics/texmap/BitmapTexture.cpp
@@ -70,6 +70,58 @@ static const GLenum s_pixelDataType = GL_UNSIGNED_BYTE;
 #define GL_DEPTH24_STENCIL8 0x88F0
 #endif
 
+#if PLATFORM(WASM)
+// browser-lite: Textures live in the WebGL context of Skia (engine/src/GpuRaster.cpp).
+// They are also created or released outside the compositor (timer in
+// BitmapTexturePool), so every GL call here first makes this context current.
+extern "C" void bl_skia_ensure_gl_context() __attribute__((weak));
+// WebGL names are only valid in the worker that created them. So always release
+// them through the engine, which forwards it to the right thread
+// (kind: 0 = texture, 1 = framebuffer, 2 = renderbuffer).
+extern "C" void bl_texmap_gl_delete(int kind, int count, const unsigned* ids) __attribute__((weak));
+static void deleteGLObjects(int kind, GLsizei count, const GLuint* ids)
+{
+    if (bl_texmap_gl_delete) {
+        bl_texmap_gl_delete(kind, count, ids);
+        return;
+    }
+    if (bl_skia_ensure_gl_context)
+        bl_skia_ensure_gl_context();
+    if (!kind)
+        glDeleteTextures(count, ids);
+    else if (kind == 1)
+        glDeleteFramebuffers(count, ids);
+    else
+        glDeleteRenderbuffers(count, ids);
+}
+#define BL_GL_ENSURE(F) [](auto... args) { if (bl_skia_ensure_gl_context) bl_skia_ensure_gl_context(); return F(args...); }
+#define glActiveTexture(...) BL_GL_ENSURE(glActiveTexture)(__VA_ARGS__)
+#define glBindFramebuffer(...) BL_GL_ENSURE(glBindFramebuffer)(__VA_ARGS__)
+#define glBindRenderbuffer(...) BL_GL_ENSURE(glBindRenderbuffer)(__VA_ARGS__)
+#define glBindTexture(...) BL_GL_ENSURE(glBindTexture)(__VA_ARGS__)
+#define glClear(...) BL_GL_ENSURE(glClear)(__VA_ARGS__)
+#define glClearColor(...) BL_GL_ENSURE(glClearColor)(__VA_ARGS__)
+#define glClearStencil(...) BL_GL_ENSURE(glClearStencil)(__VA_ARGS__)
+#define glCopyTexSubImage2D(...) BL_GL_ENSURE(glCopyTexSubImage2D)(__VA_ARGS__)
+#define glDeleteFramebuffers(n, ids) deleteGLObjects(1, n, ids)
+#define glDeleteRenderbuffers(n, ids) deleteGLObjects(2, n, ids)
+#define glDeleteTextures(n, ids) deleteGLObjects(0, n, ids)
+#define glDisable(...) BL_GL_ENSURE(glDisable)(__VA_ARGS__)
+#define glEnable(...) BL_GL_ENSURE(glEnable)(__VA_ARGS__)
+#define glFramebufferRenderbuffer(...) BL_GL_ENSURE(glFramebufferRenderbuffer)(__VA_ARGS__)
+#define glFramebufferTexture2D(...) BL_GL_ENSURE(glFramebufferTexture2D)(__VA_ARGS__)
+#define glGenFramebuffers(...) BL_GL_ENSURE(glGenFramebuffers)(__VA_ARGS__)
+#define glGenRenderbuffers(...) BL_GL_ENSURE(glGenRenderbuffers)(__VA_ARGS__)
+#define glGenTextures(...) BL_GL_ENSURE(glGenTextures)(__VA_ARGS__)
+#define glGetIntegerv(...) BL_GL_ENSURE(glGetIntegerv)(__VA_ARGS__)
+#define glPixelStorei(...) BL_GL_ENSURE(glPixelStorei)(__VA_ARGS__)
+#define glRenderbufferStorage(...) BL_GL_ENSURE(glRenderbufferStorage)(__VA_ARGS__)
+#define glTexImage2D(...) BL_GL_ENSURE(glTexImage2D)(__VA_ARGS__)
+#define glTexParameteri(...) BL_GL_ENSURE(glTexParameteri)(__VA_ARGS__)
+#define glTexSubImage2D(...) BL_GL_ENSURE(glTexSubImage2D)(__VA_ARGS__)
+#define glViewport(...) BL_GL_ENSURE(glViewport)(__VA_ARGS__)
+#endif
