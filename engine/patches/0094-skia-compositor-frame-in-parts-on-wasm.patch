+// Collect the damage in a walk of its own first, so it is complete before the walk that draws. Each
+// layer's damage stays until recursiveCleanUpAfterPaint() clears it at the end of the frame.
+void SkiaCompositingLayer::collectDamage(const SkISize& targetSize, Damage& frameDamage, Vector<FloatRect>* rectsDrawnWhole)
+{
+    // Only the layer paint() is called on needs the table, so only the root ever allocates one.
+    if (!m_layerRectTracker)
+        m_layerRectTracker = makeUnique<LayerRectTracker>();
+    m_layerRectTracker->advanceToNextFrame();
+
+    PaintContext collectContext;
+    collectContext.collectState.emplace(frameDamage, *m_layerRectTracker);
+
+    // Sized like the canvas that will be drawn into, so both walks clip against the same device bounds.
+    SkNoDrawCanvas noDrawCanvas(targetSize.width(), targetSize.height());
+    recursivePaint(noDrawCanvas, collectContext);
+
+    m_layerRectTracker->damageStaleLayerRectsAndAdvanceEntries(frameDamage);
+    resolveBackdropDamage(collectContext.collectState->backdropRectsInFrame, frameDamage);
+    if (rectsDrawnWhole) {
+        rectsDrawnWhole->appendVector(collectContext.collectState->backdropRectsInFrame);
+        rectsDrawnWhole->appendVector(collectContext.collectState->filterRectsInFrame);
+    }
+}
+#endif
+
+SkiaCompositingLayer::PreparedFrame SkiaCompositingLayer::prepareFrame(const IntSize& targetSize, std::optional<Damage>& frameDamage)
+{
+    PreparedFrame frame;
+    frame.hasRunningAnimations = computeTransformsAndAnimations({ }, { }, MonotonicTime::now());
+#if ENABLE(DAMAGE_TRACKING)
+    if (frameDamage)
+        collectDamage(SkISize::Make(targetSize.width(), targetSize.height()), *frameDamage, &frame.rectsDrawnWhole);
+#else
+    UNUSED_PARAM(frameDamage);
+#endif
+    return frame;
+}
+
+bool SkiaCompositingLayer::drawFrame(SkCanvas& canvas, std::optional<SkColor> clearColor)
+{
+    if (clearColor)
+        canvas.clear(*clearColor);
+    PaintContext context;
+    recursivePaint(canvas, context);
+    context.imageSetBatch.flushIfNeeded(canvas);
+    return context.needsFrameForFilterResult;
+}
+
+void SkiaCompositingLayer::finishFrame()
+{
+    recursiveCleanUpAfterPaint();
+}
