+// VM entries below the outermost one, -1 without any
+static int nestedEntries(EntryFrame* entryFrame)
+{
+    int count = -1;
+    for (; entryFrame; entryFrame = vmEntryRecord(entryFrame)->prevTopEntryFrame())
+        ++count;
+    return count;
+}
