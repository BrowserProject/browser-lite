+// The client of the main frame hears when the icon links of its document change, so the tab icon
+// follows them while the page loads and afterwards, like Blink's UpdateFaviconURL
+static void iconLinksChanged(Document& document)
+{
+    RefPtr frame = document.frame();
+    if (frame && frame->isMainFrame() && frame->document() == &document)
+        frame->loader().client().dispatchDidChangeIcons();
+}
