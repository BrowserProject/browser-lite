diff --git a/Source/WebCore/page/NavigatorBase.cpp b/Source/WebCore/page/NavigatorBase.cpp
index 06577148bd..1c572bcfb9 100644
--- a/Source/WebCore/page/NavigatorBase.cpp
+++ b/Source/WebCore/page/NavigatorBase.cpp
@@ -200,8 +200,13 @@ int NavigatorBase::hardwareConcurrency(ScriptExecutionContext& context)
     // If machines with more than 8 cores become commonplace, we should bump this number.
     // see https://bugs.webkit.org/show_bug.cgi?id=132588 for the
     // rationale behind this decision.
+#if PLATFORM(WASM)
+    // The engine's own thread count says nothing about the device: the host's does
+    return WasmPlatform::hardwareConcurrency() < 8 ? 4 : 8;
+#else
     static int numberOfCores = WTF::numberOfProcessorCores() < 8 ? 4 : 8;
     return numberOfCores;
+#endif
 }
 
 WebCoreOpaqueRoot root(NavigatorBase* navigator)
