+
+// a ? b : c ? d : e nests to the right. The conditionals of its else branches are parsed in this
+// loop instead of by recursion, so that long chains (minified switch statements, the chunk name
+// maps of webpack) do not run out of stack. V8 does the same.
+template <typename LexerType>
+template <class TreeBuilder> TreeExpression Parser<LexerType>::parseConditionalChain(TreeBuilder& context, JSTokenLocation location, TreeExpression cond)
+{
+    struct Link {
+        JSTokenLocation location;
+        TreeExpression cond;
+        TreeExpression lhs;
+    };
+    Vector<Link, 8> links;
+    while (true) {
+        m_parserState.nonTrivialExpressionCount++;
+        m_parserState.nonLHSCount++;
+        next(TreeBuilder::DontBuildStrings);
+        TreeExpression lhs = 0;
