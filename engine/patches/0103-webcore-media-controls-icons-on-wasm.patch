+++ b/Source/WebCore/PlatformWasm.cmake
@@ -87,6 +87,16 @@ list(APPEND WebCore_LIBRARIES
     Freetype::Freetype
 )
 
+# The icons of the modern media controls (ModernMediaControlsImageFiles of Adwaita.cmake) are
+# compiled in: GTK and WPE read them from a GResource, Windows from its bundle
+add_custom_command(
+    OUTPUT ${WebCore_DERIVED_SOURCES_DIR}/MediaControlsImagesWasm.cpp
+    MAIN_DEPENDENCY ${WEBCORE_DIR}/Scripts/generate-media-controls-images.py
+    DEPENDS ${ModernMediaControlsImageFiles}
+    COMMAND ${PYTHON_EXECUTABLE} ${WEBCORE_DIR}/Scripts/generate-media-controls-images.py ${WebCore_DERIVED_SOURCES_DIR}/MediaControlsImagesWasm.cpp ${ModernMediaControlsImageFiles}
+    VERBATIM)
+list(APPEND WebCore_SOURCES ${WebCore_DERIVED_SOURCES_DIR}/MediaControlsImagesWasm.cpp)
+
 # Lets the user agent style sheets (css/fullscreen.css) have rules only for this port
 set(USER_AGENT_STYLE_SHEET_PLATFORM_DEFINES "WTF_PLATFORM_WASM")
 
