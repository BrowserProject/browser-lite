+
+#pragma once
+
+#include <span>
+#include <wtf/text/StringView.h>
+
+namespace WebCore {
+
+// The images of Modules/modern-media-controls/images/adwaita compiled into WebCore
+// (Scripts/generate-media-controls-images.py, PlatformWasm.cmake): GTK and WPE read them from a
+// GResource, Windows from its bundle. fileName is like "Play.svg"; empty for an unknown file.
+std::span<const uint8_t> mediaControlsImageData(StringView fileName);
+
+} // namespace WebCore
