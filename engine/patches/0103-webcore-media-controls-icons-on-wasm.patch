+# INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+# CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+# ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+# THE POSSIBILITY OF SUCH DAMAGE.
+#
+# Compiles the icons of the modern media controls into WebCore for ports without a
+# resource bundle (PLATFORM(WASM)): writes a C++ file that defines
+# WebCore::mediaControlsImageData() (platform/wasm/MediaControlsImagesWasm.h).
+#
+#   generate-media-controls-images.py <output.cpp> <image>...
+
+import os
+import sys
+
+
+def main():
+    output_path = sys.argv[1]
+    image_paths = sorted(sys.argv[2:], key=os.path.basename)
+
+    lines = [
+        '// Generated by Source/WebCore/Scripts/generate-media-controls-images.py, do not edit.',
+        '',
+        '#include "config.h"',
+        '#include "MediaControlsImagesWasm.h"',
+        '',
+        'namespace WebCore {',
+        '',
+    ]
+    for index, path in enumerate(image_paths):
+        with open(path, 'rb') as image:
+            data = image.read()
+        lines.append('static constexpr uint8_t image{0}[] = {{'.format(index))
+        for start in range(0, len(data), 24):
+            lines.append('    ' + ','.join(str(byte) for byte in data[start:start + 24]) + ',')
+        lines.append('};')
+        lines.append('')
+
+    lines.append('std::span<const uint8_t> mediaControlsImageData(StringView fileName)')
+    lines.append('{')
+    lines.append('    static constexpr std::pair<ASCIILiteral, std::span<const uint8_t>> images[] = {')
+    for index, path in enumerate(image_paths):
+        lines.append('        {{ "{0}"_s, std::span {{ image{1} }} }},'.format(os.path.basename(path), index))
+    lines.append('    };')
+    lines.append('    for (auto& [name, data] : images) {')
+    lines.append('        if (fileName == name)')
+    lines.append('            return data;')
+    lines.append('    }')
+    lines.append('    return { };')
+    lines.append('}')
+    lines.append('')
+    lines.append('} // namespace WebCore')
+
+    with open(output_path, 'w') as output:
+        output.write('\n'.join(lines) + '\n')
+
+
+if __name__ == '__main__':
+    main()
