+// universal key makes a change of the pseudo-class on the top of the hover chain invalidate the
+// whole document (InvalidationScope::Descendants of Document::updateHoverActiveState).
+static PseudoClassInvalidationKey makePseudoClassInvalidationKey(CSSSelector::PseudoClass pseudoClass, const CSSSelector& selector, std::span<const CSSSelector* const> sameElementCompounds)
