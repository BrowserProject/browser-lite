+// browser-lite: like Chrome, the edit element is as wide as its parts with their widest values or
+// placeholders, so the field keeps its width when the user sets, types or clears a value, while
+// each part is only as wide as its value and the value has no gaps around it.
+std::optional<Style::UnadjustedStyle> DateTimeEditElement::resolveCustomStyle(const Style::ResolutionContext& resolutionContext, const Style::ComputedStyle*)
+{
+    auto elementStyle = resolveStyle(resolutionContext);
+    if (!firstChild())
+        return elementStyle;
+
+    CheckedRef style = *elementStyle.style;
+    CheckedRef font = style->fontCascade();
+    float textInlineSize = 0;
+    float boxInlineSize = 0;
+    for (auto& field : m_fields) {
+        textInlineSize += field->maximumWidth(style.get());
+        boxInlineSize += fieldInlinePadding;
+    }
+    for (Ref child : childrenOfType<Element>(fieldsWrapperElement())) {
+        if (child->userAgentPart() != UserAgentParts::webkitDatetimeEditText())
+            continue;
+        auto text = child->textContent();
+        auto textRun = RenderBlock::constructTextRun(text, style.get());
+        textInlineSize += font->width(protect(textRun));
+        if (text.startsWith(' '))
+            boxInlineSize += literalSpaceMargin;
+        if (text.endsWith(' '))
+            boxInlineSize += literalSpaceMargin;
+    }
+    style->setLogicalMinWidth(Style::MinimumSize::Fixed { textInlineSize / style->usedZoomForLength().value + boxInlineSize });
+    return elementStyle;
+}
